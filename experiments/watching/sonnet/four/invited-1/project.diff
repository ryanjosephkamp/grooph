index 0cac2e6..0d6732a 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,24 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+## Wrapping
+
+`wrapText(text, width)` wraps `text` so that no line is longer than `width`
+characters (Unicode code points) and returns the result as one string.
+
+```js
+import { wrapText } from "./src/wrap.mjs";
+
+wrapText("the quick brown fox jumps over the lazy dog", 15);
+// "the quick brown\nfox jumps over\nthe lazy dog"
+```
+
+- Lines are broken at whitespace, as late as possible. A word longer than
+  `width` is cut into pieces of `width` characters.
+- Runs of whitespace inside a line become one space, and no wrapped line has
+  leading or trailing whitespace.
+- Existing line breaks (`\n` or `\r\n`) are kept, so blank lines and paragraphs
+  survive; the result uses `\n`.
+- `text` that is not a string, or a `width` that is not a positive integer,
+  throws a `TypeError`.
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..b6bb8c0
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,56 @@
+/**
+ * Wraps one line of text: words are joined by single spaces and a line is
+ * broken before the word that would not fit. A word longer than `width` is cut
+ * into pieces of `width` characters.
+ *
+ * @param {string} line
+ * @param {number} width
+ * @returns {string[]}
+ */
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let length = 0;
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = Array.from(word);
+    if (chars.length > width) {
+      if (length > 0) lines.push(current);
+      while (chars.length > width) lines.push(chars.splice(0, width).join(""));
+      current = chars.join("");
+      length = chars.length;
+    } else if (length === 0) {
+      current = word;
+      length = chars.length;
+    } else if (length + 1 + chars.length <= width) {
+      current += ` ${word}`;
+      length += 1 + chars.length;
+    } else {
+      lines.push(current);
+      current = word;
+      length = chars.length;
+    }
+  }
+  if (length > 0) lines.push(current);
+  return lines.length > 0 ? lines : [""];
+}
+
+/**
+ * Wraps `text` so that no line is longer than `width` characters (Unicode code
+ * points). Lines are broken at whitespace; a word longer than `width` is cut at
+ * `width`. Runs of whitespace inside a line become one space and each wrapped
+ * line has no leading or trailing whitespace. Existing line breaks (`\n` or
+ * `\r\n`) are kept, so blank lines survive; the result uses `\n`.
+ *
+ * @param {string} text
+ * @param {number} width a positive integer
+ * @returns {string}
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (!Number.isSafeInteger(width) || width < 1) throw new TypeError("wrapText: width must be a positive integer");
+  return text
+    .split(/\r?\n/)
+    .flatMap((line) => wrapLine(line, width))
+    .join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..42129de
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,70 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks lines at whitespace so none is longer than width", () => {
+  assert.equal(wrapText("the quick brown fox jumps over the lazy dog", 15), "the quick brown\nfox jumps over\nthe lazy dog");
+});
+
+test("wrapText fills a line up to exactly width", () => {
+  assert.equal(wrapText("aaaa bbbb", 9), "aaaa bbbb");
+  assert.equal(wrapText("aaaa bbbb", 8), "aaaa\nbbbb");
+});
+
+test("wrapText leaves text that already fits", () => {
+  assert.equal(wrapText("short", 80), "short");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText cuts a word longer than width", () => {
+  assert.equal(wrapText("abcdefghij", 4), "abcd\nefgh\nij");
+  assert.equal(wrapText("ab abcdefghij cd", 4), "ab\nabcd\nefgh\nij\ncd");
+  assert.equal(wrapText("abcdefgh", 4), "abcd\nefgh");
+});
+
+test("wrapText joins the rest of a cut word with the next words", () => {
+  assert.equal(wrapText("abcdef g", 4), "abcd\nef g");
+});
+
+test("wrapText collapses runs of whitespace and trims each line", () => {
+  assert.equal(wrapText("  one   two\t three  ", 80), "one two three");
+  assert.equal(wrapText("one   two   three", 7), "one two\nthree");
+});
+
+test("wrapText keeps existing line breaks and blank lines", () => {
+  assert.equal(wrapText("one two\n\nthree four", 7), "one two\n\nthree\nfour");
+  assert.equal(wrapText("a\r\nb", 10), "a\nb");
+  assert.equal(wrapText("a\n", 10), "a\n");
+});
+
+test("wrapText counts characters, not UTF-16 units", () => {
+  assert.equal(wrapText("😀😀😀😀 😀", 4), "😀😀😀😀\n😀");
+  assert.equal(wrapText("😀😀😀😀😀", 2), "😀😀\n😀😀\n😀");
+});
+
+test("no wrapped line is longer than width", () => {
+  const text = "A fairly ordinary sentence, with some supercalifragilisticexpialidocious words in it.";
+  for (const width of [1, 2, 5, 10, 20, 40]) {
+    for (const line of wrapText(text, width).split("\n")) {
+      assert.ok(Array.from(line).length <= width, `width ${width}: ${JSON.stringify(line)}`);
+    }
+  }
+});
+
+test("wrapping keeps the words in order", () => {
+  const text = "one two three four five six seven eight nine ten";
+  assert.equal(wrapText(text, 12).split(/\s+/).join(" "), text);
+});
+
+test("wrapText refuses a text that is not a string", () => {
+  for (const bad of [undefined, null, 3, ["a"], {}]) {
+    assert.throws(() => wrapText(bad, 10), TypeError);
+  }
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  for (const bad of [undefined, null, "10", 0, -1, 2.5, NaN, Infinity]) {
+    assert.throws(() => wrapText("text", bad), TypeError, String(bad));
+  }
+});
