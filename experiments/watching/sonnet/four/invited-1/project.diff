diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..4cb2172
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,74 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function safeKeys(object) {
+  return Object.keys(object).filter((key) => !UNSAFE_KEYS.has(key));
+}
+
+// `ancestors` holds the objects of one argument that are being walked, so a
+// cycle inside that argument is refused instead of overflowing the stack.
+function enter(ancestors, object) {
+  if (ancestors.has(object)) throw new TypeError("layer: settings must not contain a cycle");
+  ancestors.add(object);
+}
+
+function cloneValue(value, ancestors) {
+  if (value === null || typeof value !== "object") return value;
+  if (value instanceof Date) return new Date(value.getTime());
+  if (Array.isArray(value)) {
+    enter(ancestors, value);
+    const copy = Array.from(value, (item) => cloneValue(item, ancestors));
+    ancestors.delete(value);
+    return copy;
+  }
+  if (isPlainObject(value)) {
+    enter(ancestors, value);
+    const copy = {};
+    for (const key of safeKeys(value)) copy[key] = cloneValue(value[key], ancestors);
+    ancestors.delete(value);
+    return copy;
+  }
+  return structuredClone(value);
+}
+
+function mergeObjects(base, over, baseAncestors, overAncestors) {
+  enter(baseAncestors, base);
+  enter(overAncestors, over);
+  const out = {};
+  for (const key of safeKeys(base)) {
+    if (!Object.hasOwn(over, key)) {
+      out[key] = cloneValue(base[key], baseAncestors);
+    } else if (isPlainObject(base[key]) && isPlainObject(over[key])) {
+      out[key] = mergeObjects(base[key], over[key], baseAncestors, overAncestors);
+    } else {
+      out[key] = cloneValue(over[key], overAncestors);
+    }
+  }
+  for (const key of safeKeys(over)) {
+    if (!Object.hasOwn(base, key)) out[key] = cloneValue(over[key], overAncestors);
+  }
+  baseAncestors.delete(base);
+  overAncestors.delete(over);
+  return out;
+}
+
+/**
+ * Lays `over` on top of `base` and returns the combined settings. Plain objects
+ * under the same key are layered key by key at any depth; any other value in
+ * `over` replaces the one in `base`, and a key only one of them has is kept.
+ * Neither argument is changed and the result shares nothing with them. Keys
+ * named `__proto__`, `constructor` or `prototype` are never copied.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return mergeObjects(base, over, new Set(), new Set());
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
