--- a/semver-mini/src/semver.mjs
+++ b/semver-mini/src/semver.mjs
@@ -1,3 +1,55 @@
+const CORE = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/;
+const NUMERIC = /^(0|[1-9][0-9]*)$/;
+const PRE_RELEASE_ID = /^(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)$/;
+const BUILD_ID = /^[0-9A-Za-z-]+$/;
+
+/**
+ * Splits a semantic version (§2, §9, §10) into its numbers and its pre-release
+ * identifiers. Build metadata is checked and then dropped.
+ * @param {string} version
+ * @returns {{ core: string[], pre: string[] | null }}
+ */
+function parse(version) {
+  const invalid = () => new RangeError(`compare: not a semantic version: ${JSON.stringify(version)}`);
+  let rest = version;
+
+  const plus = rest.indexOf("+");
+  if (plus !== -1) {
+    if (!rest.slice(plus + 1).split(".").every((id) => BUILD_ID.test(id))) throw invalid();
+    rest = rest.slice(0, plus);
+  }
+
+  let pre = null;
+  const dash = rest.indexOf("-");
+  if (dash !== -1) {
+    pre = rest.slice(dash + 1).split(".");
+    if (!pre.every((id) => PRE_RELEASE_ID.test(id))) throw invalid();
+    rest = rest.slice(0, dash);
+  }
+
+  const match = CORE.exec(rest);
+  if (match === null) throw invalid();
+  return { core: [match[1], match[2], match[3]], pre };
+}
+
+// Numbers have no leading zeros and may be any size, so compare them as
+// strings: the longer is the larger, and equal lengths compare digit by digit.
+function compareNumbers(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function compareIdentifiers(a, b) {
+  const aNumeric = NUMERIC.test(a);
+  const bNumeric = NUMERIC.test(b);
+  if (aNumeric && bNumeric) return compareNumbers(a, b);
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1; // identifiers are ASCII, so this is ASCII order
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +63,27 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: a must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: b must be a string");
+  const left = parse(a);
+  const right = parse(b);
+
+  for (let i = 0; i < 3; i += 1) {
+    const result = compareNumbers(left.core[i], right.core[i]);
+    if (result !== 0) return result;
+  }
+
+  // A version with a pre-release comes before the same version without one.
+  if (left.pre === null && right.pre === null) return 0;
+  if (left.pre === null) return 1;
+  if (right.pre === null) return -1;
+
+  const shared = Math.min(left.pre.length, right.pre.length);
+  for (let i = 0; i < shared; i += 1) {
+    const result = compareIdentifiers(left.pre[i], right.pre[i]);
+    if (result !== 0) return result;
+  }
+  // All shared identifiers are equal: the larger set of fields has higher precedence.
+  if (left.pre.length === right.pre.length) return 0;
+  return left.pre.length < right.pre.length ? -1 : 1;
 }
