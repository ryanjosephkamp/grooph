+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,183 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("layer lays over on top of base key by key", () => {
+  assert.deepEqual(
+    layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }),
+    { a: 1, b: { c: 9, d: 3 }, e: 5 },
+  );
+});
+
+test("layer keeps a key only one of the two has", () => {
+  assert.deepEqual(layer({ a: 1 }, { b: 2 }), { a: 1, b: 2 });
+  assert.deepEqual(layer({}, {}), {});
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { a: { b: 1 } }), { a: { b: 1 } });
+});
+
+test("layer layers plain objects at any depth", () => {
+  const base = { a: { b: { c: { d: 1, e: 2 }, f: 3 }, g: 4 } };
+  const over = { a: { b: { c: { e: 20, h: 30 } } } };
+  assert.deepEqual(layer(base, over), { a: { b: { c: { d: 1, e: 20, h: 30 }, f: 3 }, g: 4 } });
+});
+
+test("layer replaces a value that is not a plain object in both", () => {
+  const base = { a: { x: 1 }, b: 1, c: "s", d: true, e: [1, 2], f: null, g: { y: 1 } };
+  const over = { a: 5, b: "one", c: { z: 1 }, d: null, e: [3], f: { w: 1 }, g: [1] };
+  assert.deepEqual(layer(base, over), { a: 5, b: "one", c: { z: 1 }, d: null, e: [3], f: { w: 1 }, g: [1] });
+});
+
+test("layer replaces a value in over that is a number, string, boolean or null", () => {
+  const base = { a: { x: 1 } };
+  assert.deepEqual(layer(base, { a: 0 }), { a: 0 });
+  assert.deepEqual(layer(base, { a: "" }), { a: "" });
+  assert.deepEqual(layer(base, { a: false }), { a: false });
+  assert.deepEqual(layer(base, { a: null }), { a: null });
+});
+
+test("layer replaces an array whole and never joins it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ a: { list: [{ x: 1 }] } }, { a: { list: [{ y: 2 }] } }), { a: { list: [{ y: 2 }] } });
+  assert.deepEqual(layer({ a: 1 }, { a: [1, 2] }), { a: [1, 2] });
+});
+
+test("layer lets an own undefined in over replace the base value", () => {
+  const result = layer({ a: 1 }, { a: undefined });
+  assert.ok(Object.hasOwn(result, "a"));
+  assert.equal(result.a, undefined);
+});
+
+test("layer refuses arguments that are not plain objects", () => {
+  for (const bad of [[], [1], null, "text", 3, true, new Date(), new Map(), undefined, () => {}]) {
+    assert.throws(() => layer(bad, {}), TypeError, `base ${String(bad)}`);
+    assert.throws(() => layer({}, bad), TypeError, `over ${String(bad)}`);
+  }
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(), TypeError);
+});
+
+test("layer accepts an object with a null prototype", () => {
+  const bare = Object.assign(Object.create(null), { a: { b: 1 } });
+  const result = layer(bare, { a: { c: 2 } });
+  assert.deepEqual(result, { a: { b: 1, c: 2 } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("layer changes neither argument", () => {
+  const base = { a: { b: 1, list: [{ x: 1 }] }, keep: { k: 1 } };
+  const over = { a: { b: 2, c: 3, list: [{ y: 2 }] }, extra: { e: [1, 2] } };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  layer(base, over);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+function reachable(root) {
+  const found = new Set();
+  const walk = (value) => {
+    if (value === null || typeof value !== "object" || found.has(value)) return;
+    found.add(value);
+    for (const key of Reflect.ownKeys(value)) walk(value[key]);
+  };
+  walk(root);
+  return found;
+}
+
+test("layer result shares no object or array with base or over", () => {
+  const base = {
+    only: { deep: { list: [{ n: 1 }, [2, { m: 3 }]] } },
+    both: { fromBase: { x: 1 }, list: [{ a: 1 }] },
+    when: new Date(0),
+  };
+  const over = {
+    both: { fromOver: { y: 2 }, list: [{ b: 2 }, [{ c: 3 }]] },
+    added: { deeper: { list: [[{ z: 1 }]] } },
+    plain: [{ p: 1 }],
+  };
+  const result = layer(base, over);
+  const mine = reachable(result);
+  for (const source of [...reachable(base), ...reachable(over)]) {
+    assert.ok(!mine.has(source), "result reaches an object that belongs to base or over");
+  }
+  assert.ok(result.when instanceof Date);
+  assert.equal(result.when.getTime(), 0);
+});
+
+test("changing the result later never changes a layer", () => {
+  const base = { a: { b: [1, { c: 1 }] }, k: { v: 1 } };
+  const over = { a: { d: { e: [1] } }, list: [{ f: 1 }] };
+  const result = layer(base, over);
+  result.a.b.push(2);
+  result.a.b[1].c = 99;
+  result.a.d.e.push(2);
+  result.list[0].f = 99;
+  result.k.v = 99;
+  assert.deepEqual(base, { a: { b: [1, { c: 1 }] }, k: { v: 1 } });
+  assert.deepEqual(over, { a: { d: { e: [1] } }, list: [{ f: 1 }] });
+});
+
+test("layer copies a value from the same object used as both arguments", () => {
+  const same = { a: { b: [1] } };
+  const result = layer(same, same);
+  assert.deepEqual(result, { a: { b: [1] } });
+  assert.notEqual(result.a, same.a);
+  assert.notEqual(result.a.b, same.a.b);
+});
+
+test("layer never copies __proto__, constructor or prototype", () => {
+  const base = JSON.parse(
+    '{"__proto__": {"polluted": 1}, "constructor": {"prototype": {"polluted": 1}}, "prototype": 1, "ok": {"__proto__": {"polluted": 1}, "fine": 1}}',
+  );
+  const over = JSON.parse(
+    '{"__proto__": {"polluted": 2}, "constructor": 2, "prototype": {"polluted": 2}, "ok": {"constructor": {"polluted": 2}, "prototype": 2, "more": 2}}',
+  );
+  const result = layer(base, over);
+  assert.deepEqual(result, { ok: { fine: 1, more: 2 } });
+  for (const key of ["__proto__", "constructor", "prototype"]) {
+    assert.ok(!Object.hasOwn(result, key), key);
+    assert.ok(!Object.hasOwn(result.ok, key), key);
+  }
+  assert.equal({}.polluted, undefined);
+  assert.equal(result.polluted, undefined);
+});
+
+test("layer drops those keys at any depth and inside arrays", () => {
+  const base = JSON.parse('{"list": [{"__proto__": {"polluted": 1}, "a": 1}, [{"constructor": {"x": 1}, "b": 2}]]}');
+  const over = JSON.parse('{"other": [{"prototype": {"x": 1}, "c": 3}], "deep": {"x": {"__proto__": {"polluted": 1}, "d": 4}}}');
+  const result = layer(base, over);
+  assert.deepEqual(result, { list: [{ a: 1 }, [{ b: 2 }]], other: [{ c: 3 }], deep: { x: { d: 4 } } });
+  const unsafe = ["__proto__", "constructor", "prototype"];
+  for (const object of reachable(result)) {
+    for (const key of unsafe) assert.ok(!Object.hasOwn(object, key), key);
+  }
+  assert.equal({}.polluted, undefined);
+});
+
+test("every plain object in the result is an ordinary object", () => {
+  const nullProto = (value) => Object.assign(Object.create(null), value);
+  const base = nullProto({ a: nullProto({ b: 1 }), list: [nullProto({ c: 1 })] });
+  const over = nullProto({ a: nullProto({ d: 2 }), more: nullProto({ e: [nullProto({ f: 1 })] }) });
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: { b: 1, d: 2 }, list: [{ c: 1 }], more: { e: [{ f: 1 }] } });
+  for (const object of reachable(result)) {
+    if (!Array.isArray(object)) assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  }
+});
+
+test("layer refuses a cycle instead of overflowing the stack", () => {
+  const base = { a: 1 };
+  base.self = base;
+  assert.throws(() => layer(base, {}), TypeError);
+  assert.throws(() => layer({}, base), TypeError);
+});
+
+test("layer accepts the same object reached twice without a cycle", () => {
+  const shared = { s: 1 };
+  const result = layer({ x: shared, y: shared }, { z: { inner: shared } });
+  assert.deepEqual(result, { x: { s: 1 }, y: { s: 1 }, z: { inner: { s: 1 } } });
+  assert.notEqual(result.x, result.y);
+});
