@@ -0,0 +1,155 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function containers(value, found = new Set()) {
+  if (value !== null && typeof value === "object" && !found.has(value)) {
+    found.add(value);
+    for (const key of Object.keys(value)) containers(value[key], found);
+  }
+  return found;
+}
+
+function assertShareNothing(result, ...layers) {
+  const mine = containers(result);
+  for (const one of layers) {
+    for (const other of containers(one)) assert.ok(!mine.has(other), "the result shares an object with a layer");
+  }
+}
+
+test("layer lays over on top of base, key by key", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("a key only one of them has is kept", () => {
+  assert.deepEqual(layer({ a: 1 }, { b: 2 }), { a: 1, b: 2 });
+  assert.deepEqual(layer({}, { b: { c: 1 } }), { b: { c: 1 } });
+  assert.deepEqual(layer({ a: { b: 1 } }, {}), { a: { b: 1 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("plain objects are layered at any depth", () => {
+  const base = { a: { b: { c: { d: 1, e: 2 }, f: 3 }, g: 4 } };
+  const over = { a: { b: { c: { e: 20, h: 30 } } } };
+  assert.deepEqual(layer(base, over), { a: { b: { c: { d: 1, e: 20, h: 30 }, f: 3 }, g: 4 } });
+});
+
+test("an array, a number, a string, a boolean or null replaces what base holds", () => {
+  const base = { v: { x: 1 }, w: [1, 2, 3] };
+  assert.deepEqual(layer(base, { v: [1] }), { v: [1], w: [1, 2, 3] });
+  assert.deepEqual(layer(base, { v: 7 }), { v: 7, w: [1, 2, 3] });
+  assert.deepEqual(layer(base, { v: "s" }), { v: "s", w: [1, 2, 3] });
+  assert.deepEqual(layer(base, { v: false }), { v: false, w: [1, 2, 3] });
+  assert.deepEqual(layer(base, { v: null }), { v: null, w: [1, 2, 3] });
+  assert.deepEqual(layer(base, { w: { y: 1 } }), { v: { x: 1 }, w: { y: 1 } });
+});
+
+test("an array is replaced whole, never joined", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ o: { list: [{ a: 1 }] } }, { o: { list: [{ b: 2 }] } }), { o: { list: [{ b: 2 }] } });
+});
+
+test("a value of undefined or a falsy value in over still replaces", () => {
+  assert.deepEqual(layer({ a: 1, b: 1, c: 1 }, { a: 0, b: "", c: undefined }), { a: 0, b: "", c: undefined });
+  assert.equal(Object.hasOwn(layer({ c: 1 }, { c: undefined }), "c"), true);
+});
+
+test("both arguments must be plain objects", () => {
+  for (const bad of [[], null, "str", 5, new Date(), undefined, true, () => ({})]) {
+    assert.throws(() => layer(bad, {}), TypeError);
+    assert.throws(() => layer({}, bad), TypeError);
+  }
+  assert.throws(() => layer(), TypeError);
+  assert.throws(() => layer({}), TypeError);
+});
+
+test("neither argument is changed", () => {
+  const base = { a: 1, b: { c: 2, list: [{ x: 1 }] } };
+  const over = { b: { c: 9, d: [1, 2] }, e: { f: 1 } };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  layer(base, over);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("the result shares no object or array with base or over", () => {
+  const base = { a: { b: [1, { c: 2 }] }, kept: { deep: { deeper: [[1], { z: 1 }] } }, when: new Date(0) };
+  const over = { a: { x: { y: [{ w: 1 }] } }, replaced: [{ q: [1] }], other: { r: 1 } };
+  const result = layer(base, over);
+  assertShareNothing(result, base, over);
+
+  // Changing the result later never changes a layer.
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  result.a.b.push(3);
+  result.a.b[1].c = 99;
+  result.a.x.y[0].w = 99;
+  result.kept.deep.deeper[0].push(2);
+  result.kept.deep.deeper[1].z = 99;
+  result.replaced[0].q.push(2);
+  result.other.r = 99;
+  result.when.setTime(5);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("the result shares nothing even when base and over share an object", () => {
+  const shared = { a: { b: [1] } };
+  const result = layer({ x: shared, y: shared }, { x: shared, z: shared });
+  assertShareNothing(result, shared);
+  assert.notEqual(result.x, result.y);
+  assert.notEqual(result.y, result.z);
+  assert.deepEqual(result, { x: shared, y: shared, z: shared });
+});
+
+test("__proto__, constructor and prototype are never copied", () => {
+  const dirty = '{"__proto__":{"polluted":true},"constructor":{"prototype":{"polluted":true}},"prototype":{"polluted":true},"ok":1}';
+  const result = layer(JSON.parse(dirty), JSON.parse(dirty));
+  assert.deepEqual(Object.keys(result), ["ok"]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result, "constructor"), false);
+  assert.equal(result.polluted, undefined);
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("blocked keys are dropped from either argument, at any depth and inside arrays", () => {
+  const base = JSON.parse('{"a":{"__proto__":{"p":1},"keep":1,"b":{"constructor":{"c":1},"keep":2}},"list":[{"prototype":{"p":1},"keep":3}]}');
+  const over = JSON.parse('{"a":{"b":{"__proto__":{"p":2},"more":4}},"arr":[[{"constructor":1,"keep":5}]],"x":{"prototype":1}}');
+  const result = layer(base, over);
+  assert.deepEqual(result, {
+    a: { keep: 1, b: { keep: 2, more: 4 } },
+    list: [{ keep: 3 }],
+    arr: [[{ keep: 5 }]],
+    x: {},
+  });
+  for (const object of containers(result)) {
+    if (Array.isArray(object)) continue;
+    assert.equal(Object.getPrototypeOf(object), Object.prototype);
+    for (const key of ["__proto__", "constructor", "prototype"]) assert.equal(Object.hasOwn(object, key), false);
+  }
+  assert.equal({}.p, undefined);
+});
+
+test("every plain object in the result is an ordinary object", () => {
+  const bare = Object.create(null);
+  bare.a = 1;
+  bare.inner = Object.create(null);
+  bare.inner.b = 2;
+  const result = layer(bare, { inner: { c: 3 }, list: [bare] });
+  assert.deepEqual(result, { a: 1, inner: { b: 2, c: 3 }, list: [{ a: 1, inner: { b: 2 } }] });
+  for (const object of containers(result)) {
+    if (!Array.isArray(object)) assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  }
+});
+
+test("a cycle is refused with a TypeError", () => {
+  const loop = { a: 1 };
+  loop.self = loop;
+  assert.throws(() => layer(loop, {}), TypeError);
+  assert.throws(() => layer({}, { x: [loop] }), TypeError);
+});
diff --git a/textwrap/README.md b/textwrap/README.md
index 0cac2e6..5603ba4 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -4,6 +4,29 @@ Small helpers for laying out plain text in a terminal.
 
 ```js
 import { countWords } from "./src/count.mjs";
+import { fill, wrap } from "./src/wrap.mjs";
 
 countWords("one two  three"); // 3
+
+wrap("the quick brown fox", 9); // ["the quick", "brown fox"]
+fill("the quick brown fox", 9); // "the quick\nbrown fox"
 ```
+
+## Wrapping
+
+`wrap(text, width)` returns the lines of `text` wrapped to `width`; `fill`
+returns the same lines joined with `\n`.
+
+- `width` counts characters as code points, not display columns. No returned
+  line is longer than `width`.
+- Words are separated by whitespace and packed greedily: a word goes on the
+  current line when it fits after one space, otherwise it starts a new line.
+- A word longer than `width` starts a new line and is cut at `width`; it is
+  never split inside a surrogate pair.
+- Line breaks in `text` (`\n`, `\r\n`, `\r`) are kept: every line of the text
+  is wrapped on its own, and a blank line stays a blank line. Within a line,
+  whitespace runs become one space and leading and trailing whitespace is
+  dropped. So `wrap("")` is `[""]`, and `wrap("a\n")` is `["a", ""]`.
+- `text` that is not a string, or a `width` that is not a number, throws a
+  `TypeError`; a `width` that is not an integer of at least 1 throws a
+  `RangeError`.
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..7067682
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,69 @@
+function checkArguments(name, text, width) {
+  if (typeof text !== "string") throw new TypeError(`${name}: text must be a string`);
+  if (typeof width !== "number") throw new TypeError(`${name}: width must be a number`);
+  if (!Number.isInteger(width) || width < 1) throw new RangeError(`${name}: width must be an integer of at least 1`);
+}
+
+// Wraps one line of the text (no line breaks in it) and appends the result to `out`.
+function wrapLine(line, width, out) {
+  const words = line.split(/\s+/).filter((word) => word !== "");
+  if (words.length === 0) {
+    out.push("");
+    return;
+  }
+  let current = "";
+  let currentLength = 0; // in code points
+  for (const word of words) {
+    const points = Array.from(word);
+    if (points.length > width) {
+      // Too long for any line: start on a fresh line and cut it at the width.
+      if (currentLength > 0) out.push(current);
+      let at = 0;
+      for (; at + width < points.length; at += width) out.push(points.slice(at, at + width).join(""));
+      current = points.slice(at).join("");
+      currentLength = points.length - at;
+    } else if (currentLength === 0) {
+      current = word;
+      currentLength = points.length;
+    } else if (currentLength + 1 + points.length <= width) {
+      current += ` ${word}`;
+      currentLength += 1 + points.length;
+    } else {
+      out.push(current);
+      current = word;
+      currentLength = points.length;
+    }
+  }
+  out.push(current);
+}
+
+/**
+ * Wraps `text` to lines of at most `width` characters (code points).
+ *
+ * Each line break of `text` (`\n`, `\r\n` or `\r`) starts a new paragraph line;
+ * a blank line stays a blank line. Within a line, whitespace runs become one
+ * space, leading and trailing whitespace is dropped, and words are packed
+ * greedily. A word longer than `width` is cut at `width`.
+ *
+ * @param {string} text
+ * @param {number} width an integer of at least 1
+ * @returns {string[]} always at least one line
+ */
+export function wrap(text, width) {
+  checkArguments("wrap", text, width);
+  const out = [];
+  for (const line of text.split(/\r\n|\n|\r/)) wrapLine(line, width, out);
+  return out;
+}
+
+/**
+ * `wrap(text, width)` joined with `\n`.
+ *
+ * @param {string} text
+ * @param {number} width an integer of at least 1
+ * @returns {string}
+ */
+export function fill(text, width) {
+  checkArguments("fill", text, width);
+  return wrap(text, width).join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..5d2d457
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,99 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { fill, wrap } from "../src/wrap.mjs";
+
+test("wrap packs words greedily into lines of at most width", () => {
+  assert.deepEqual(wrap("the quick brown fox jumps over the lazy dog", 10), [
+    "the quick",
+    "brown fox",
+    "jumps over",
+    "the lazy",
+    "dog",
+  ]);
+  assert.deepEqual(wrap("one two three", 7), ["one two", "three"]);
+  assert.deepEqual(wrap("one two three", 13), ["one two three"]);
+  assert.deepEqual(wrap("one two three", 100), ["one two three"]);
+});
+
+test("a line may be exactly width long", () => {
+  assert.deepEqual(wrap("ab cd ef", 5), ["ab cd", "ef"]);
+  assert.deepEqual(wrap("abcde", 5), ["abcde"]);
+});
+
+test("whitespace within a line collapses and the ends are trimmed", () => {
+  assert.deepEqual(wrap("  one \t two   three  ", 20), ["one two three"]);
+  assert.deepEqual(wrap("a b", 10), ["a b"]);
+});
+
+test("existing line breaks are kept, and blank lines stay blank", () => {
+  assert.deepEqual(wrap("one two\nthree", 20), ["one two", "three"]);
+  assert.deepEqual(wrap("one\r\ntwo\rthree", 20), ["one", "two", "three"]);
+  assert.deepEqual(wrap("one\n\ntwo", 20), ["one", "", "two"]);
+  assert.deepEqual(wrap("one two three\nfour five", 9), ["one two", "three", "four five"]);
+  assert.deepEqual(wrap("a\n", 5), ["a", ""]);
+});
+
+test("empty and blank text give one empty line", () => {
+  assert.deepEqual(wrap("", 5), [""]);
+  assert.deepEqual(wrap("   ", 5), [""]);
+});
+
+test("a word longer than width is cut at width", () => {
+  assert.deepEqual(wrap("abcdefghij", 4), ["abcd", "efgh", "ij"]);
+  assert.deepEqual(wrap("abcdefgh", 4), ["abcd", "efgh"]);
+  assert.deepEqual(wrap("ab abcdefghij cd", 4), ["ab", "abcd", "efgh", "ij", "cd"]);
+  assert.deepEqual(wrap("abcdefghij kl", 4), ["abcd", "efgh", "ij", "kl"]);
+  assert.deepEqual(wrap("abc", 1), ["a", "b", "c"]);
+});
+
+test("width counts code points, and a cut never splits a surrogate pair", () => {
+  assert.deepEqual(wrap("😀😀😀😀😀", 2), ["😀😀", "😀😀", "😀"]);
+  assert.deepEqual(wrap("😀 😀 😀", 3), ["😀 😀", "😀"]);
+});
+
+test("no line is longer than width, and no word is lost", () => {
+  const text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor "
+    + "incididunt ut labore et dolore magna aliqua. Supercalifragilisticexpialidocious!\n\nUt enim ad minim veniam.";
+  for (const width of [1, 2, 3, 5, 8, 13, 21, 40, 80]) {
+    const lines = wrap(text, width);
+    for (const line of lines) {
+      assert.ok(Array.from(line).length <= width, `width ${width}: ${JSON.stringify(line)}`);
+      assert.ok(!/^\s|\s$/.test(line), `width ${width}: ${JSON.stringify(line)}`);
+    }
+    const letters = (s) => s.replace(/\s+/g, "");
+    assert.equal(letters(lines.join("")), letters(text), `width ${width}`);
+  }
+});
+
+test("wrapping is idempotent at the same width", () => {
+  const text = "a bb ccc dddd eeeee ffffff ggggggg hhhhhhhh";
+  for (const width of [3, 6, 9, 12]) {
+    const once = fill(text, width);
+    assert.equal(fill(once, width), once);
+  }
+});
+
+test("fill joins the lines with a newline", () => {
+  assert.equal(fill("one two three", 7), "one two\nthree");
+  assert.equal(fill("", 7), "");
+  assert.equal(fill("a\n\nb", 7), "a\n\nb");
+});
+
+test("text that is not a string throws a TypeError", () => {
+  for (const bad of [undefined, null, 5, ["a"], {}]) {
+    assert.throws(() => wrap(bad, 10), TypeError);
+    assert.throws(() => fill(bad, 10), TypeError);
+  }
+});
+
+test("a width that is not an integer of at least 1 throws", () => {
+  for (const bad of [undefined, null, "10", [10]]) {
+    assert.throws(() => wrap("a b", bad), TypeError);
+    assert.throws(() => fill("a b", bad), TypeError);
+  }
+  for (const bad of [0, -1, 2.5, NaN, Infinity]) {
+    assert.throws(() => wrap("a b", bad), RangeError);
+    assert.throws(() => fill("a b", bad), RangeError);
+  }
+});
