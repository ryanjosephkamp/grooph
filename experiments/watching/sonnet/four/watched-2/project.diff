diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..d6e1ccf
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,89 @@
+// Keys that would reach the prototype chain; never copied.
+const BLOCKED_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function cyclic() {
+  return new TypeError("layer: settings must not contain a cycle");
+}
+
+// A copy that shares no object or array with `value`, with blocked keys dropped
+// at every depth. `active` holds the containers being copied, to refuse cycles.
+function copy(value, active) {
+  if (value === null || typeof value !== "object") return value;
+  if (value instanceof Date) return new Date(value.getTime());
+  if (Array.isArray(value)) {
+    if (active.has(value)) throw cyclic();
+    active.add(value);
+    const out = [];
+    for (let i = 0; i < value.length; i += 1) {
+      if (i in value) out[i] = copy(value[i], active);
+      else out.length = i + 1;
+    }
+    active.delete(value);
+    return out;
+  }
+  if (isPlainObject(value)) {
+    if (active.has(value)) throw cyclic();
+    active.add(value);
+    const out = {};
+    for (const key of Object.keys(value)) {
+      if (!BLOCKED_KEYS.has(key)) out[key] = copy(value[key], active);
+    }
+    active.delete(value);
+    return out;
+  }
+  try {
+    return structuredClone(value);
+  } catch {
+    throw new TypeError("layer: settings must be plain data");
+  }
+}
+
+// `baseActive` and `overActive` hold the containers of each argument on the
+// path being merged, so a cycle in either is refused.
+function merge(base, over, baseActive, overActive) {
+  if (baseActive.has(base) || overActive.has(over)) throw cyclic();
+  baseActive.add(base);
+  overActive.add(over);
+  const out = {};
+  for (const key of Object.keys(base)) {
+    if (BLOCKED_KEYS.has(key)) continue;
+    if (!Object.hasOwn(over, key)) {
+      out[key] = copy(base[key], baseActive);
+    } else if (isPlainObject(base[key]) && isPlainObject(over[key])) {
+      out[key] = merge(base[key], over[key], baseActive, overActive);
+    } else {
+      out[key] = copy(over[key], overActive);
+    }
+  }
+  for (const key of Object.keys(over)) {
+    if (!BLOCKED_KEYS.has(key) && !Object.hasOwn(base, key)) out[key] = copy(over[key], overActive);
+  }
+  baseActive.delete(base);
+  overActive.delete(over);
+  return out;
+}
+
+/**
+ * Lays `over` on top of `base` and returns the result as new data.
+ *
+ * Plain objects under the same key are layered key by key, at any depth; any
+ * other value in `over` (an array is replaced whole) replaces the one in
+ * `base`, and a key only one of them has is kept. Neither argument is changed
+ * and the result shares no object or array with them. Keys named `__proto__`,
+ * `constructor` or `prototype` are never copied.
+ *
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over, new Set(), new Set());
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
