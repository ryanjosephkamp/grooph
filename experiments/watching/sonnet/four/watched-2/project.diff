+const CORE = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/;
+const IDENTIFIER = /^[0-9A-Za-z-]+$/;
+const NUMERIC = /^[0-9]+$/;
+
+/**
+ * Splits a semantic version into its core numbers and pre-release identifiers
+ * (§2, §9, §10); build metadata is validated and then dropped.
+ * @param {string} version
+ * @returns {{ core: string[], pre: string[] | null }}
+ */
+function parse(version) {
+  let rest = version;
+  const plus = rest.indexOf("+");
+  if (plus !== -1) {
+    const build = rest.slice(plus + 1);
+    if (!build.split(".").every((id) => IDENTIFIER.test(id))) throw invalid(version);
+    rest = rest.slice(0, plus);
+  }
+  let pre = null;
+  const hyphen = rest.indexOf("-");
+  if (hyphen !== -1) {
+    pre = rest.slice(hyphen + 1).split(".");
+    for (const id of pre) {
+      if (!IDENTIFIER.test(id)) throw invalid(version);
+      if (NUMERIC.test(id) && id.length > 1 && id[0] === "0") throw invalid(version);
+    }
+    rest = rest.slice(0, hyphen);
+  }
+  const match = CORE.exec(rest);
+  if (match === null) throw invalid(version);
+  return { core: [match[1], match[2], match[3]], pre };
+}
+
+function invalid(version) {
+  return new RangeError(`compare: not a valid semantic version: ${JSON.stringify(version)}`);
+}
+
+// Digit strings without leading zeros, of any length: compare without Number.
+function compareNumeric(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareIdentifier(a, b) {
+  const aNumeric = NUMERIC.test(a);
+  const bNumeric = NUMERIC.test(b);
+  if (aNumeric && bNumeric) return compareNumeric(a, b);
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +63,28 @@
  * @returns {-1 | 0 | 1}
  */
