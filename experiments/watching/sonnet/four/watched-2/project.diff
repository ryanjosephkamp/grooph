-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") {
+    throw new TypeError("compare: both versions must be strings");
+  }
+  const left = parse(a);
+  const right = parse(b);
+
+  for (let i = 0; i < 3; i += 1) {
+    const order = compareNumeric(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+
+  // A version with a pre-release comes before the same version without one.
+  if (left.pre === null || right.pre === null) {
+    if (left.pre === right.pre) return 0;
+    return left.pre === null ? 1 : -1;
