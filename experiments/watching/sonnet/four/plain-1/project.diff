+++ b/semver-mini/src/semver.mjs
@@ -1,3 +1,38 @@
+// The grammar of https://semver.org (§2, §9, §10): no leading zeros in the
+// numeric parts or in numeric pre-release identifiers, ASCII only.
+const NUMERIC = "0|[1-9][0-9]*";
+const PRE_ID = `${NUMERIC}|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*`;
+const SEMVER = new RegExp(
+  `^(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})` +
+    `(?:-((?:${PRE_ID})(?:\\.(?:${PRE_ID}))*))?` +
+    `(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$`,
+);
+
+function parse(version) {
+  const match = SEMVER.exec(version);
+  if (match === null) throw new RangeError(`compare: not a valid semantic version: ${JSON.stringify(version)}`);
+  return { core: [match[1], match[2], match[3]], pre: match[4] === undefined ? [] : match[4].split(".") };
+}
+
+// Compares two digit strings without leading zeros as numbers, at any size.
+function compareNumeric(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+const isNumeric = (id) => /^[0-9]+$/.test(id);
+
+function compareIdentifier(a, b) {
+  const aNum = isNumeric(a);
+  const bNum = isNumeric(b);
+  if (aNum && bNum) return compareNumeric(a, b);
+  if (aNum) return -1;
+  if (bNum) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1; // ASCII order: the identifiers are ASCII only
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +46,26 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") throw new TypeError("compare: both versions must be strings");
+  const left = parse(a);
+  const right = parse(b);
+
+  for (let i = 0; i < 3; i += 1) {
+    const order = compareNumeric(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+
+  // A version with a pre-release has lower precedence than the same without.
+  if (left.pre.length === 0 || right.pre.length === 0) {
+    if (left.pre.length === right.pre.length) return 0;
+    return left.pre.length === 0 ? 1 : -1;
+  }
+
+  const shared = Math.min(left.pre.length, right.pre.length);
+  for (let i = 0; i < shared; i += 1) {
+    const order = compareIdentifier(left.pre[i], right.pre[i]);
+    if (order !== 0) return order;
+  }
+  if (left.pre.length === right.pre.length) return 0;
+  return left.pre.length < right.pre.length ? -1 : 1;
 }
