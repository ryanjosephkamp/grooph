--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,47 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters.
+ *
+ * Words are runs of characters that are not whitespace (as in `countWords`).
+ * Each line of `text` is wrapped on its own, so existing line breaks and blank
+ * lines are kept. Within a line, any run of whitespace becomes one space, and
+ * whitespace at the start or end of a line is dropped. A word longer than
+ * `width` is broken into pieces of `width` characters. Width counts code
+ * points, not display columns.
+ *
+ * @param {string} text
+ * @param {number} width a positive integer
+ * @returns {string} the wrapped text, its lines separated by "\n"
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (!Number.isInteger(width) || width < 1) throw new TypeError("wrapText: width must be a positive integer");
+  return text
+    .split(/\r?\n/)
+    .flatMap((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let currentLength = 0;
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = Array.from(word);
+    if (currentLength > 0 && currentLength + 1 + chars.length <= width) {
+      current += ` ${word}`;
+      currentLength += 1 + chars.length;
+      continue;
+    }
+    if (currentLength > 0) lines.push(current);
+    let start = 0;
+    while (chars.length - start > width) {
+      lines.push(chars.slice(start, start + width).join(""));
+      start += width;
+    }
+    current = chars.slice(start).join("");
+    currentLength = chars.length - start;
+  }
+  if (currentLength > 0 || lines.length === 0) lines.push(current);
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..be0da21
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks between words so that no line exceeds the width", () => {
+  assert.equal(wrapText("the quick brown fox jumps", 10), "the quick\nbrown fox\njumps");
+  assert.equal(wrapText("aaa bbb", 7), "aaa bbb");
+  assert.equal(wrapText("aaa bbb", 6), "aaa\nbbb");
+});
+
+test("wrapText leaves text that already fits alone", () => {
+  assert.equal(wrapText("one two", 80), "one two");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText collapses whitespace and drops it at the ends of a line", () => {
+  assert.equal(wrapText("  one \t two   three  ", 80), "one two three");
+  assert.equal(wrapText("one   two", 3), "one\ntwo");
+});
+
+test("wrapText keeps existing line breaks and blank lines", () => {
+  assert.equal(wrapText("ab cd\n\nef gh ij", 5), "ab cd\n\nef gh\nij");
+  assert.equal(wrapText("ab\r\ncd", 80), "ab\ncd");
+  assert.equal(wrapText("ab\n", 80), "ab\n");
+});
+
+test("wrapText breaks a word that is longer than the width", () => {
+  assert.equal(wrapText("abcdefgh", 3), "abc\ndef\ngh");
+  assert.equal(wrapText("x abcdefg y", 3), "x\nabc\ndef\ng y");
+});
+
+test("wrapText never splits a surrogate pair", () => {
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+});
+
+test("wrapText never produces a line longer than the width", () => {
+  const text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod supercalifragilisticexpialidocious tempor";
+  for (const width of [1, 2, 5, 12, 40]) {
+    for (const line of wrapText(text, width).split("\n")) {
+      assert.ok(Array.from(line).length <= width, `width ${width}: ${JSON.stringify(line)}`);
+    }
+  }
+});
+
+test("wrapText keeps every word in order", () => {
+  const text = "a bb ccc dddd eeeee ffffff";
+  assert.equal(wrapText(text, 7).split(/\s+/).join(" "), text);
+});
+
+test("wrapText refuses a text that is not a string or a width that is not a positive integer", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText("a", 0), TypeError);
+  assert.throws(() => wrapText("a", -3), TypeError);
+  assert.throws(() => wrapText("a", 2.5), TypeError);
+  assert.throws(() => wrapText("a", "10"), TypeError);
+  assert.throws(() => wrapText("a"), TypeError);
+});
