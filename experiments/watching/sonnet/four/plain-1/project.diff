diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..761fa10
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,53 @@
+// Keys that can reach an object's prototype; never copied into a result.
+const FORBIDDEN = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+// A deep copy that shares no object or array with `value`, without the
+// forbidden keys, in which every plain object is an ordinary object.
+function copy(value) {
+  if (Array.isArray(value)) return Array.from(value, (item) => copy(item));
+  if (isPlainObject(value)) return layerObjects(value, {});
+  if (value instanceof Date) return new Date(value.getTime());
+  if (value !== null && typeof value === "object") return structuredClone(value);
+  return value;
+}
+
+function layerObjects(base, over) {
+  const result = {};
+  for (const key of Object.keys(base)) {
+    if (FORBIDDEN.has(key)) continue;
+    if (!Object.hasOwn(over, key)) {
+      result[key] = copy(base[key]);
+    } else if (isPlainObject(base[key]) && isPlainObject(over[key])) {
+      result[key] = layerObjects(base[key], over[key]);
+    } else {
+      result[key] = copy(over[key]);
+    }
+  }
+  for (const key of Object.keys(over)) {
+    if (FORBIDDEN.has(key) || Object.hasOwn(base, key)) continue;
+    result[key] = copy(over[key]);
+  }
+  return result;
+}
+
+/**
+ * Lays `over` on top of `base` and returns the new settings. Where both hold a
+ * plain object under the same key the two are layered key by key, at any
+ * depth; otherwise the value in `over` replaces the one in `base` (an array is
+ * replaced whole). A key only one of them has is kept. Neither argument is
+ * changed and the result shares no object or array with either.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return layerObjects(base, over);
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
new file mode 100644
index 0000000..42518de
--- /dev/null
+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,159 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `root`, as a Set.
+function reachable(root, seen = new Set()) {
+  if (root !== null && typeof root === "object" && !seen.has(root)) {
+    seen.add(root);
+    for (const key of Reflect.ownKeys(root)) reachable(root[key], seen);
+  }
+  return seen;
+}
+
+test("layer lays over on top of base, key by key", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+  assert.deepEqual(layer({}, {}), {});
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { a: 1 }), { a: 1 });
+});
+
+test("layer layers plain objects at any depth", () => {
+  const base = { a: { b: { c: { d: 1, e: 2 }, f: 3 }, g: 4 } };
+  const over = { a: { b: { c: { e: 20, h: 30 } }, i: 5 } };
+  assert.deepEqual(layer(base, over), { a: { b: { c: { d: 1, e: 20, h: 30 }, f: 3 }, g: 4, i: 5 } });
+});
+
+test("a value in over replaces what base holds, whatever it is", () => {
+  const base = { v: { x: 1 }, w: { y: 2 } };
+  for (const given of [[1, 2], 7, "text", true, false, null, 0, "", undefined]) {
+    const result = layer(base, { v: given });
+    assert.deepEqual(result.v, given, String(given));
+    assert.ok(Object.hasOwn(result, "v"));
+    assert.deepEqual(result.w, { y: 2 });
+  }
+  assert.deepEqual(layer({ v: 1 }, { v: { x: 1 } }), { v: { x: 1 } });
+  assert.deepEqual(layer({ v: [1] }, { v: { x: 1 } }), { v: { x: 1 } });
+  assert.deepEqual(layer({ v: null }, { v: { x: 1 } }), { v: { x: 1 } });
+  assert.deepEqual(layer({ v: { x: 1 } }, { v: new Date(0) }), { v: new Date(0) });
+});
+
+test("an array is replaced whole, never joined", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1 }] }, { list: [{ b: 2 }] }), { list: [{ b: 2 }] });
+  assert.deepEqual(layer({ o: { list: [1, 2] } }, { o: { list: [3] } }), { o: { list: [3] } });
+});
+
+test("a key only one layer has is kept", () => {
+  assert.deepEqual(layer({ a: [1], b: null }, { c: { d: 1 }, e: false }), { a: [1], b: null, c: { d: 1 }, e: false });
+});
+
+test("names that exist on Object.prototype are ordinary keys", () => {
+  const result = layer({ toString: 1 }, { hasOwnProperty: { valueOf: 2 } });
+  assert.deepEqual(result, { toString: 1, hasOwnProperty: { valueOf: 2 } });
+  assert.deepEqual(layer({}, { toString: { a: 1 } }), { toString: { a: 1 } });
+});
+
+test("both arguments must be plain objects", () => {
+  const notPlain = [[], null, "text", 3, true, new Date(), undefined, new Map(), new (class Settings {})(), () => ({})];
+  for (const bad of notPlain) {
+    assert.throws(() => layer(bad, {}), TypeError, `base ${String(bad)}`);
+    assert.throws(() => layer({}, bad), TypeError, `over ${String(bad)}`);
+  }
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(), TypeError);
+});
+
+test("a null-prototype object counts as a plain object", () => {
+  const base = Object.assign(Object.create(null), { a: 1, b: Object.assign(Object.create(null), { c: 2 }) });
+  const result = layer(base, { b: { d: 3 } });
+  assert.deepEqual(result, { a: 1, b: { c: 2, d: 3 } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.getPrototypeOf(result.b), Object.prototype);
+});
+
+test("neither argument is changed", () => {
+  const base = { a: { b: [1, { c: 2 }] }, d: { e: 1 } };
+  const over = { a: { f: [3, { g: 4 }] }, d: { e: 2 } };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  layer(base, over);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("the result shares no object or array with either argument", () => {
+  const base = {
+    only: { deep: { list: [{ x: 1 }, [{ y: 2 }]] } },
+    both: { fromBase: { z: 1 }, replaced: { r: 1 }, kept: [{ k: 1 }] },
+    when: new Date(0),
+  };
+  const over = {
+    onlyOver: { deep: [{ w: 1 }, [[{ v: 2 }]]] },
+    both: { fromOver: { q: 1 }, replaced: [{ s: 1 }] },
+  };
+  const result = layer(base, over);
+  const inputs = new Set([...reachable(base), ...reachable(over)]);
+  for (const object of reachable(result)) assert.ok(!inputs.has(object), "the result shares an object with an argument");
+
+  // and changing the result later changes no layer
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  result.only.deep.list[0].x = 99;
+  result.only.deep.list[1][0].y = 99;
+  result.both.fromBase.z = 99;
+  result.both.kept[0].k = 99;
+  result.both.replaced[0].s = 99;
+  result.onlyOver.deep[0].w = 99;
+  result.onlyOver.deep[1][0][0].v = 99;
+  result.both.fromOver.q = 99;
+  result.when.setTime(5);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("an object in over that replaces a non-object is copied too", () => {
+  const over = { v: { x: [{ y: 1 }] } };
+  const result = layer({ v: 1 }, over);
+  assert.notEqual(result.v, over.v);
+  assert.notEqual(result.v.x, over.v.x);
+  assert.notEqual(result.v.x[0], over.v.x[0]);
+});
+
+test("__proto__, constructor and prototype are never copied", () => {
+  const base = JSON.parse(
+    '{"__proto__": {"polluted": 1}, "constructor": {"a": 1}, "prototype": 1, "keep": 1,' +
+      ' "nest": {"__proto__": {"deep": 1}, "ok": 1, "list": [{"__proto__": {"x": 1}, "constructor": 2, "k": 3}]}}',
+  );
+  const over = JSON.parse(
+    '{"__proto__": {"polluted": 2}, "constructor": {"b": 1}, "prototype": 2, "more": {"prototype": {"p": 1}, "q": 1},' +
+      ' "nest": {"__proto__": {"deep": 2}, "constructor": 5, "list": [[{"__proto__": {"y": 1}, "z": 1}]]}}',
+  );
+  assert.ok(Object.hasOwn(base, "__proto__"), "the fixture holds an own __proto__ key");
+
+  const result = layer(base, over);
+  assert.deepEqual(result, {
+    keep: 1,
+    nest: { ok: 1, list: [[{ z: 1 }]] },
+    more: { q: 1 },
+  });
+  assert.equal(({}).polluted, undefined);
+
+  for (const object of reachable(result)) {
+    if (Array.isArray(object)) continue;
+    assert.equal(Object.getPrototypeOf(object), Object.prototype);
+    for (const name of ["__proto__", "constructor", "prototype"]) {
+      assert.ok(!Object.hasOwn(object, name), `an own ${name} key survived`);
+    }
+  }
+});
+
+test("forbidden keys are dropped when only one layer has them", () => {
+  const polluted = JSON.parse('{"a": {"__proto__": {"p": 1}, "constructor": 1, "b": 2}}');
+  for (const result of [layer(polluted, {}), layer({}, polluted)]) {
+    assert.deepEqual(result, { a: { b: 2 } });
+    assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+  }
+});
