index 0cac2e6..8bada21 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,26 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+## Word wrapping
+
+`wrapText(text, width)` wraps `text` so that no line is longer than `width`.
+
+```js
+import { wrapText } from "./src/wrap.mjs";
+
+wrapText("the quick brown fox jumps", 10); // "the quick\nbrown fox\njumps"
+wrapText("abcdefghij", 4);                 // "abcd\nefgh\nij"
+```
+
+- Lines break at spaces, as late as the width allows.
+- Line breaks already in `text` (`\n`, `\r\n`, `\r`) are kept, so blank lines
+  and paragraphs survive; each input line is wrapped on its own. Lines of the
+  result are joined with `\n`.
+- Within a line, a run of whitespace becomes one space, and no line starts or
+  ends with whitespace. The words are the ones `countWords` counts.
+- A word longer than `width` is broken into pieces of `width` characters.
+- Length is counted in code points, not in terminal columns: wide and
+  combining characters are not treated specially.
+- `text` that is not a string, or a `width` that is not a number, throws a
+  `TypeError`; a `width` that is not a positive integer throws a `RangeError`.
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..8c78cbf
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,83 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters.
+ *
+ * - Line breaks in `text` (`\n`, `\r\n`, `\r`) are kept, so blank lines and
+ *   paragraphs survive; each input line is wrapped on its own.
+ * - Within a line, runs of whitespace become one space, and lines never start
+ *   or end with whitespace. The words are those `countWords` counts.
+ * - A word longer than `width` is broken into pieces of `width` characters.
+ * - Length is counted in code points, not in terminal columns.
+ * - Lines are joined with `\n`.
+ *
+ * @param {string} text
+ * @param {number} width the longest line allowed, a positive integer
+ * @returns {string}
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (typeof width !== "number") throw new TypeError("wrapText: width must be a number");
+  if (!Number.isSafeInteger(width) || width < 1) {
+    throw new RangeError("wrapText: width must be a positive integer");
+  }
+
+  const out = [];
+  for (const line of text.split(/\r\n|\r|\n/)) {
+    wrapLine(line, width, out);
+  }
+  return out.join("\n");
+}
+
+function wrapLine(line, width, out) {
+  const words = line.split(/\s+/).filter((word) => word !== "");
+  if (words.length === 0) {
+    out.push("");
+    return;
+  }
+  let current = "";
+  let used = 0; // code points in `current`
+  for (const word of words) {
+    let pieces = [word];
+    let length = codePointLength(word);
+    if (length > width) {
+      pieces = breakWord(word, width);
+      length = codePointLength(pieces[pieces.length - 1]);
+      // all but the last piece fill a line of their own
+      if (used > 0) {
+        out.push(current);
+        current = "";
+        used = 0;
+      }
+      for (let i = 0; i + 1 < pieces.length; i += 1) out.push(pieces[i]);
+      current = pieces[pieces.length - 1];
+      used = length;
+      continue;
+    }
+    if (used === 0) {
+      current = word;
+      used = length;
+    } else if (used + 1 + length <= width) {
+      current += " " + word;
+      used += 1 + length;
+    } else {
+      out.push(current);
+      current = word;
+      used = length;
+    }
+  }
+  out.push(current);
+}
+
+function breakWord(word, width) {
+  const points = Array.from(word);
+  const pieces = [];
+  for (let i = 0; i < points.length; i += width) {
+    pieces.push(points.slice(i, i + width).join(""));
+  }
+  return pieces;
+}
+
+function codePointLength(text) {
+  let n = 0;
+  for (const _ of text) n += 1;
+  return n;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..49e19c3
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,80 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { countWords } from "../src/count.mjs";
+import { wrapText } from "../src/wrap.mjs";
+
+test("wraps at the last space that fits", () => {
+  assert.equal(wrapText("the quick brown fox jumps", 10), "the quick\nbrown fox\njumps");
+  assert.equal(wrapText("aaa bbb ccc", 7), "aaa bbb\nccc");
+  assert.equal(wrapText("aaa bbb ccc", 11), "aaa bbb ccc");
+  assert.equal(wrapText("aaa bbb ccc", 6), "aaa\nbbb\nccc");
+});
+
+test("a line of exactly the width is kept whole", () => {
+  assert.equal(wrapText("abcde", 5), "abcde");
+  assert.equal(wrapText("ab cd", 5), "ab cd");
+  assert.equal(wrapText("ab cd", 4), "ab\ncd");
+});
+
+test("short text and empty text", () => {
+  assert.equal(wrapText("hi", 80), "hi");
+  assert.equal(wrapText("", 10), "");
+  assert.equal(wrapText("   ", 10), "");
+});
+
+test("whitespace runs collapse and lines are trimmed", () => {
+  assert.equal(wrapText("  one   two \t three  ", 80), "one two three");
+  assert.equal(wrapText("one  two  three", 7), "one two\nthree");
+});
+
+test("existing line breaks are kept and each line is wrapped on its own", () => {
+  assert.equal(wrapText("one two\nthree four", 80), "one two\nthree four");
+  assert.equal(wrapText("one two\r\nthree", 80), "one two\nthree");
+  assert.equal(wrapText("para one\n\npara two", 80), "para one\n\npara two");
+  assert.equal(wrapText("aa bb\ncc dd", 5), "aa bb\ncc dd");
+  assert.equal(wrapText("aa bb cc\ndd", 5), "aa bb\ncc\ndd");
+  assert.equal(wrapText("a\n", 5), "a\n");
+});
+
+test("a word longer than the width is broken at the width", () => {
+  assert.equal(wrapText("abcdefghij", 4), "abcd\nefgh\nij");
+  assert.equal(wrapText("ab abcdefg cd", 3), "ab\nabc\ndef\ng\ncd");
+  assert.equal(wrapText("abcdefg h", 3), "abc\ndef\ng h");
+  assert.equal(wrapText("x", 1), "x");
+  assert.equal(wrapText("xyz", 1), "x\ny\nz");
+});
+
+test("length is counted in code points", () => {
+  assert.equal(wrapText("😀😀 😀", 3), "😀😀\n😀");
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+});
+
+test("no line is longer than the width and the words are kept", () => {
+  const text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod\ntempor incididunt ut labore et dolore magna aliqua. Supercalifragilisticexpialidocious!";
+  for (const width of [1, 2, 5, 10, 20, 34, 35, 80]) {
+    const wrapped = wrapText(text, width);
+    for (const line of wrapped.split("\n")) {
+      assert.ok(Array.from(line).length <= width, `width ${width}: ${JSON.stringify(line)}`);
+      assert.equal(line, line.trim());
+    }
+    // the longest word is 35 characters; below that it is broken into pieces
+    if (width >= 35) assert.equal(countWords(wrapped), countWords(text));
+    assert.equal(wrapped.replace(/\s+/g, ""), text.replace(/\s+/g, ""));
+  }
+});
+
+test("wrapping is idempotent", () => {
+  const once = wrapText("one two three four five six seven", 9);
+  assert.equal(wrapText(once, 9), once);
+});
+
+test("input that is not valid throws", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(5, 10), TypeError);
+  assert.throws(() => wrapText("a"), TypeError);
+  assert.throws(() => wrapText("a", "10"), TypeError);
+  for (const bad of [0, -1, 1.5, NaN, Infinity]) {
+    assert.throws(() => wrapText("a", bad), RangeError, String(bad));
+  }
+});
