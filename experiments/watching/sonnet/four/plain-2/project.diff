+
+test("a value in over replaces base even when it is undefined", () => {
+  const result = layer({ a: 1 }, { a: undefined });
+  assert.equal(Object.hasOwn(result, "a"), true);
+  assert.equal(result.a, undefined);
+});
+
+test("layering a Date and a null-prototype object", () => {
+  const when = new Date(0);
+  const result = layer({ at: 1 }, { at: when });
