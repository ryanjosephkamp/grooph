+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, including `value` itself.
+function reachable(value, seen = new Set()) {
+  if (value !== null && typeof value === "object" && !seen.has(value)) {
+    seen.add(value);
+    for (const key of Reflect.ownKeys(value)) reachable(value[key], seen);
+  }
+  return seen;
+}
+
+function deepFreeze(value) {
+  for (const object of reachable(value)) Object.freeze(object);
+  return value;
+}
+
+test("layer lays over on top of base, key by key", () => {
+  assert.deepEqual(
+    layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }),
+    { a: 1, b: { c: 9, d: 3 }, e: 5 },
+  );
+});
+
+test("plain objects under the same key are layered at any depth", () => {
+  const base = { a: { b: { c: { d: 1, e: 2 }, f: 3 }, g: 4 }, h: 5 };
+  const over = { a: { b: { c: { e: 20, i: 30 } }, j: 6 } };
+  assert.deepEqual(layer(base, over), { a: { b: { c: { d: 1, e: 20, i: 30 }, f: 3 }, g: 4, j: 6 }, h: 5 });
+});
+
+test("a key only one of them has is kept", () => {
+  assert.deepEqual(layer({ a: 1 }, { b: 2 }), { a: 1, b: 2 });
+  assert.deepEqual(layer({}, { a: { b: 1 } }), { a: { b: 1 } });
+  assert.deepEqual(layer({ a: { b: 1 } }, {}), { a: { b: 1 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("an array, a number, a string, a boolean or null in over replaces what base holds", () => {
+  const base = { k: { deep: 1 } };
+  for (const value of [[1, 2], 7, "text", true, false, null, 0, ""]) {
+    assert.deepEqual(layer(base, { k: value }), { k: value }, JSON.stringify(value));
+  }
+  assert.deepEqual(layer({ k: 1 }, { k: { deep: 2 } }), { k: { deep: 2 } });
+  assert.deepEqual(layer({ k: [1, 2, 3] }, { k: { deep: 2 } }), { k: { deep: 2 } });
+  assert.deepEqual(layer({ k: "x" }, { k: [1] }), { k: [1] });
+});
+
+test("an array is replaced whole, never joined", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1 }] }, { list: [{ b: 2 }] }), { list: [{ b: 2 }] });
