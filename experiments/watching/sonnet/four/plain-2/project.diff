@@ -0,0 +1,87 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+/**
+ * Lays `over` on top of `base` and returns the combined settings.
+ *
+ * Where both hold a plain object under the same key, the two are layered key
+ * by key, at any depth; otherwise the value in `over` replaces the one in
+ * `base`, and a key only one of them has is kept. Arrays are replaced whole.
+ *
+ * Neither argument is changed and the result shares no object or array with
+ * them. Keys named `__proto__`, `constructor` or `prototype` are dropped at any
+ * depth, so every plain object in the result has `Object.prototype`.
+ *
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ * @throws {TypeError} when an argument is not a plain object, or when a layer
+ *   holds something that is not plain data (a function, a `Map`, a class
+ *   instance, a cycle).
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over, new Set(), new Set());
+}
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+// `baseTrail` and `overTrail` hold the objects being walked in each argument,
+// to refuse a cycle; they are separate so that an object both layers share is
+// not mistaken for one.
+function merge(base, over, baseTrail, overTrail) {
+  enter(base, baseTrail);
+  enter(over, overTrail);
+  const out = {};
+  for (const key of Object.keys(base)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    if (!Object.hasOwn(over, key)) {
+      out[key] = copy(base[key], baseTrail);
+    } else if (isPlainObject(base[key]) && isPlainObject(over[key])) {
+      out[key] = merge(base[key], over[key], baseTrail, overTrail);
+    } else {
+      out[key] = copy(over[key], overTrail);
+    }
+  }
+  for (const key of Object.keys(over)) {
+    if (UNSAFE_KEYS.has(key) || Object.hasOwn(base, key)) continue;
+    out[key] = copy(over[key], overTrail);
+  }
+  baseTrail.delete(base);
+  overTrail.delete(over);
+  return out;
+}
+
+// A deep copy of one value, without the unsafe keys.
+function copy(value, trail) {
+  if (value === null || typeof value !== "object") {
+    if (typeof value === "function") throw new TypeError("layer: a function is not a setting");
+    return value;
+  }
+  if (Array.isArray(value)) {
+    enter(value, trail);
+    const out = Array.from(value, (item) => copy(item, trail));
+    trail.delete(value);
+    return out;
+  }
+  if (value instanceof Date) return new Date(value.getTime());
+  if (isPlainObject(value)) {
+    enter(value, trail);
+    const out = {};
+    for (const key of Object.keys(value)) {
+      if (!UNSAFE_KEYS.has(key)) out[key] = copy(value[key], trail);
+    }
+    trail.delete(value);
+    return out;
+  }
+  throw new TypeError("layer: only plain data can be layered");
+}
+
+function enter(value, trail) {
+  if (trail.has(value)) throw new TypeError("layer: a layer holds itself");
+  trail.add(value);
+}
