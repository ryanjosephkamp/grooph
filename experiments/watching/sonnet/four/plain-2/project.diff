+  const base = JSON.parse(
+    '{"__proto__": {"polluted": 1}, "keep": 1, "constructor": {"prototype": {"polluted": 2}},' +
+      ' "a": {"__proto__": {"polluted": 3}, "b": 1, "prototype": {"x": 1}},' +
+      ' "list": [{"__proto__": {"polluted": 4}, "ok": 1, "constructor": 5}, [{"prototype": 6, "ok": 2}]]}',
+  );
+  const over = JSON.parse(
+    '{"__proto__": {"polluted": 5}, "new": {"__proto__": {"polluted": 6}, "ok": 1},' +
+      ' "constructor": 7, "prototype": 8,' +
+      ' "a": {"constructor": {"prototype": {"polluted": 9}}, "c": 2, "__proto__": {"polluted": 10}},' +
+      ' "arr": [{"__proto__": {"polluted": 11}, "ok": 3}, [[{"constructor": 1, "ok": 4}]]]}',
+  );
+  const result = layer(base, over);
+
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+  assert.deepEqual(result, {
+    keep: 1,
+    a: { b: 1, c: 2 },
+    list: [{ ok: 1 }, [{ ok: 2 }]],
+    new: { ok: 1 },
+    arr: [{ ok: 3 }, [[{ ok: 4 }]]],
+  });
+
+  for (const object of reachable(result)) {
+    for (const name of ["__proto__", "constructor", "prototype"]) {
+      assert.equal(Object.hasOwn(object, name), false, name);
+    }
+    if (!Array.isArray(object)) {
+      assert.equal(Object.getPrototypeOf(object), Object.prototype);
+      assert.equal(object.polluted, undefined);
+    }
+  }
+  assert.equal(result.constructor, Object);
+});
+
+test("every plain object in the result is an ordinary object", () => {
+  const bare = Object.create(null);
+  bare.inner = Object.assign(Object.create(null), { x: 1 });
+  bare.list = [Object.assign(Object.create(null), { y: 2 })];
+  const result = layer(bare, Object.assign(Object.create(null), { z: Object.create(null) }));
+  for (const object of reachable(result)) {
+    if (!Array.isArray(object)) assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  }
+  assert.deepEqual(result, { inner: { x: 1 }, list: [{ y: 2 }], z: {} });
+});
