--- a/semver-mini/src/semver.mjs
+++ b/semver-mini/src/semver.mjs
@@ -1,3 +1,40 @@
+// semver.org §2 grammar: no leading zeros in the numeric parts or in numeric
+// pre-release identifiers (§2, §9); build metadata is dot-separated [0-9A-Za-z-]+
+// (§10). Digits are spelled [0-9] so that no other Unicode digit is accepted.
+const IDENT = "(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)";
+const VERSION = new RegExp(
+  "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)" +
+    `(?:-(${IDENT}(?:\\.${IDENT})*))?` +
+    "(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
+);
+
+const NUMERIC = /^[0-9]+$/;
+
+function parse(version, name) {
+  if (typeof version !== "string") throw new TypeError(`compare: ${name} must be a string`);
+  const match = VERSION.exec(version);
+  if (match === null) throw new RangeError(`compare: ${name} is not a valid semantic version: ${JSON.stringify(version)}`);
+  return {
+    core: [BigInt(match[1]), BigInt(match[2]), BigInt(match[3])],
+    pre: match[4] === undefined ? null : match[4].split("."),
+  };
+}
+
+function sign(x, y) {
+  return x < y ? -1 : x > y ? 1 : 0;
+}
+
+// §11.4: numeric identifiers compare as numbers and rank below alphanumeric
+// ones; alphanumeric identifiers compare in ASCII order.
+function compareIdentifier(x, y) {
+  const xNumeric = NUMERIC.test(x);
+  const yNumeric = NUMERIC.test(y);
+  if (xNumeric && yNumeric) return sign(BigInt(x), BigInt(y));
+  if (xNumeric) return -1;
+  if (yNumeric) return 1;
+  return sign(x, y);
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +48,27 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: a must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: b must be a string");
+  const left = parse(a, "a");
+  const right = parse(b, "b");
+
+  for (let i = 0; i < 3; i += 1) {
+    const order = sign(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+
+  // §11.3: a version with a pre-release comes before the same version without.
+  if (left.pre === null && right.pre === null) return 0;
+  if (left.pre === null) return 1;
+  if (right.pre === null) return -1;
+
+  // §11.4: compare identifier by identifier; if all shared ones are equal,
+  // the larger set of identifiers has the higher precedence.
+  const shared = Math.min(left.pre.length, right.pre.length);
+  for (let i = 0; i < shared; i += 1) {
+    const order = compareIdentifier(left.pre[i], right.pre[i]);
+    if (order !== 0) return order;
+  }
+  return sign(left.pre.length, right.pre.length);
 }
