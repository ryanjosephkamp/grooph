diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..12ee1a9
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,69 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function enter(ancestors, value) {
+  if (ancestors.has(value)) throw new TypeError("layer: settings must not contain a circular structure");
+  ancestors.add(value);
+}
+
+// A deep copy that shares no object or array with `value` and leaves out the
+// unsafe keys. Plain objects come out as ordinary objects; a Date is copied;
+// any other value is kept as it is.
+function copy(value, ancestors) {
+  if (value instanceof Date) return new Date(value.getTime());
+  const isArray = Array.isArray(value);
+  if (!isArray && !isPlainObject(value)) return value;
+  enter(ancestors, value);
+  let out;
+  if (isArray) {
+    out = Array.from(value, (item) => copy(item, ancestors));
+  } else {
+    out = {};
+    for (const key of Object.keys(value)) {
+      if (!UNSAFE_KEYS.has(key)) out[key] = copy(value[key], ancestors);
+    }
+  }
+  ancestors.delete(value);
+  return out;
+}
+
+// Lays `over` onto `target`, an object that is already a private copy.
+function overlay(target, over, ancestors) {
+  enter(ancestors, over);
+  for (const key of Object.keys(over)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    const value = over[key];
+    if (isPlainObject(value) && Object.hasOwn(target, key) && isPlainObject(target[key])) {
+      overlay(target[key], value, ancestors);
+    } else {
+      target[key] = copy(value, ancestors);
+    }
+  }
+  ancestors.delete(over);
+}
+
+/**
+ * Lays `over` on top of `base` and returns the settings that result. Plain
+ * objects found under the same key are layered key by key, at any depth; any
+ * other value in `over` (an array included, which is replaced whole) replaces
+ * the one in `base`; a key only one of them has is kept.
+ *
+ * Neither argument is changed and the result shares no object or array with
+ * them. The keys `__proto__`, `constructor` and `prototype` are never copied.
+ *
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  const result = copy(base, new Set());
+  overlay(result, over, new Set());
+  return result;
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
