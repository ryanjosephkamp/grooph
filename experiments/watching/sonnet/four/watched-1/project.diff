+// semver.org §2: <major>.<minor>.<patch>[-<pre-release>][+<build>]
+const NUMERIC = "(?:0|[1-9][0-9]*)";
+const PRE_ID = `(?:${NUMERIC}|[0-9]*[A-Za-z-][0-9A-Za-z-]*)`;
+const BUILD_ID = "[0-9A-Za-z-]+";
+const VERSION = new RegExp(
+  `^(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})` +
+    `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))?` +
+    `(?:\\+${BUILD_ID}(?:\\.${BUILD_ID})*)?$`,
+);
+const ALL_DIGITS = /^[0-9]+$/;
+
+function parse(version) {
+  if (typeof version !== "string") throw new TypeError("compare: version must be a string");
+  const m = VERSION.exec(version);
+  if (m === null) throw new RangeError(`compare: not a valid semantic version: ${JSON.stringify(version)}`);
+  return { core: [m[1], m[2], m[3]], pre: m[4] === undefined ? [] : m[4].split(".") };
+}
+
+// Numbers without leading zeros, of any size: longer is greater, else lexical.
+function compareNumeric(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function comparePreId(a, b) {
+  const aNum = ALL_DIGITS.test(a);
+  const bNum = ALL_DIGITS.test(b);
+  if (aNum && bNum) return compareNumeric(a, b);
+  if (aNum) return -1;
+  if (bNum) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1; // identifiers are ASCII, so this is ASCII order
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +46,27 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") {
+    throw new TypeError("compare: both versions must be strings");
+  }
+  const x = parse(a);
+  const y = parse(b);
+
+  for (let i = 0; i < 3; i += 1) {
+    const c = compareNumeric(x.core[i], y.core[i]);
+    if (c !== 0) return c;
+  }
+
+  // A version without a pre-release comes after the same version with one.
+  if (x.pre.length === 0 && y.pre.length === 0) return 0;
+  if (x.pre.length === 0) return 1;
+  if (y.pre.length === 0) return -1;
+
+  const n = Math.min(x.pre.length, y.pre.length);
+  for (let i = 0; i < n; i += 1) {
+    const c = comparePreId(x.pre[i], y.pre[i]);
+    if (c !== 0) return c;
+  }
+  if (x.pre.length === y.pre.length) return 0;
+  return x.pre.length < y.pre.length ? -1 : 1;
 }
