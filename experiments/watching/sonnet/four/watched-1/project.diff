+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, at any depth.
+function reachable(value, seen = new Set()) {
+  if (value !== null && typeof value === "object" && !seen.has(value)) {
+    seen.add(value);
+    for (const key of Object.keys(value)) reachable(value[key], seen);
+  }
+  return seen;
+}
+
+test("layer lays over on base, key by key", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps keys that only one side has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { a: 1 }), { a: 1 });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects at any depth", () => {
+  const base = { a: { b: { c: { d: 1, e: 2 }, f: 3 }, g: 4 } };
+  const over = { a: { b: { c: { e: 20, h: 30 } }, i: 5 } };
+  assert.deepEqual(layer(base, over), { a: { b: { c: { d: 1, e: 20, h: 30 }, f: 3 }, g: 4, i: 5 } });
+});
+
+test("layer replaces whatever base holds with an array, number, string, boolean or null", () => {
+  const base = { a: { x: 1 }, b: { x: 1 }, c: { x: 1 }, d: { x: 1 }, e: { x: 1 } };
+  const over = { a: [1, 2], b: 7, c: "s", d: false, e: null };
+  assert.deepEqual(layer(base, over), over);
+});
+
+test("layer replaces an object that base holds as a non-object, and the other way round", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: { b: 2 } }, { a: 1 }), { a: 1 });
+  assert.deepEqual(layer({ a: null }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: [1] }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: { b: 2 } }, { a: [1] }), { a: [1] });
+});
+
+test("layer replaces an array whole, never joins it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ a: { list: [{ x: 1 }] } }, { a: { list: [{ y: 2 }] } }), { a: { list: [{ y: 2 }] } });
+});
+
+test("layer refuses an argument that is not a plain object", () => {
+  const bad = [[], null, "text", 3, new Date(), undefined, true, () => ({}), new Map()];
+  for (const value of bad) {
+    assert.throws(() => layer(value, {}), TypeError);
+    assert.throws(() => layer({}, value), TypeError);
+  }
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(), TypeError);
+});
+
+test("layer accepts an object without a prototype", () => {
+  const base = Object.create(null);
+  base.a = 1;
+  const result = layer(base, { b: 2 });
+  assert.deepEqual(result, { a: 1, b: 2 });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("layer changes neither argument", () => {
+  const base = { a: 1, b: { c: [1, { d: 2 }], e: 3 } };
+  const over = { b: { c: [9], f: { g: 4 } }, h: [{ i: 5 }] };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  layer(base, over);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("the result shares no object or array with base or over, at any depth", () => {
+  const base = { a: { b: { c: 1 } }, list: [{ x: 1 }, [2, { y: 3 }]], only: { base: [{ z: 1 }] } };
+  const over = { a: { b: { d: 2 } }, list: [[{ w: 4 }], { v: 5 }], more: { over: [[{ u: 2 }]] } };
+  const result = layer(base, over);
+  const inputs = new Set([...reachable(base), ...reachable(over)]);
+  const outputs = reachable(result);
+  assert.ok(outputs.size > 5);
+  for (const object of outputs) assert.ok(!inputs.has(object), "the result holds an object of a layer");
+
+  // so changing the result never changes a layer
+  result.only.base[0].z = 99;
+  result.more.over[0][0].u = 99;
+  result.list[0][0].w = 99;
+  result.a.b.c = 99;
+  assert.equal(base.only.base[0].z, 1);
+  assert.equal(over.more.over[0][0].u, 2);
+  assert.equal(over.list[0][0].w, 4);
+  assert.equal(base.a.b.c, 1);
+});
+
+test("layering a layer on itself still shares nothing", () => {
+  const shared = { a: { b: [1, { c: 2 }] } };
+  const result = layer(shared, shared);
+  assert.deepEqual(result, shared);
+  const inputs = reachable(shared);
+  for (const object of reachable(result)) assert.ok(!inputs.has(object));
+});
+
+test("layer never copies __proto__, constructor or prototype, at any depth", () => {
+  const poison = JSON.parse(
+    `{
+      "__proto__": { "polluted": true },
+      "constructor": { "prototype": { "polluted": true } },
+      "prototype": { "polluted": true },
+      "keep": 1,
+      "nested": {
+        "__proto__": { "polluted": true },
+        "constructor": 1,
+        "prototype": 2,
+        "keep": 2,
+        "deeper": { "__proto__": { "polluted": true }, "keep": 3 }
+      },
+      "list": [{ "__proto__": { "polluted": true }, "constructor": 1, "keep": 4 }, [{ "prototype": 5, "keep": 6 }]]
+    }`,
+  );
+  assert.ok(Object.hasOwn(poison, "__proto__"), "the fixture holds an own __proto__ key");
+
+  const expected = {
+    keep: 1,
+    nested: { keep: 2, deeper: { keep: 3 } },
+    list: [{ keep: 4 }, [{ keep: 6 }]],
+  };
+  for (const [base, over] of [
+    [{}, poison],
+    [poison, {}],
+    [poison, poison],
+    [{ nested: { other: 0 } }, poison],
+  ]) {
+    const result = layer(base, over);
+    const want = structuredClone(expected);
+    if (base.nested?.other === 0) want.nested.other = 0;
+    assert.deepEqual(result, want);
+    assert.equal(({}).polluted, undefined);
+    for (const object of reachable(result)) {
+      if (Array.isArray(object)) continue;
+      assert.equal(Object.getPrototypeOf(object), Object.prototype);
+      for (const key of ["__proto__", "constructor", "prototype"]) {
+        assert.ok(!Object.hasOwn(object, key), `result holds an own ${key}`);
+      }
+      assert.equal(object.polluted, undefined);
+    }
+  }
+});
+
+test("every plain object in the result is an ordinary object", () => {
+  const bare = Object.create(null);
+  bare.inner = Object.create(null);
+  bare.inner.x = 1;
+  const result = layer(bare, { list: [bare], deep: { a: bare } });
+  for (const object of reachable(result)) {
+    if (!Array.isArray(object)) assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  }
+  assert.equal(result.inner.x, 1);
+  assert.equal(result.list[0].inner.x, 1);
+});
+
+test("layer copies a Date rather than sharing it", () => {
+  const when = new Date(0);
+  const result = layer({}, { when });
+  assert.ok(result.when instanceof Date);
+  assert.notEqual(result.when, when);
+  assert.equal(result.when.getTime(), 0);
+});
+
+test("layer refuses a circular layer", () => {
+  const loop = { a: 1 };
+  loop.self = loop;
+  assert.throws(() => layer(loop, {}), TypeError);
+  assert.throws(() => layer({}, loop), TypeError);
+  assert.throws(() => layer(loop, loop), TypeError);
+});
