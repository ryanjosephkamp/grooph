index 0cac2e6..23ab275 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,25 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+## Word wrapping
+
+`wrap(text, width)` wraps `text` so that no line is longer than `width`
+characters, and returns the lines joined by `"\n"`.
+
+```js
+import { wrap } from "./src/wrap.mjs";
+
+wrap("the quick brown fox jumps", 10); // "the quick\nbrown fox\njumps"
+wrap("abcdefgh", 3);                   // "abc\ndef\ngh"
+```
+
+- Words are runs of non-whitespace, as in `countWords`. Lines break only
+  between words; whitespace between two words on a line becomes one space, and
+  a line never starts or ends with whitespace.
+- A word longer than `width` is split into pieces of `width` characters.
+- Line breaks already in `text` are kept (`\r\n` becomes `\n`); each line is
+  wrapped on its own, and a blank line stays blank.
+- Length is counted in Unicode code points, so a surrogate pair is never split.
+- `text` that is not a string, or a `width` that is not an integer, throws a
+  `TypeError`; a `width` below 1 throws a `RangeError`.
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..234a46f
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,52 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters.
+ *
+ * Words are runs of non-whitespace, as in countWords. Lines break only
+ * between words; the whitespace between two words on one line becomes a single
+ * space and a line never starts or ends with whitespace. A word longer than
+ * `width` is split into pieces of `width` characters. Line breaks already in
+ * `text` are kept (a blank line stays blank). Length is counted in Unicode
+ * code points, so a surrogate pair is never split.
+ *
+ * @param {string} text
+ * @param {number} width the longest line allowed, an integer of at least 1
+ * @returns {string} the wrapped lines, joined by "\n"
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || !Number.isInteger(width)) throw new TypeError("wrap: width must be an integer");
+  if (width < 1) throw new RangeError("wrap: width must be at least 1");
+  return text
+    .split(/\r?\n/)
+    .map((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = ""; // the line being filled
+  let length = 0; // its length in code points
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = Array.from(word);
+    if (chars.length > width) {
+      if (length > 0) lines.push(current);
+      let at = 0;
+      for (; chars.length - at > width; at += width) lines.push(chars.slice(at, at + width).join(""));
+      current = chars.slice(at).join("");
+      length = chars.length - at;
+    } else if (length === 0) {
+      current = word;
+      length = chars.length;
+    } else if (length + 1 + chars.length <= width) {
+      current += " " + word;
+      length += 1 + chars.length;
+    } else {
+      lines.push(current);
+      current = word;
+      length = chars.length;
+    }
+  }
+  lines.push(current);
+  return lines.join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..b8f3879
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap breaks between words so no line exceeds the width", () => {
+  assert.equal(wrap("the quick brown fox jumps", 10), "the quick\nbrown fox\njumps");
+  assert.equal(wrap("aaa bbb", 7), "aaa bbb");
+  assert.equal(wrap("aaa bbb", 6), "aaa\nbbb");
+  assert.equal(wrap("short", 80), "short");
+});
+
+test("wrap collapses runs of whitespace and trims line edges", () => {
+  assert.equal(wrap("  one   two\t three  ", 80), "one two three");
+  assert.equal(wrap("one  two", 3), "one\ntwo");
+});
+
+test("wrap splits a word longer than the width", () => {
+  assert.equal(wrap("abcdefgh", 3), "abc\ndef\ngh");
+  assert.equal(wrap("ab abcdefg cd", 3), "ab\nabc\ndef\ng\ncd");
+  assert.equal(wrap("abcdefg h", 3), "abc\ndef\ng h");
+  assert.equal(wrap("abcdefg h", 4), "abcd\nefg\nh");
+});
+
+test("wrap keeps the line breaks already in the text", () => {
+  assert.equal(wrap("one two\n\nthree four", 7), "one two\n\nthree\nfour");
+  assert.equal(wrap("a\r\nb", 5), "a\nb");
+  assert.equal(wrap("a\n", 5), "a\n");
+});
+
+test("wrap of empty or blank text is empty", () => {
+  assert.equal(wrap("", 5), "");
+  assert.equal(wrap("   ", 5), "");
+});
+
+test("wrap counts code points, not UTF-16 units", () => {
+  assert.equal(wrap("😀😀😀😀", 2), "😀😀\n😀😀");
+  assert.equal(wrap("😀 😀 😀", 3), "😀 😀\n😀");
+});
+
+test("wrap with width 1 puts one character on each line", () => {
+  assert.equal(wrap("ab c", 1), "a\nb\nc");
+});
+
+test("no wrapped line is longer than the width and no word is lost", () => {
+  const text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore";
+  for (let width = 1; width <= 30; width += 1) {
+    const out = wrap(text, width);
+    for (const line of out.split("\n")) {
+      assert.ok(Array.from(line).length <= width, `width ${width}: ${JSON.stringify(line)}`);
+      assert.equal(line, line.trim());
+    }
+    assert.equal(out.replace(/\s+/g, ""), text.replace(/\s+/g, ""));
+  }
+});
+
+test("wrap refuses bad arguments", () => {
+  assert.throws(() => wrap(null, 10), TypeError);
+  assert.throws(() => wrap("a", "10"), TypeError);
+  assert.throws(() => wrap("a", 2.5), TypeError);
+  assert.throws(() => wrap("a", NaN), TypeError);
+  assert.throws(() => wrap("a"), TypeError);
+  assert.throws(() => wrap("a", 0), RangeError);
+  assert.throws(() => wrap("a", -3), RangeError);
+});
