diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..e8f58a6
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,83 @@
+// Keys that are never copied: they would change the prototype of the result.
+const BANNED = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+// The objects and arrays being walked right now, to refuse a circular layer.
+function enter(path, value) {
+  if (path.has(value)) throw new TypeError("layer: a layer must not contain itself");
+  path.add(value);
+}
+
+// A copy of `value` that shares no object or array with it.
+function copy(value, path) {
+  if (value === null || typeof value !== "object") return value;
+  if (Array.isArray(value)) {
+    enter(path, value);
+    const out = value.map((item) => copy(item, path));
+    path.delete(value);
+    return out;
+  }
+  if (isPlainObject(value)) {
+    enter(path, value);
+    const out = {};
+    for (const key of Object.keys(value)) {
+      if (!BANNED.has(key)) out[key] = copy(value[key], path);
+    }
+    path.delete(value);
+    return out;
+  }
+  if (value instanceof Date) return new Date(value.getTime());
+  if (value instanceof RegExp) return new RegExp(value.source, value.flags);
+  try {
+    return structuredClone(value);
+  } catch {
+    throw new TypeError("layer: a setting holds a value that cannot be copied");
+  }
+}
+
+// `path` holds the objects of `base` being layered right now. A cycle that
+// reaches only `over` ends the recursion, because the layering follows both.
+function merge(base, over, path) {
+  enter(path, base);
+  const out = {};
+  for (const key of Object.keys(base)) {
+    if (BANNED.has(key)) continue;
+    if (!Object.hasOwn(over, key)) {
+      out[key] = copy(base[key], new Set());
+    } else if (isPlainObject(base[key]) && isPlainObject(over[key])) {
+      out[key] = merge(base[key], over[key], path);
+    } else {
+      out[key] = copy(over[key], new Set());
+    }
+  }
+  for (const key of Object.keys(over)) {
+    if (BANNED.has(key) || Object.hasOwn(base, key)) continue;
+    out[key] = copy(over[key], new Set());
+  }
+  path.delete(base);
+  return out;
+}
+
+/**
+ * Lays `over` on top of `base` and returns the result as a new object.
+ *
+ * Where both hold a plain object under the same key the two are layered key by
+ * key, at any depth; otherwise the value in `over` replaces the one in `base`
+ * (an array is replaced whole), and a key only one of them has is kept.
+ * Neither argument is changed and the result shares no object or array with
+ * them. The keys `__proto__`, `constructor` and `prototype` are never copied.
+ *
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over, new Set());
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
