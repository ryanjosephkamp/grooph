+  return IDENTIFIER.test(id) && (!DIGITS.test(id) || NUMERIC.test(id));
+}
+
+/** Splits a version into its core numbers and pre-release identifiers, all kept as strings. */
+function parse(version) {
+  const plus = version.indexOf("+");
+  const precedence = plus === -1 ? version : version.slice(0, plus);
+  const dash = precedence.indexOf("-");
+  const core = (dash === -1 ? precedence : precedence.slice(0, dash)).split(".");
+  const prerelease = dash === -1 ? [] : precedence.slice(dash + 1).split(".");
+  const valid =
+    core.length === 3 &&
+    core.every((id) => NUMERIC.test(id)) &&
+    prerelease.every(isPrereleaseIdentifier) &&
+    (plus === -1 || version.slice(plus + 1).split(".").every((id) => IDENTIFIER.test(id)));
+  if (!valid) throw new RangeError(`compare: ${JSON.stringify(version)} is not a semantic version`);
+  return { core, prerelease };
