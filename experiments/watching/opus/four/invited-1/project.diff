diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..6e0cc65
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,44 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters, breaking
+ * between words: runs of characters that are not whitespace.
+ *
+ * Words on a line are joined by one space, and a line never starts or ends
+ * with whitespace. A line break already in `text` is kept, so paragraphs and
+ * blank lines stay where they are. A word longer than `width` is cut into
+ * pieces of `width` characters, as nothing else would fit it.
+ *
+ * @param {string} text
+ * @param {number} width the longest a line may be, counted in code points
+ * @returns {string} the wrapped lines, joined by "\n"
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (!Number.isInteger(width)) throw new TypeError("wrapText: width must be an integer");
+  if (width < 1) throw new RangeError("wrapText: width must be at least 1");
+  return text
+    .split(/\r?\n/)
+    .map((line) => wrapLine(line, width).join("\n"))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let length = 0;
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = Array.from(word);
+    if (length > 0 && length + 1 + chars.length <= width) {
+      current += ` ${word}`;
+      length += 1 + chars.length;
+      continue;
+    }
+    if (length > 0) lines.push(current);
+    let from = 0;
+    for (; chars.length - from > width; from += width) lines.push(chars.slice(from, from + width).join(""));
+    current = chars.slice(from).join("");
+    length = chars.length - from;
+  }
+  if (length > 0) lines.push(current);
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..536f8ae
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,76 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks between words so no line is longer than the width", () => {
+  assert.equal(wrapText("the quick brown fox jumps over the lazy dog", 10), "the quick\nbrown fox\njumps over\nthe lazy\ndog");
+  assert.equal(wrapText("the quick brown fox", 9), "the quick\nbrown fox");
+  assert.equal(wrapText("the quick brown fox", 8), "the\nquick\nbrown\nfox");
+});
+
+test("wrapText leaves text that fits on one line", () => {
+  assert.equal(wrapText("one two three", 13), "one two three");
+  assert.equal(wrapText("one two three", 80), "one two three");
+  assert.equal(wrapText("one", 3), "one");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText joins words by one space and trims each line", () => {
+  assert.equal(wrapText("one two  three", 80), "one two three");
+  assert.equal(wrapText("  one\ttwo  ", 80), "one two");
+  assert.equal(wrapText("one   two", 3), "one\ntwo");
+  assert.equal(wrapText("   ", 10), "");
+});
+
+test("wrapText keeps the line breaks already in the text", () => {
+  assert.equal(wrapText("one two\nthree four five", 10), "one two\nthree four\nfive");
+  assert.equal(wrapText("first paragraph\n\nsecond paragraph", 9), "first\nparagraph\n\nsecond\nparagraph");
+  assert.equal(wrapText("one\r\ntwo", 10), "one\ntwo");
+  assert.equal(wrapText("one\n", 10), "one\n");
+});
+
+test("wrapText cuts a word that is longer than the width", () => {
+  assert.equal(wrapText("abcdefghij", 4), "abcd\nefgh\nij");
+  assert.equal(wrapText("abcdefgh", 4), "abcd\nefgh");
+  assert.equal(wrapText("a abcdefghij b", 4), "a\nabcd\nefgh\nij b");
+  assert.equal(wrapText("abc", 1), "a\nb\nc");
+});
+
+test("wrapText counts a character outside the basic plane as one", () => {
+  assert.equal(wrapText("😀😀 😀😀", 2), "😀😀\n😀😀");
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+  assert.equal(wrapText("héllo wörld", 5), "héllo\nwörld");
+});
+
+test("wrapText never gives a line longer than the width, and keeps every word in order", () => {
+  const text = "Small helpers for laying out plain text in a terminal, incomprehensibilities included.";
+  for (let width = 1; width <= 100; width += 1) {
+    const wrapped = wrapText(text, width);
+    for (const line of wrapped.split("\n")) {
+      assert.ok(line.length >= 1 && line.length <= width, `width ${width}: ${JSON.stringify(line)}`);
+      assert.equal(line, line.trim());
+    }
+    assert.equal(wrapped.replace(/\s/g, ""), text.replace(/\s/g, ""));
+  }
+});
+
+test("wrapText handles a very long word at a small width", () => {
+  assert.equal(wrapText("a".repeat(200000), 1).length, 399999);
+});
+
+test("wrapText refuses text that is not a string", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(42, 10), TypeError);
+  assert.throws(() => wrapText(["one two"], 10), TypeError);
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  assert.throws(() => wrapText("one two"), TypeError);
+  assert.throws(() => wrapText("one two", "10"), TypeError);
+  assert.throws(() => wrapText("one two", 2.5), TypeError);
+  assert.throws(() => wrapText("one two", NaN), TypeError);
+  assert.throws(() => wrapText("one two", Infinity), TypeError);
+  assert.throws(() => wrapText("one two", 0), RangeError);
+  assert.throws(() => wrapText("one two", -3), RangeError);
+});
