+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,229 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+/** Every object and array reachable from `value`, itself included. */
+function reachable(value, found = new Set()) {
+  if (value === null || typeof value !== "object" || found.has(value)) return found;
+  found.add(value);
+  for (const key of Reflect.ownKeys(value)) reachable(value[key], found);
+  return found;
+}
+
+test("layer lays one layer of settings on another", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key that only one layer has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { a: 1 }), { a: 1 });
+  assert.deepEqual(layer({}, {}), {});
+  assert.deepEqual(layer({ a: { b: 1 } }, { c: { d: 2 } }), { a: { b: 1 }, c: { d: 2 } });
+  assert.deepEqual(Object.keys(layer({ a: 1, b: 2 }, { c: 3, a: 4 })), ["a", "b", "c"]);
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { output: { color: { mode: "auto", depth: { bits: 8, dither: true } }, width: 80 }, verbose: false };
+  const over = { output: { color: { depth: { bits: 24, gamma: { red: 1 } } } } };
+  assert.deepEqual(layer(base, over), {
+    output: { color: { mode: "auto", depth: { bits: 24, dither: true, gamma: { red: 1 } } }, width: 80 },
+    verbose: false,
+  });
+});
+
+for (const [name, value] of [
+  ["an array", [1, 2]],
+  ["a number", 0],
+  ["a string", ""],
+  ["a boolean", false],
+  ["null", null],
+]) {
+  test(`layer lets ${name} in over replace whatever base holds`, () => {
+    for (const held of [{ c: 2, d: 3 }, [7, 8, 9], 1, "text", true, null]) {
+      assert.deepEqual(layer({ a: 1, b: held }, { b: value }), { a: 1, b: value });
+      assert.deepEqual(layer({ x: { a: 1, b: held } }, { x: { b: value } }), { x: { a: 1, b: value } });
+    }
+  });
+}
+
+test("layer lets a plain object in over replace a value that is not one", () => {
+  for (const held of [[7, 8, 9], 1, "text", true, null]) {
+    assert.deepEqual(layer({ b: held }, { b: { c: 9 } }), { b: { c: 9 } });
+  }
+});
+
+test("layer replaces an array whole, never joining it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [4] }), { list: [4] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1 }, { b: 2 }] }, { list: [{ c: 3 }] }), { list: [{ c: 3 }] });
+  assert.deepEqual(layer({ deep: { list: ["x", "y"] } }, { deep: { list: ["z"] } }), { deep: { list: ["z"] } });
+});
+
+for (const [name, value] of [
+  ["an array", [{ a: 1 }]],
+  ["null", null],
+  ["a string", "a=1"],
+  ["a number", 1],
+  ["a Date", new Date(0)],
+]) {
+  test(`layer throws a TypeError when an argument is ${name}`, () => {
+    assert.throws(() => layer(value, { a: 1 }), TypeError);
+    assert.throws(() => layer({ a: 1 }, value), TypeError);
+    assert.throws(() => layer(value, value), TypeError);
+  });
+}
+
+test("layer throws a TypeError when an argument is left out", () => {
+  assert.throws(() => layer(), TypeError);
+  assert.throws(() => layer({ a: 1 }), TypeError);
+  assert.throws(() => layer(undefined, { a: 1 }), TypeError);
+});
+
+test("layer throws a TypeError when an argument is another kind of object", () => {
+  class Settings {}
+  for (const value of [new Settings(), new Map(), () => ({}), true]) {
+    assert.throws(() => layer(value, {}), TypeError);
+    assert.throws(() => layer({}, value), TypeError);
+  }
+});
+
+test("layer changes neither argument", () => {
+  const makeBase = () => ({ a: 1, b: { c: 2, d: [1, { e: 2 }] }, list: [{ f: [3] }], when: new Date(5) });
+  const makeOver = () => ({ b: { c: 9, g: { h: [4, [5]] } }, list: [{ i: 6 }], j: null });
+  const base = makeBase();
+  const over = makeOver();
+  layer(base, over);
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+});
+
+test("layer gives a result that shares nothing with either argument", () => {
+  const base = {
+    kept: { deep: { deeper: [1, { x: [2, { y: 3 }] }] } },
+    list: [{ a: 1 }, [{ b: 2 }]],
+    both: { fromBase: { z: [1] }, replaced: { q: 1 } },
+    when: new Date(5),
+  };
+  const over = {
+    both: { fromOver: { w: [{ v: [1] }] }, replaced: [{ r: { s: 2 } }] },
+    added: { list: [[{ t: 1 }]], when: new Date(7) },
+  };
+  const result = layer(base, over);
+  assert.deepEqual(result, {
+    kept: { deep: { deeper: [1, { x: [2, { y: 3 }] }] } },
+    list: [{ a: 1 }, [{ b: 2 }]],
+    both: { fromBase: { z: [1] }, replaced: [{ r: { s: 2 } }], fromOver: { w: [{ v: [1] }] } },
+    when: new Date(5),
+    added: { list: [[{ t: 1 }]], when: new Date(7) },
+  });
+
+  const given = new Set([...reachable(base), ...reachable(over)]);
+  const made = reachable(result);
+  assert.equal(made.size, 27);
+  for (const part of made) assert.ok(!given.has(part), "the result holds an object of a layer");
+
+  // Changing the result later never changes a layer.
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  result.kept.deep.deeper[1].x[1].y = "changed";
+  result.kept.deep.deeper.push("changed");
+  result.list[1][0].b = "changed";
+  result.both.fromBase.z.push("changed");
+  result.both.fromOver.w[0].v.push("changed");
+  result.both.replaced[0].r.s = "changed";
+  result.added.list[0][0].t = "changed";
+  result.when.setTime(0);
+  result.added.when.setTime(0);
+  delete result.kept.deep;
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("layer shares nothing even when the same object is given as both layers", () => {
+  const settings = { a: { b: [{ c: 1 }] } };
+  const result = layer(settings, settings);
+  assert.deepEqual(result, { a: { b: [{ c: 1 }] } });
+  const given = reachable(settings);
+  for (const part of reachable(result)) assert.ok(!given.has(part));
+});
+
+test("layer never copies keys named __proto__, constructor or prototype", () => {
+  // JSON.parse makes `__proto__` an own key, as a settings file read from disk would have it.
+  const base = JSON.parse(`{
+    "a": 1,
+    "__proto__": { "polluted": "base" },
+    "constructor": { "prototype": { "polluted": "base" } },
+    "prototype": { "polluted": "base" },
+    "nested": {
+      "keep": true,
+      "__proto__": { "polluted": "base" },
+      "deeper": { "constructor": 1, "prototype": 2, "__proto__": 3, "kept": 4 }
+    },
+    "list": [{ "__proto__": { "polluted": "base" }, "constructor": 1, "ok": 1 }, [{ "prototype": 1, "ok": 2 }]]
+  }`);
+  const over = JSON.parse(`{
+    "__proto__": { "polluted": "over" },
+    "constructor": "over",
+    "prototype": ["over"],
+    "nested": {
+      "__proto__": { "polluted": "over" },
+      "deeper": { "__proto__": { "polluted": "over" }, "constructor": { "x": 1 }, "more": 5 },
+      "added": { "prototype": { "polluted": "over" }, "ok": 3 }
+    },
+    "items": [[{ "__proto__": { "polluted": "over" }, "prototype": 1, "ok": 4 }], { "constructor": { "ok": 5 } }]
+  }`);
+  const result = layer(base, over);
+
+  assert.deepEqual(result, {
+    a: 1,
+    nested: { keep: true, deeper: { kept: 4, more: 5 }, added: { ok: 3 } },
+    list: [{ ok: 1 }, [{ ok: 2 }]],
+    items: [[{ ok: 4 }], {}],
+  });
+  for (const part of reachable(result)) {
+    for (const key of ["__proto__", "constructor", "prototype"]) {
+      assert.ok(!Object.hasOwn(part, key), `the result has a key named ${key}`);
+    }
+    assert.equal(Object.getPrototypeOf(part), Array.isArray(part) ? Array.prototype : Object.prototype);
+  }
+  assert.equal(result.polluted, undefined);
+  assert.equal(result.nested.polluted, undefined);
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("layer gives ordinary objects for objects made without a prototype", () => {
+  const bare = (entries) => Object.assign(Object.create(null), entries);
+  const result = layer(bare({ a: bare({ b: 1 }), list: [bare({ c: 2 })] }), bare({ a: bare({ d: 3 }), e: bare({}) }));
+  assert.deepEqual(result, { a: { b: 1, d: 3 }, list: [{ c: 2 }], e: {} });
+  for (const part of reachable(result)) {
+    assert.equal(Object.getPrototypeOf(part), Array.isArray(part) ? Array.prototype : Object.prototype);
+  }
+});
+
+test("layer copies a date, and lets it replace like any other value", () => {
+  const when = new Date(86400000);
+  const result = layer({ at: { hour: 1 }, since: 1 }, { at: when, since: when });
+  assert.ok(result.at instanceof Date && result.since instanceof Date);
+  assert.equal(result.at.getTime(), 86400000);
+  assert.notEqual(result.at, when);
+  assert.notEqual(result.since, when);
+  assert.deepEqual(layer({ at: when }, { at: { hour: 2 } }), { at: { hour: 2 } });
+});
+
+test("layer refuses a value it cannot copy, rather than share it", () => {
+  class Custom {}
+  for (const value of [new Custom(), new Map(), new Set(), /x/, () => {}]) {
+    assert.throws(() => layer({ a: value }, {}), TypeError);
+    assert.throws(() => layer({}, { a: value }), TypeError);
+    assert.throws(() => layer({ a: { b: [value] } }, {}), TypeError);
+  }
+});
+
+test("layer keeps primitive values as they are", () => {
+  assert.deepEqual(layer({ a: "x", b: 0, c: false, d: null, e: undefined }, {}), { a: "x", b: 0, c: false, d: null, e: undefined });
+  const result = layer({ a: 1 }, { a: undefined });
+  assert.ok(Object.hasOwn(result, "a"));
+  assert.equal(result.a, undefined);
+});
