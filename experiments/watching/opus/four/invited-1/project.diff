index 0000000..08f9c06
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,55 @@
+// Keys that reach an object's prototype: never copied into the result.
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+/** A copy of one settings value that shares nothing with it. */
+function copy(value) {
+  if (Array.isArray(value)) return value.map((item) => copy(item));
+  if (isPlainObject(value)) return merge(value, {});
+  if (value instanceof Date) return new Date(value.getTime());
+  if (value !== null && (typeof value === "object" || typeof value === "function")) {
+    throw new TypeError("layer: settings must be plain data (objects, arrays, dates and primitives)");
+  }
+  return value;
+}
+
+function merge(base, over) {
+  const result = {};
+  const overKeys = Object.keys(over);
+  const inOver = new Set(overKeys);
+  for (const key of Object.keys(base)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    if (!inOver.has(key)) result[key] = copy(base[key]);
+    else if (isPlainObject(base[key]) && isPlainObject(over[key])) result[key] = merge(base[key], over[key]);
+    else result[key] = copy(over[key]);
+  }
+  for (const key of overKeys) {
+    if (UNSAFE_KEYS.has(key) || Object.hasOwn(result, key)) continue;
+    result[key] = copy(over[key]);
+  }
+  return result;
+}
+
+/**
+ * Lays one layer of settings on another, such as the user's settings file on
+ * the defaults. Where both hold a plain object under the same key, the two are
+ * layered key by key, at any depth; otherwise a value given in `over` replaces
+ * the one in `base` (an array is replaced whole), and a key only one of them
+ * has is kept.
+ *
+ * Neither argument is changed, and the result is a copy all the way down. Keys
+ * named `__proto__`, `constructor` or `prototype` are left out.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over);
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
