+const NUMERIC = /^(?:0|[1-9][0-9]*)$/;
+const DIGITS = /^[0-9]+$/;
+const IDENTIFIER = /^[0-9A-Za-z-]+$/;
+
+// Splits a version into its core numbers and pre-release identifiers, all kept
+// as strings so that a number of any size compares exactly.
+function parse(version) {
+  const plus = version.indexOf("+");
+  const precedence = plus === -1 ? version : version.slice(0, plus);
+  const build = plus === -1 ? [] : version.slice(plus + 1).split(".");
+  const hyphen = precedence.indexOf("-");
+  const core = (hyphen === -1 ? precedence : precedence.slice(0, hyphen)).split(".");
+  const pre = hyphen === -1 ? [] : precedence.slice(hyphen + 1).split(".");
+  const valid =
+    core.length === 3 &&
+    core.every((id) => NUMERIC.test(id)) &&
+    pre.every((id) => IDENTIFIER.test(id) && (!DIGITS.test(id) || NUMERIC.test(id))) &&
+    build.every((id) => IDENTIFIER.test(id));
+  if (!valid) throw new RangeError(`compare: not a semantic version: ${JSON.stringify(version)}`);
+  return { core, pre };
+}
+
+// Both are digits with no leading zero, so the longer one is the larger.
+function compareNumbers(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareIdentifiers(a, b) {
+  const aNumeric = DIGITS.test(a);
+  const bNumeric = DIGITS.test(b);
+  if (aNumeric && bNumeric) return compareNumbers(a, b);
+  if (aNumeric !== bNumeric) return aNumeric ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +47,21 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") throw new TypeError("compare: both versions must be strings");
+  const left = parse(a);
+  const right = parse(b);
+  for (let i = 0; i < 3; i += 1) {
+    const order = compareNumbers(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+  if (left.pre.length === 0 || right.pre.length === 0) {
+    if (left.pre.length === right.pre.length) return 0;
+    return left.pre.length === 0 ? 1 : -1;
+  }
+  for (let i = 0; i < left.pre.length && i < right.pre.length; i += 1) {
+    const order = compareIdentifiers(left.pre[i], right.pre[i]);
+    if (order !== 0) return order;
+  }
