diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..2d3da7d
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,40 @@
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let length = 0;
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = [...word];
+    if (current !== "" && length + 1 + chars.length <= width) {
+      current += ` ${word}`;
+      length += 1 + chars.length;
+      continue;
+    }
+    if (current !== "") lines.push(current);
+    let start = 0;
+    for (; chars.length - start > width; start += width) lines.push(chars.slice(start, start + width).join(""));
+    current = chars.slice(start).join("");
+    length = chars.length - start;
+  }
+  lines.push(current);
+  return lines.join("\n");
+}
+
+/**
+ * Wraps `text` so that no line is longer than `width` characters. Lines break
+ * between words; the whitespace between the words of a line becomes one space,
+ * and a word longer than `width` is split. Line breaks already in `text` stay.
+ *
+ * @param {string} text
+ * @param {number} width a positive integer
+ * @returns {string} the lines, joined by "\n"
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (typeof width !== "number") throw new TypeError("wrapText: width must be a number");
+  if (!Number.isInteger(width) || width < 1) throw new RangeError("wrapText: width must be a positive integer");
+  return text
+    .split(/\r?\n/)
+    .map((line) => wrapLine(line, width))
+    .join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
