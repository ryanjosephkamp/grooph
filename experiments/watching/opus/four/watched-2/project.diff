+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function reachable(value, found = new Set()) {
+  if (value === null || typeof value !== "object" || found.has(value)) return found;
+  found.add(value);
+  for (const key of Reflect.ownKeys(value)) reachable(value[key], found);
+  return found;
+}
+
+function deepFreeze(value) {
+  for (const part of reachable(value)) Object.freeze(part);
+  return value;
+}
+
+test("layer lays over on top of base", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key only one of the two has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { e: 5 }), { e: 5 });
+  assert.deepEqual(layer({ a: { b: 1 } }, { c: { d: 2 } }), { a: { b: 1 }, c: { d: 2 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { a: { b: { c: { d: { keep: 1, swap: 2 }, side: "c" }, side: "b" }, side: "a" } };
+  const over = { a: { b: { c: { d: { swap: 9, add: 3 } } } } };
+  assert.deepEqual(layer(base, over), {
+    a: { b: { c: { d: { keep: 1, swap: 9, add: 3 }, side: "c" }, side: "b" }, side: "a" },
+  });
+});
+
+test("an array in over replaces the value in base whole, never joined", () => {
+  assert.deepEqual(layer({ a: [1, 2, 3] }, { a: [9] }), { a: [9] });
+  assert.deepEqual(layer({ a: [{ x: 1, y: 2 }] }, { a: [{ x: 9 }] }), { a: [{ x: 9 }] });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: [9] }), { a: [9] });
+  assert.deepEqual(layer({ a: "text" }, { a: [] }), { a: [] });
+});
+
+test("a number in over replaces the value in base", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: 0 }), { a: 0 });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: 7 }), { a: 7 });
+  assert.deepEqual(layer({ a: [1] }, { a: 7 }), { a: 7 });
+});
+
+test("a string in over replaces the value in base", () => {
+  assert.deepEqual(layer({ a: "auto" }, { a: "" }), { a: "" });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: "never" }), { a: "never" });
+  assert.deepEqual(layer({ a: [1] }, { a: "never" }), { a: "never" });
+});
+
+test("a boolean in over replaces the value in base", () => {
+  assert.deepEqual(layer({ a: true }, { a: false }), { a: false });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: false }), { a: false });
+  assert.deepEqual(layer({ a: [1] }, { a: true }), { a: true });
+});
+
+test("null in over replaces the value in base", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: null }), { a: null });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: null }), { a: null });
+  assert.deepEqual(layer({ a: [1] }, { a: null }), { a: null });
+});
+
+test("a plain object in over replaces a value in base that is not one", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: [1] }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: null }, { a: { b: 2 } }), { a: { b: 2 } });
+});
+
+test("layer refuses an array as either argument", () => {
+  assert.throws(() => layer([], {}), TypeError);
+  assert.throws(() => layer({}, []), TypeError);
+});
+
+test("layer refuses null as either argument", () => {
+  assert.throws(() => layer(null, {}), TypeError);
+  assert.throws(() => layer({}, null), TypeError);
+});
+
+test("layer refuses a string as either argument", () => {
+  assert.throws(() => layer("a", {}), TypeError);
+  assert.throws(() => layer({}, "a"), TypeError);
+});
+
+test("layer refuses a number as either argument", () => {
+  assert.throws(() => layer(3, {}), TypeError);
+  assert.throws(() => layer({}, 3), TypeError);
+});
+
+test("layer refuses a Date as either argument", () => {
+  assert.throws(() => layer(new Date(0), {}), TypeError);
+  assert.throws(() => layer({}, new Date(0)), TypeError);
+});
+
+test("layer refuses an argument left out", () => {
+  assert.throws(() => layer(), TypeError);
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(undefined, {}), TypeError);
+});
+
+test("layer changes neither argument", () => {
+  const make = () => [
+    { a: 1, b: { c: 2, d: [1, { e: 2 }] }, kept: { deep: { list: [[1], [2]] } }, when: new Date(5) },
+    { b: { c: 9, d: [{ f: 3 }] }, e: { g: [4] }, a: null },
+  ];
+  // Frozen all the way down: any write to a layer would throw here.
+  const [base, over] = make().map(deepFreeze);
+  layer(base, over);
+  assert.deepEqual([base, over], make());
+});
+
+test("the result shares nothing with either argument", () => {
+  const base = {
+    onlyBase: { list: [{ x: 1 }, [2, { y: 3 }]] },
+    both: { kept: { z: [1] }, swapped: { old: true } },
+    replaced: [{ gone: true }],
+    when: new Date(5),
+  };
+  const over = {
+    onlyOver: { list: [{ p: 1 }, [2, { q: 3 }]] },
+    both: { swapped: [{ fresh: [1, 2] }], added: { r: { s: 1 } } },
+    replaced: { now: [{ t: 1 }] },
+  };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  const result = layer(base, over);
+
+  const theirs = new Set([...reachable(base), ...reachable(over)]);
+  for (const part of reachable(result)) assert.ok(!theirs.has(part), "the result holds an object of a layer");
+  assert.deepEqual(result.when, base.when);
+
+  // Changing the result later never changes a layer.
+  result.onlyBase.list[1][1].y = "changed";
+  result.onlyBase.list.push("changed");
+  result.both.kept.z.push("changed");
+  result.both.swapped[0].fresh.push("changed");
+  result.onlyOver.list[0].p = "changed";
+  result.replaced.now[0].t = "changed";
+  result.when.setTime(0);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("layer never copies __proto__, constructor or prototype keys", () => {
+  // JSON.parse makes `__proto__` an own key, as a settings file would.
+  const hostile = '{ "__proto__": { "polluted": 1 }, "constructor": { "prototype": { "polluted": 1 } }, "prototype": 1 }';
+  const base = JSON.parse(`{ "top": ${hostile}, "list": [${hostile}, [${hostile}]], "both": { "deep": ${hostile} }, "ok": 1, "__proto__": { "polluted": 1 } }`);
+  const over = JSON.parse(`{ "new": ${hostile}, "list2": [[${hostile}]], "both": { "deep": ${hostile}, "more": ${hostile} }, "constructor": 1, "__proto__": { "polluted": 1 } }`);
+  const result = layer(base, over);
+
+  for (const part of reachable(result)) {
+    for (const key of ["__proto__", "constructor", "prototype"]) {
+      assert.ok(!Object.hasOwn(part, key), `the result holds a key named ${key}`);
+    }
+    if (!Array.isArray(part)) assert.equal(Object.getPrototypeOf(part), Object.prototype);
+  }
+  assert.deepEqual(result, { top: {}, list: [{}, [{}]], both: { deep: {}, more: {} }, ok: 1, new: {}, list2: [[{}]] });
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("every plain object in the result is an ordinary object", () => {
+  const bare = (entries) => Object.assign(Object.create(null), entries);
+  const result = layer(bare({ a: bare({ b: 1 }), list: [bare({ c: 2 })] }), bare({ a: bare({ d: 3 }), e: bare({}) }));
+  assert.deepEqual(result, { a: { b: 1, d: 3 }, list: [{ c: 2 }], e: {} });
+  for (const part of reachable(result)) {
+    if (!Array.isArray(part)) assert.equal(Object.getPrototypeOf(part), Object.prototype);
+  }
+});
+
+test("layer refuses a value it cannot copy", () => {
+  assert.throws(() => layer({ a: new Map() }, {}), TypeError);
+  assert.throws(() => layer({}, { a: [() => {}] }), TypeError);
+});
