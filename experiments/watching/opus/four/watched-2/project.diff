+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,53 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function hasKey(settings, key) {
+  return Object.prototype.propertyIsEnumerable.call(settings, key);
+}
+
+function copy(value) {
+  if (value === null || (typeof value !== "object" && typeof value !== "function")) return value;
+  if (value instanceof Date) return new Date(value.getTime());
+  if (Array.isArray(value)) return Array.from(value, copy);
+  if (!isPlainObject(value)) throw new TypeError("layer: settings must hold plain data only (plain objects, arrays, dates and primitives)");
+  const out = {};
+  for (const key of Object.keys(value)) {
+    if (!UNSAFE_KEYS.has(key)) out[key] = copy(value[key]);
+  }
+  return out;
+}
+
+function lay(base, over) {
+  const out = {};
+  for (const key of Object.keys(base)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    if (!hasKey(over, key)) out[key] = copy(base[key]);
+    else if (isPlainObject(base[key]) && isPlainObject(over[key])) out[key] = lay(base[key], over[key]);
+    else out[key] = copy(over[key]);
+  }
+  for (const key of Object.keys(over)) {
+    if (!UNSAFE_KEYS.has(key) && !hasKey(base, key)) out[key] = copy(over[key]);
+  }
+  return out;
+}
+
+/**
+ * Lays the settings in `over` on top of those in `base` and returns the result.
+ * Plain objects under the same key are layered key by key, at any depth; any
+ * other value in `over` replaces the one in `base`. The result is a fresh copy:
+ * it shares no object or array with either argument, and never carries a key
+ * named `__proto__`, `constructor` or `prototype`.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return lay(base, over);
+}
