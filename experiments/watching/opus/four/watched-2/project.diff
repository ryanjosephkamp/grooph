+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks lines between words", () => {
+  assert.equal(
+    wrapText("The quick brown fox jumps over the lazy dog", 10),
+    "The quick\nbrown fox\njumps over\nthe lazy\ndog",
+  );
+  assert.equal(wrapText("one two three", 7), "one two\nthree");
+  assert.equal(wrapText("one two three", 6), "one\ntwo\nthree");
+});
+
+test("wrapText leaves text that already fits alone", () => {
+  assert.equal(wrapText("one two", 7), "one two");
+  assert.equal(wrapText("one two", 80), "one two");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText never makes a line longer than the width", () => {
+  const text = "Small helpers for laying out plain text in a terminal, incomprehensibilities included.";
+  for (let width = 1; width <= 90; width += 1) {
+    const wrapped = wrapText(text, width);
+    for (const line of wrapped.split("\n")) assert.ok(line.length <= width, `width ${width}: ${JSON.stringify(line)}`);
+    assert.equal(wrapped.replace(/\s/g, ""), text.replace(/\s/g, ""));
+  }
+});
+
+test("wrapText turns the whitespace between words into one space", () => {
+  assert.equal(wrapText("  one   two\tthree  ", 20), "one two three");
+  assert.equal(wrapText("one      two", 5), "one\ntwo");
+  assert.equal(wrapText("   ", 5), "");
+});
+
+test("wrapText splits a word longer than the width", () => {
+  assert.equal(wrapText("abcdefghij", 4), "abcd\nefgh\nij");
+  assert.equal(wrapText("abcdefgh", 4), "abcd\nefgh");
+  assert.equal(wrapText("a abcdefghij b", 4), "a\nabcd\nefgh\nij b");
+  assert.equal(wrapText("abc", 1), "a\nb\nc");
+});
+
+test("wrapText keeps the line breaks already in the text", () => {
+  assert.equal(wrapText("one two\nthree four five", 9), "one two\nthree\nfour five");
+  assert.equal(wrapText("one\n\ntwo", 10), "one\n\ntwo");
+  assert.equal(wrapText("one\r\ntwo\n", 10), "one\ntwo\n");
+});
+
+test("wrapText counts a character outside the BMP once and never splits it", () => {
+  assert.equal(wrapText("😀😀 😀😀", 5), "😀😀 😀😀");
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+});
+
+test("wrapText refuses text that is not a string", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(42, 10), TypeError);
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  assert.throws(() => wrapText("one"), TypeError);
+  assert.throws(() => wrapText("one", "10"), TypeError);
+  assert.throws(() => wrapText("one", 0), RangeError);
+  assert.throws(() => wrapText("one", -3), RangeError);
+  assert.throws(() => wrapText("one", 2.5), RangeError);
+  assert.throws(() => wrapText("one", NaN), RangeError);
+  assert.throws(() => wrapText("one", Infinity), RangeError);
+});
