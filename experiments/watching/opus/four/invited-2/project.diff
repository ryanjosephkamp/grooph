--- /dev/null
+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,212 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function reachable(value, seen = new Set()) {
+  if (value === null || typeof value !== "object" || seen.has(value)) return seen;
+  seen.add(value);
+  for (const key of Reflect.ownKeys(value)) reachable(value[key], seen);
+  return seen;
+}
+
+function deepFreeze(value) {
+  for (const object of reachable(value)) Object.freeze(object);
+  return value;
+}
+
+test("layer lays over on top of base", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key only one of the layers has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { b: 2 }), { b: 2 });
+  assert.deepEqual(layer({ a: 1, n: { x: 1 } }, { b: 2, m: { y: 2 } }), { a: 1, n: { x: 1 }, b: 2, m: { y: 2 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { a: { b: { c: { d: { keep: 1, change: 1 }, keep: 2 } } } };
+  const over = { a: { b: { c: { d: { change: 9, add: 3 } } }, add: 4 } };
+  assert.deepEqual(layer(base, over), {
+    a: { b: { c: { d: { keep: 1, change: 9, add: 3 }, keep: 2 } }, add: 4 },
+  });
+});
+
+test("layer is not limited by the call stack", () => {
+  const depth = 50_000;
+  const base = {};
+  const over = {};
+  for (let i = 0, b = base, o = over; i < depth; i += 1) {
+    b.fromBase = i;
+    o.fromOver = i;
+    b = b.next = {};
+    o = o.next = {};
+  }
+  let at = layer(base, over);
+  for (let i = 0; i < depth; i += 1) {
+    assert.equal(at.fromBase, i);
+    assert.equal(at.fromOver, i);
+    at = at.next;
+  }
+  assert.deepEqual(at, {});
+});
+
+test("layer replaces a value in base with an array, a number, a string, a boolean or null from over", () => {
+  const held = [{ x: 1 }, [1, 2], 1, "one", true, null, undefined];
+  for (const given of [[7, 8], 7, "seven", false, null]) {
+    for (const was of held) {
+      assert.deepEqual(layer({ key: was }, { key: given }), { key: given });
+      assert.deepEqual(layer({ deep: { key: was, kept: 1 } }, { deep: { key: given } }), { deep: { key: given, kept: 1 } });
+    }
+  }
+});
+
+test("layer replaces an array whole, never joining it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [4] }), { list: [4] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1 }, { b: 2 }] }, { list: [{ c: 3 }] }), { list: [{ c: 3 }] });
+  assert.deepEqual(layer({ n: { list: [1, 2] } }, { n: { list: [3] } }), { n: { list: [3] } });
+});
+
+test("layer replaces a value that is not a plain object with a plain object from over", () => {
+  assert.deepEqual(layer({ key: 1 }, { key: { a: 1 } }), { key: { a: 1 } });
+  assert.deepEqual(layer({ key: [1, 2] }, { key: { a: 1 } }), { key: { a: 1 } });
+  assert.deepEqual(layer({ key: null }, { key: { a: 1 } }), { key: { a: 1 } });
+});
+
+test("layer refuses a base or an over that is not a plain object", () => {
+  const notPlain = { "an array": [], null: null, "a string": "a", "a number": 1, "a Date": new Date(0) };
+  for (const [name, bad] of Object.entries(notPlain)) {
+    assert.throws(() => layer(bad, {}), TypeError, `${name} as base`);
+    assert.throws(() => layer({}, bad), TypeError, `${name} as over`);
+    assert.throws(() => layer(bad, bad), TypeError, `${name} as both`);
+  }
+});
+
+test("layer refuses an argument left out", () => {
+  assert.throws(() => layer(), TypeError);
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(undefined, {}), TypeError);
+});
+
+test("layer changes neither argument", () => {
+  const makeBase = () => ({ a: 1, b: { c: 2, list: [1, { x: 1 }] }, only: { deep: [[1], { y: 2 }] }, when: new Date(5) });
+  const makeOver = () => ({ b: { c: 9, list: [{ z: 3 }] }, e: { f: [{ g: 1 }] }, when: new Date(6) });
+  const base = deepFreeze(makeBase());
+  const over = deepFreeze(makeOver());
+  layer(base, over);
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+});
+
+test("layer returns a result that shares nothing with the layers", () => {
+  const makeBase = () => ({
+    kept: { deep: { list: [1, { x: [{ y: 1 }] }] } },
+    both: { fromBase: { list: [[1], { a: 1 }] }, replaced: [1] },
+    list: [{ a: 1 }, [2, [3]]],
+    when: new Date(5),
+  });
+  const makeOver = () => ({
+    both: { fromOver: { list: [[2], { b: 2 }] }, replaced: [{ c: [3] }] },
+    added: { deep: [{ d: { e: [4] } }] },
+    since: new Date(6),
+  });
+  const base = makeBase();
+  const over = makeOver();
+  const result = layer(base, over);
+  assert.deepEqual(result, {
+    kept: { deep: { list: [1, { x: [{ y: 1 }] }] } },
+    both: { fromBase: { list: [[1], { a: 1 }] }, replaced: [{ c: [3] }], fromOver: { list: [[2], { b: 2 }] } },
+    list: [{ a: 1 }, [2, [3]]],
+    when: new Date(5),
+    added: { deep: [{ d: { e: [4] } }] },
+    since: new Date(6),
+  });
+
+  const fromLayers = new Set([...reachable(base), ...reachable(over)]);
+  for (const object of reachable(result)) assert.ok(!fromLayers.has(object), "the result shares an object with a layer");
+
+  // Changing the result everywhere leaves the layers as they were.
+  for (const object of reachable(result)) {
+    if (Array.isArray(object)) object.push("changed");
+    else if (object instanceof Date) object.setTime(0);
+    else object.changed = true;
+  }
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+});
+
+test("layer copies the same object twice when a layer holds it under two keys", () => {
+  const shared = { list: [1] };
+  const result = layer({ a: shared, b: shared }, { c: shared });
+  assert.deepEqual(result, { a: { list: [1] }, b: { list: [1] }, c: { list: [1] } });
+  assert.notEqual(result.a, result.b);
+  assert.deepEqual(layer(shared, shared), { list: [1] });
+});
+
+test("layer never copies __proto__, constructor or prototype keys", () => {
+  const hostile = () =>
+    JSON.parse(`{
+      "__proto__": { "polluted": true },
+      "constructor": { "prototype": { "polluted": true } },
+      "prototype": { "polluted": true },
+      "safe": 1,
+      "nested": {
+        "__proto__": { "polluted": true },
+        "constructor": 1,
+        "prototype": 2,
+        "deeper": { "__proto__": { "polluted": true }, "constructor": 1, "prototype": 2, "safe": 3 },
+        "list": [{ "__proto__": { "polluted": true }, "constructor": 1, "prototype": 2, "safe": 4 },
+                 [{ "__proto__": { "polluted": true }, "constructor": 1, "prototype": 2, "safe": 5 }]]
+      }
+    }`);
+  const clean = { safe: 1, nested: { deeper: { safe: 3 }, list: [{ safe: 4 }, [{ safe: 5 }]] } };
+  const bare = Object.assign(Object.create(null), { safe: 1, inner: Object.assign(Object.create(null), { safe: 2 }) });
+
+  const results = [
+    layer(hostile(), {}),
+    layer({}, hostile()),
+    layer(hostile(), hostile()),
+    layer({ nested: { list: [] }, other: hostile() }, { nested: hostile().nested, more: [hostile()] }),
+    layer(bare, { list: [bare] }),
+  ];
+  assert.deepEqual(results[0], clean);
+  assert.deepEqual(results[1], clean);
+  assert.deepEqual(results[2], clean);
+  assert.deepEqual(results[3], { nested: clean.nested, other: clean, more: [clean] });
+  assert.deepEqual(results[4], { safe: 1, inner: { safe: 2 }, list: [{ safe: 1, inner: { safe: 2 } }] });
+
+  for (const result of results) {
+    for (const object of reachable(result)) {
+      for (const key of ["__proto__", "constructor", "prototype"]) {
+        assert.ok(!Object.hasOwn(object, key), `${key} was copied`);
+      }
+      if (!Array.isArray(object)) assert.equal(Object.getPrototypeOf(object), Object.prototype);
+    }
+  }
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("layer refuses a value it cannot copy as plain data", () => {
+  class Custom {}
+  for (const bad of [() => {}, new Map(), new Set(), new Custom(), /x/]) {
+    assert.throws(() => layer({ key: bad }, {}), TypeError);
+    assert.throws(() => layer({}, { key: bad }), TypeError);
+    assert.throws(() => layer({}, { list: [{ key: bad }] }), TypeError);
+  }
+});
+
+test("layer refuses a layer that contains itself", () => {
+  const loop = { name: "loop" };
+  loop.self = loop;
+  const list = { items: [] };
+  list.items.push(list);
+  assert.throws(() => layer(loop, {}), TypeError);
+  assert.throws(() => layer({}, loop), TypeError);
+  assert.throws(() => layer(loop, loop), TypeError);
+  assert.throws(() => layer({}, list), TypeError);
+});
