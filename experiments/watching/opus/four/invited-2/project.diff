--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,23 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+```js
+import { wrapText } from "./src/wrap.mjs";
+
+wrapText("the quick brown fox jumps over the lazy dog", 10);
+// "the quick\nbrown fox\njumps over\nthe lazy\ndog"
+```
+
+`wrapText(text, width)` wraps `text` so that no line is longer than `width`
+characters, and returns the lines joined with `\n`.
+
+- Words are runs of characters that are not whitespace. Each line takes as many
+  words as fit, with one space between them and none at either end.
+- A word longer than `width` is broken into pieces of `width` characters.
+- Line breaks already in `text` are kept: each line is wrapped on its own, and
+  a blank line stays blank.
+- A character is one Unicode code point; double-width and combining characters
+  are not measured.
+- `text` that is not a string, or a `width` that is not a number, throws a
+  `TypeError`; a `width` that is not a positive integer throws a `RangeError`.
