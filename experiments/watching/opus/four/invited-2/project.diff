+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,45 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters, and returns
+ * the lines joined with "\n".
+ *
+ * Words are runs of characters that are not whitespace. Each line takes as many
+ * words as fit, with one space between them and none at either end. A word
+ * longer than `width` is broken into pieces of `width` characters. Line breaks
+ * already in `text` are kept, so paragraphs and blank lines stay as they are.
+ * A character is one Unicode code point.
+ *
+ * @param {string} text
+ * @param {number} width a positive integer
+ * @returns {string}
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (typeof width !== "number") throw new TypeError("wrapText: width must be a number");
+  if (!Number.isInteger(width) || width < 1) throw new RangeError("wrapText: width must be a positive integer");
+  return text
+    .split(/\r\n|\r|\n/)
+    .flatMap((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let length = 0; // of `current`, in code points
+  for (const word of line.split(/\s+/)) {
+    if (word === "") continue;
+    const chars = Array.from(word);
+    if (length > 0 && length + 1 + chars.length <= width) {
+      current += " " + word;
+      length += 1 + chars.length;
+      continue;
+    }
+    if (length > 0) lines.push(current);
+    let start = 0;
+    for (; chars.length - start > width; start += width) lines.push(chars.slice(start, start + width).join(""));
+    current = chars.slice(start).join("");
+    length = chars.length - start;
+  }
+  lines.push(current);
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..ec4e0bb
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText fills each line with as many words as fit", () => {
+  assert.equal(wrapText("the quick brown fox jumps over the lazy dog", 10), "the quick\nbrown fox\njumps over\nthe lazy\ndog");
+  assert.equal(wrapText("aa bb cc", 5), "aa bb\ncc");
+  assert.equal(wrapText("aa bb cc", 4), "aa\nbb\ncc");
+  assert.equal(wrapText("a b c", 1), "a\nb\nc");
+});
+
+test("wrapText leaves text that already fits on one line", () => {
+  assert.equal(wrapText("one two three", 13), "one two three");
+  assert.equal(wrapText("one two three", 80), "one two three");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText puts one space between words and none at the ends of a line", () => {
+  assert.equal(wrapText("  one   two\tthree  ", 80), "one two three");
+  assert.equal(wrapText("one    two", 5), "one\ntwo");
+  assert.equal(wrapText("   ", 10), "");
+});
+
+test("wrapText breaks a word longer than the width", () => {
+  assert.equal(wrapText("abcdefghij", 4), "abcd\nefgh\nij");
+  assert.equal(wrapText("abcdefgh", 4), "abcd\nefgh");
+  assert.equal(wrapText("ab cdefghij kl", 4), "ab\ncdef\nghij\nkl");
+  assert.equal(wrapText("a bcdefg h", 4), "a\nbcde\nfg h");
+});
+
+test("wrapText keeps the line breaks already in the text", () => {
+  assert.equal(wrapText("one two three\nfour five", 9), "one two\nthree\nfour five");
+  assert.equal(wrapText("first paragraph\n\nsecond paragraph", 10), "first\nparagraph\n\nsecond\nparagraph");
+  assert.equal(wrapText("one\r\ntwo\rthree\n", 10), "one\ntwo\nthree\n");
+});
+
+test("wrapText counts a character outside the BMP as one, and never splits it", () => {
+  assert.equal(wrapText("😀😀 😀😀", 2), "😀😀\n😀😀");
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+});
+
+test("wrapText never returns a line longer than the width", () => {
+  const text = "Small helpers for laying out plain text in a terminal, extraordinarily-long-words included.\n\nA second paragraph.";
+  for (let width = 1; width <= 100; width += 1) {
+    const wrapped = wrapText(text, width);
+    for (const line of wrapped.split("\n")) {
+      assert.ok(line.length <= width, `width ${width}: ${JSON.stringify(line)}`);
+      assert.equal(line, line.trim());
+    }
+    assert.equal(wrapped.replace(/\s+/g, ""), text.replace(/\s+/g, ""));
+  }
+});
+
+test("wrapText refuses text that is not a string", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(["one two"], 10), TypeError);
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  assert.throws(() => wrapText("one two", "10"), TypeError);
+  assert.throws(() => wrapText("one two"), TypeError);
+  for (const bad of [0, -1, 2.5, NaN, Infinity]) assert.throws(() => wrapText("one two", bad), RangeError);
+});
