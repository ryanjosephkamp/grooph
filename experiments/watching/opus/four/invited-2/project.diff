+    seed ^= seed >>> 17;
+    seed ^= seed << 5;
+    return (seed >>> 0) % below;
+  };
+  const alphabet = ['"', '"', '"', ",", ",", "\n", "\r", "\r\n", "a", "b", " ", "\t", "\u0000", "é", "😀", "\ud83d", '""', '","'];
+  let parsed = 0;
