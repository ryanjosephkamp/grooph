diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..2709626
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,93 @@
+const SKIPPED_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function keysOf(object) {
+  return Reflect.ownKeys(object).filter(
+    (key) => !SKIPPED_KEYS.has(key) && Object.prototype.propertyIsEnumerable.call(object, key),
+  );
+}
+
+/**
+ * Lays the settings in `over` on top of those in `base` and returns the result.
+ *
+ * Where both hold a plain object under the same key, the two are layered key by
+ * key, at any depth. Otherwise a value given in `over` replaces the one in
+ * `base` (an array is replaced whole), and a key only one of them has is kept.
+ *
+ * Neither argument is changed and the result shares nothing with them: every
+ * object, array and Date in it is a fresh copy. Keys named `__proto__`,
+ * `constructor` or `prototype` are never copied. A value that cannot be copied
+ * as plain data (a function, a Map, a class instance) or a layer that contains
+ * itself throws a TypeError.
+ *
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+
+  const result = {};
+  // Work is kept on a stack of its own, so nesting is not limited by the call
+  // stack. A step fills `into` from `base`, from `over`, or from both.
+  const steps = [{ into: result, base, over }];
+  // The objects being walked right now on each side; meeting one again inside
+  // itself means the layer contains itself.
+  const walking = { base: new Set(), over: new Set() };
+
+  // What the result holds in place of `value`; a container is filled by a later step.
+  const copyOf = (value, side) => {
+    if (typeof value === "function") throw new TypeError("layer: a function cannot be copied");
+    if (value === null || typeof value !== "object") return value;
+    if (value instanceof Date) return new Date(value.getTime());
+    if (!Array.isArray(value) && !isPlainObject(value)) {
+      throw new TypeError("layer: only plain objects, arrays and Dates can be copied");
+    }
+    const into = Array.isArray(value) ? [] : {};
+    steps.push({ into, [side]: value });
+    return into;
+  };
+
+  while (steps.length > 0) {
+    const step = steps.pop();
+    if (step.leave) {
+      walking.base.delete(step.leave.base);
+      walking.over.delete(step.leave.over);
+      continue;
+    }
+    for (const side of ["base", "over"]) {
+      if (step[side] === undefined) continue;
+      if (walking[side].has(step[side])) throw new TypeError(`layer: ${side} contains itself`);
+      walking[side].add(step[side]);
+    }
+    steps.push({ leave: step });
+
+    const { into, base: under, over: top } = step;
+    if (Array.isArray(into)) {
+      const side = under === undefined ? "over" : "base";
+      const from = step[side];
+      for (let i = 0; i < from.length; i += 1) into.push(copyOf(from[i], side));
+      continue;
+    }
+    const topKeys = new Set(top === undefined ? [] : keysOf(top));
+    for (const key of under === undefined ? [] : keysOf(under)) {
+      if (!topKeys.has(key)) {
+        into[key] = copyOf(under[key], "base");
+      } else if (isPlainObject(under[key]) && isPlainObject(top[key])) {
+        into[key] = {};
+        steps.push({ into: into[key], base: under[key], over: top[key] });
+      } else {
+        into[key] = copyOf(top[key], "over");
+      }
+      topKeys.delete(key);
+    }
+    for (const key of topKeys) into[key] = copyOf(top[key], "over");
+  }
+  return result;
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
