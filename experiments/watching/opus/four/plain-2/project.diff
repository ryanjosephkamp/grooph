index c20a655..53aa05d 100644
--- a/semver-mini/src/semver.mjs
+++ b/semver-mini/src/semver.mjs
@@ -1,3 +1,7 @@
+const NUMERIC = /^(?:0|[1-9][0-9]*)$/;
+const DIGITS = /^[0-9]+$/;
+const IDENTIFIER = /^[0-9A-Za-z-]+$/;
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +15,47 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") throw new TypeError("compare: both versions must be strings");
+  const left = parse(a);
+  const right = parse(b);
+  for (let i = 0; i < 3; i += 1) {
+    const order = compareNumeric(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+  // A version with a pre-release comes before the same version without one.
+  if (left.pre.length === 0 || right.pre.length === 0) return Math.sign(right.pre.length - left.pre.length);
+  for (let i = 0; i < left.pre.length && i < right.pre.length; i += 1) {
+    const order = compareIdentifier(left.pre[i], right.pre[i]);
+    if (order !== 0) return order;
+  }
+  return Math.sign(left.pre.length - right.pre.length);
+}
+
+// Splits a version into its core numbers and pre-release identifiers, all kept
+// as strings: a number of any size must compare exactly.
+function parse(version) {
+  const invalid = () => new RangeError(`compare: ${JSON.stringify(version)} is not a semantic version`);
+  const plus = version.indexOf("+");
+  const main = plus === -1 ? version : version.slice(0, plus);
+  if (plus !== -1 && !version.slice(plus + 1).split(".").every((id) => IDENTIFIER.test(id))) throw invalid();
+  const dash = main.indexOf("-");
+  const core = (dash === -1 ? main : main.slice(0, dash)).split(".");
+  const pre = dash === -1 ? [] : main.slice(dash + 1).split(".");
+  if (core.length !== 3 || !core.every((id) => NUMERIC.test(id))) throw invalid();
+  if (!pre.every((id) => IDENTIFIER.test(id) && (!DIGITS.test(id) || NUMERIC.test(id)))) throw invalid();
+  return { core, pre };
+}
+
+// Numbers without leading zeros: the longer one is the greater.
+function compareNumeric(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function compareIdentifier(a, b) {
+  const aNumeric = DIGITS.test(a);
+  const bNumeric = DIGITS.test(b);
+  if (aNumeric && bNumeric) return compareNumeric(a, b);
+  if (aNumeric !== bNumeric) return aNumeric ? -1 : 1;
+  return a < b ? -1 : a > b ? 1 : 0;
 }
