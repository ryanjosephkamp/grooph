index 0000000..a656be9
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,55 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+/**
+ * Lays the settings in `over` on top of those in `base` and returns the result.
+ * Plain objects under the same key are layered key by key, at any depth; any
+ * other value in `over` (an array included) replaces the one in `base`.
+ * Neither argument is changed and the result shares nothing with them.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return lay(lay({}, base, new Set()), over, new Set());
+}
+
+// Lays `source` onto `target`, an object of our own making. `open` holds the
+// objects being walked, so that settings which contain themselves are refused.
+function lay(target, source, open) {
+  if (open.has(source)) throw new TypeError("layer: settings must not contain themselves");
+  open.add(source);
+  for (const key of Object.keys(source)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    const value = source[key];
+    if (isPlainObject(value)) {
+      const under = Object.hasOwn(target, key) && isPlainObject(target[key]) ? target[key] : {};
+      target[key] = lay(under, value, open);
+    } else {
+      target[key] = copy(value, open);
+    }
+  }
+  open.delete(source);
+  return target;
+}
+
+function copy(value, open) {
+  if (value === null || (typeof value !== "object" && typeof value !== "function")) return value;
+  if (isPlainObject(value)) return lay({}, value, open);
+  if (Array.isArray(value)) {
+    if (open.has(value)) throw new TypeError("layer: settings must not contain themselves");
+    open.add(value);
+    const items = Array.from(value, (item) => copy(item, open));
+    open.delete(value);
+    return items;
+  }
+  if (value instanceof Date) return new Date(value.getTime());
+  throw new TypeError("layer: settings must be plain data (objects, arrays, dates and primitives)");
+}
