+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function reachable(value, found = new Set()) {
+  if (value === null || typeof value !== "object" || found.has(value)) return found;
+  found.add(value);
+  for (const key of Reflect.ownKeys(value)) reachable(value[key], found);
+  return found;
+}
+
+function deepFreeze(value) {
+  for (const part of reachable(value)) Object.freeze(part);
+  return value;
+}
+
+test("layer lays over on top of base", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key only one of them has", () => {
+  assert.deepEqual(layer({ a: 1 }, { b: 2 }), { a: 1, b: 2 });
+  assert.deepEqual(layer({ a: { b: 1 } }, {}), { a: { b: 1 } });
+  assert.deepEqual(layer({}, { a: { b: 1 } }), { a: { b: 1 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { a: { b: { c: { d: { keep: 1, swap: 1 }, keep: 1 } } } };
+  const over = { a: { b: { c: { d: { swap: 2, add: 2 } }, add: 2 } } };
+  assert.deepEqual(layer(base, over), {
+    a: { b: { c: { d: { keep: 1, swap: 2, add: 2 }, keep: 1 }, add: 2 } },
+  });
+});
+
+test("layer lets an array in over replace the value in base whole", () => {
+  assert.deepEqual(layer({ a: [1, 2, 3] }, { a: [4] }), { a: [4] });
+  assert.deepEqual(layer({ a: [1, 2, 3] }, { a: [] }), { a: [] });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: [4] }), { a: [4] });
+  assert.deepEqual(layer({ a: 1 }, { a: [4] }), { a: [4] });
+  assert.deepEqual(layer({ a: [{ b: 1, c: 1 }] }, { a: [{ b: 2 }] }), { a: [{ b: 2 }] });
+});
+
+test("layer lets a number in over replace the value in base", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: 0 }), { a: 0 });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: 7 }), { a: 7 });
+  assert.deepEqual(layer({ a: [1] }, { a: 7 }), { a: 7 });
+});
+
+test("layer lets a string in over replace the value in base", () => {
+  assert.deepEqual(layer({ a: "x" }, { a: "" }), { a: "" });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: "y" }), { a: "y" });
+  assert.deepEqual(layer({ a: [1] }, { a: "y" }), { a: "y" });
+});
+
+test("layer lets a boolean in over replace the value in base", () => {
+  assert.deepEqual(layer({ a: true }, { a: false }), { a: false });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: false }), { a: false });
+  assert.deepEqual(layer({ a: [1] }, { a: true }), { a: true });
+});
+
+test("layer lets null in over replace the value in base", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: null }), { a: null });
+  assert.deepEqual(layer({ a: { b: 1 } }, { a: null }), { a: null });
+  assert.deepEqual(layer({ a: [1] }, { a: null }), { a: null });
+});
+
+test("layer lets a plain object in over replace a value that is not one", () => {
+  assert.deepEqual(layer({ a: 1 }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: null }, { a: { b: 2 } }), { a: { b: 2 } });
+  assert.deepEqual(layer({ a: [1] }, { a: { b: 2 } }), { a: { b: 2 } });
+});
+
+test("layer lets a key given as undefined in over replace the value in base", () => {
+  const result = layer({ a: 1 }, { a: undefined });
+  assert.ok(Object.hasOwn(result, "a"));
+  assert.equal(result.a, undefined);
+});
+
+test("layer refuses a base that is an array", () => {
+  assert.throws(() => layer([], {}), TypeError);
+});
+
+test("layer refuses an over that is an array", () => {
+  assert.throws(() => layer({}, []), TypeError);
+});
+
+test("layer refuses a base that is null", () => {
+  assert.throws(() => layer(null, {}), TypeError);
+});
+
+test("layer refuses an over that is null", () => {
+  assert.throws(() => layer({}, null), TypeError);
+});
+
+test("layer refuses a base that is a string", () => {
+  assert.throws(() => layer("a", {}), TypeError);
+});
+
+test("layer refuses an over that is a string", () => {
+  assert.throws(() => layer({}, "a"), TypeError);
+});
+
+test("layer refuses a base that is a number", () => {
+  assert.throws(() => layer(1, {}), TypeError);
+});
+
+test("layer refuses an over that is a number", () => {
+  assert.throws(() => layer({}, 1), TypeError);
+});
+
+test("layer refuses a base that is a Date", () => {
+  assert.throws(() => layer(new Date(0), {}), TypeError);
+});
+
+test("layer refuses an over that is a Date", () => {
+  assert.throws(() => layer({}, new Date(0)), TypeError);
+});
+
+test("layer refuses an argument left out", () => {
+  assert.throws(() => layer(), TypeError);
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(undefined, {}), TypeError);
+});
+
+test("layer refuses other arguments that are not plain objects", () => {
+  class Settings {}
+  for (const bad of [true, new Map(), new Settings(), () => ({})]) {
+    assert.throws(() => layer(bad, {}), TypeError);
+    assert.throws(() => layer({}, bad), TypeError);
+  }
+});
+
+test("layer changes neither argument", () => {
+  const make = () => [
+    { a: 1, b: { c: 2, d: [1, { e: 1 }] }, list: [{ x: 1 }], only: { deep: { z: 1 } } },
+    { b: { c: 9, f: { g: [2] } }, list: [{ y: 2 }, [3]], more: { h: 1 } },
+  ];
+  const [base, over] = make();
+  layer(base, over);
+  assert.deepEqual([base, over], make());
+
+  // Frozen layers would throw (strict mode) if layer tried to write to them.
+  const [frozenBase, frozenOver] = make().map(deepFreeze);
+  assert.deepEqual(layer(frozenBase, frozenOver), layer(base, over));
+});
+
+test("layer returns a result that shares nothing with base or over", () => {
+  const base = { a: 1, b: { c: 2, d: [1, { e: 1 }] }, list: [{ x: 1 }], only: { deep: { z: [[{ w: 1 }]] } } };
+  const over = { b: { c: 9, f: { g: [2, { i: 1 }] } }, list: [{ y: 2 }, [3, { j: 1 }]], more: { h: { k: 1 } } };
+  const snapshot = structuredClone([base, over]);
+  const result = layer(base, over);
+
+  const given = new Set([...reachable(base), ...reachable(over)]);
+  const made = reachable(result);
+  assert.ok(made.size > 10);
+  for (const part of made) assert.ok(!given.has(part), `shared: ${JSON.stringify(part)}`);
+
+  // Changing the result, anywhere, changes neither layer.
+  result.a = 0;
+  result.b.c = 0;
+  result.b.d[1].e = 0;
+  result.b.d.push(0);
+  result.b.f.g[1].i = 0;
+  result.list[0].y = 0;
+  result.list[1][1].j = 0;
+  result.list.length = 0;
+  result.only.deep.z[0][0].w = 0;
+  delete result.only.deep;
+  result.more.h.k = 0;
+  assert.deepEqual([base, over], snapshot);
+});
+
+test("layer does not share the same object given under two keys or in both layers", () => {
+  const shared = { n: [1] };
+  const result = layer({ a: shared, b: shared }, { c: shared, d: [shared] });
+  const made = [result.a, result.b, result.c, result.d[0]];
+  assert.deepEqual(made, [shared, shared, shared, shared]);
+  assert.equal(new Set([...made, shared]).size, 5);
+  assert.equal(new Set([...made.map((part) => part.n), shared.n]).size, 5);
+});
+
+test("layer copies a Date instead of sharing it", () => {
+  const when = new Date("2026-09-12T00:00:00Z");
+  const result = layer({ a: when }, { b: [when] });
+  assert.deepEqual(result, { a: when, b: [when] });
+  assert.notEqual(result.a, when);
+  assert.notEqual(result.b[0], when);
+});
+
+test("layer refuses a value it cannot copy, rather than share it", () => {
+  class Settings {}
+  for (const bad of [new Map(), new Settings(), () => 1]) {
+    assert.throws(() => layer({ a: bad }, {}), TypeError);
+    assert.throws(() => layer({}, { a: { b: [bad] } }), TypeError);
+  }
+});
+
+test("layer refuses settings that contain themselves", () => {
+  const loop = { a: {} };
+  loop.a.back = loop;
+  const list = [];
+  list.push(list);
+  assert.throws(() => layer(loop, {}), TypeError);
+  assert.throws(() => layer({}, loop), TypeError);
+  assert.throws(() => layer({}, { list }), TypeError);
+});
+
+test("layer never copies __proto__, constructor or prototype keys", () => {
+  // JSON.parse makes `__proto__` an own key, as a settings file would.
+  const unsafe = (keep) =>
+    `{"__proto__": {"polluted": true}, "constructor": {"prototype": {"polluted": true}}, "prototype": 1, ${keep}}`;
+  const base = JSON.parse(
+    unsafe(`"base": 1, "both": {${unsafe('"b": 1').slice(1)}, "list": [${unsafe('"b": 1')}, [${unsafe('"b": 2')}]]`),
+  );
+  const over = JSON.parse(
+    unsafe(`"over": 1, "both": {${unsafe('"o": 1').slice(1)}, "only": {"deep": ${unsafe('"o": 2')}}, "items": [${unsafe('"o": 3')}]`),
+  );
+  assert.ok(Object.hasOwn(base, "__proto__") && Object.hasOwn(over.both, "__proto__"));
+  assert.ok(Object.hasOwn(base.list[1][0], "__proto__") && Object.hasOwn(over.only.deep, "constructor"));
+
+  for (const result of [layer(base, over), layer(base, {}), layer({}, over)]) {
+    for (const part of reachable(result)) {
+      for (const key of ["__proto__", "constructor", "prototype"]) assert.ok(!Object.hasOwn(part, key), key);
+      assert.equal(Object.getPrototypeOf(part), Array.isArray(part) ? Array.prototype : Object.prototype);
+      assert.equal(part.polluted, undefined);
+    }
+  }
+  assert.deepEqual(layer(base, over), {
+    base: 1,
+    both: { b: 1, o: 1 },
+    list: [{ b: 1 }, [{ b: 2 }]],
+    over: 1,
+    only: { deep: { o: 2 } },
+    items: [{ o: 3 }],
+  });
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("layer makes every plain object in the result an ordinary object", () => {
+  const bare = (entries) => Object.assign(Object.create(null), entries);
+  const base = bare({ a: bare({ b: 1, c: bare({ d: 1 }) }), list: [bare({ e: 1 })] });
+  const over = bare({ a: bare({ c: bare({ f: 2 }) }), g: bare({}) });
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: { b: 1, c: { d: 1, f: 2 } }, list: [{ e: 1 }], g: {} });
+  for (const part of reachable(result)) {
+    if (!Array.isArray(part)) assert.equal(Object.getPrototypeOf(part), Object.prototype);
+  }
+});
diff --git a/textwrap/README.md b/textwrap/README.md
index 0cac2e6..ff869ec 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,17 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+```js
+import { wrapText } from "./src/wrap.mjs";
+
+wrapText("the quick brown fox jumps", 10); // "the quick\nbrown fox\njumps"
+```
+
+`wrapText(text, width)` wraps `text` so that no line is longer than `width`
+characters, and returns the lines joined by `\n`. Words are joined by single
+spaces and a line is broken between words; a word longer than `width` is split
+across lines. Line breaks already in `text` are kept. Width is counted in
+characters, not terminal columns, so a wide character such as `字` counts as
+one. A `text` that is not a string or a `width` that is not an integer throws a
+`TypeError`; a `width` below 1 throws a `RangeError`.
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
new file mode 100644
index 0000000..a5a629f
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,43 @@
+const graphemes = new Intl.Segmenter(undefined, { granularity: "grapheme" });
+
+/**
+ * Wraps `text` so that no line is longer than `width` characters.
+ *
+ * Words (runs of characters that are not whitespace) are joined by single
+ * spaces and a line is broken between words. A word longer than `width` is
+ * split across lines. Line breaks already in `text` are kept.
+ *
+ * @param {string} text
+ * @param {number} width the longest a line may be, a positive integer
+ * @returns {string} the wrapped lines, joined by "\n"
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (!Number.isInteger(width)) throw new TypeError("wrapText: width must be an integer");
+  if (width < 1) throw new RangeError("wrapText: width must be at least 1");
+  return text
+    .split(/\r?\n/)
+    .flatMap((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let used = 0;
+  for (const word of line.trim().split(/\s+/)) {
+    // Characters as a reader sees them, so "é" or an emoji is never cut in two.
+    let chars = Array.from(graphemes.segment(word), (part) => part.segment);
+    if (used > 0 && used + 1 + chars.length <= width) {
+      current += ` ${word}`;
+      used += 1 + chars.length;
+      continue;
+    }
+    if (used > 0) lines.push(current);
+    for (; chars.length > width; chars = chars.slice(width)) lines.push(chars.slice(0, width).join(""));
+    current = chars.join("");
+    used = chars.length;
+  }
+  lines.push(current);
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..7ade7b8
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks between words so no line is longer than the width", () => {
+  assert.equal(wrapText("the quick brown fox jumps over the lazy dog", 10), "the quick\nbrown fox\njumps over\nthe lazy\ndog");
+  assert.equal(wrapText("aa bb cc", 5), "aa bb\ncc");
+  assert.equal(wrapText("aa bb cc", 4), "aa\nbb\ncc");
+  assert.equal(wrapText("a b c", 1), "a\nb\nc");
+});
+
+test("wrapText leaves text that already fits alone", () => {
+  assert.equal(wrapText("one two", 7), "one two");
+  assert.equal(wrapText("one two", 80), "one two");
+  assert.equal(wrapText("", 10), "");
+});
+
+test("wrapText joins words by one space and drops whitespace at the ends of lines", () => {
+  assert.equal(wrapText("  one \t two   three  ", 80), "one two three");
+  assert.equal(wrapText("one      two", 5), "one\ntwo");
+  assert.equal(wrapText("   ", 5), "");
+});
+
+test("wrapText splits a word longer than the width", () => {
+  assert.equal(wrapText("abcdefgh", 3), "abc\ndef\ngh");
+  assert.equal(wrapText("abcdef", 3), "abc\ndef");
+  assert.equal(wrapText("to abcdefgh it", 5), "to\nabcde\nfgh\nit");
+  assert.equal(wrapText("ab abcdefg hi", 5), "ab\nabcde\nfg hi");
+});
+
+test("wrapText keeps the line breaks already in the text", () => {
+  assert.equal(wrapText("one two\nthree four", 80), "one two\nthree four");
+  assert.equal(wrapText("one two three\n\nfour five six", 8), "one two\nthree\n\nfour\nfive six");
+  assert.equal(wrapText("one\r\ntwo\n", 80), "one\ntwo\n");
+});
+
+test("wrapText counts a character once, however it is encoded", () => {
+  assert.equal(wrapText("😀😀 😀😀", 5), "😀😀 😀😀");
+  assert.equal(wrapText("😀😀😀", 2), "😀😀\n😀");
+  assert.equal(wrapText("ééé", 2), "éé\né");
+});
+
+test("wrapText never returns a line longer than the width", () => {
+  const text = "Small helpers for laying out plain text in a terminal, incomprehensibilities included.";
+  for (let width = 1; width <= 90; width += 1) {
+    const lines = wrapText(text, width).split("\n");
+    for (const line of lines) assert.ok(line.length <= width && line.length > 0, `width ${width}: ${JSON.stringify(line)}`);
+    assert.equal(lines.join("").replaceAll(" ", ""), text.replaceAll(" ", ""));
+  }
+});
+
+test("wrapText refuses text that is not a string", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(["one two"], 10), TypeError);
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  assert.throws(() => wrapText("one two"), TypeError);
+  assert.throws(() => wrapText("one two", "10"), TypeError);
+  assert.throws(() => wrapText("one two", 2.5), TypeError);
+  assert.throws(() => wrapText("one two", Infinity), TypeError);
+  assert.throws(() => wrapText("one two", 0), RangeError);
+  assert.throws(() => wrapText("one two", -3), RangeError);
+});
