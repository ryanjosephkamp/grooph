+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,42 @@
+/**
+ * Wraps `text` so that no line is longer than `width` characters, breaking only
+ * at whitespace. The words of a line are joined by single spaces. Line breaks
+ * already in the text are kept, and a word longer than `width` is not split: it
+ * gets a line of its own.
+ *
+ * @param {string} text
+ * @param {number} width the longest a line may be, in characters; at least 1
+ * @returns {string} the wrapped lines, joined by "\n"
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (!Number.isInteger(width)) throw new TypeError("wrap: width must be an integer");
+  if (width < 1) throw new RangeError("wrap: width must be at least 1");
+  return text
+    .split(/\r?\n/)
+    .flatMap((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line, width) {
+  const lines = [];
+  let current = "";
+  let length = 0;
+  for (const word of line.trim().split(/\s+/)) {
+    // Counted in code points, so that an emoji is one character.
+    const wordLength = [...word].length;
+    if (current !== "" && length + 1 + wordLength > width) {
+      lines.push(current);
+      current = "";
+    }
+    if (current === "") {
+      current = word;
+      length = wordLength;
+    } else {
+      current += ` ${word}`;
+      length += 1 + wordLength;
+    }
+  }
+  lines.push(current);
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..d25d8b4
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap breaks lines at whitespace so that none is longer than the width", () => {
+  assert.equal(wrap("the quick brown fox jumps over the lazy dog", 10), "the quick\nbrown fox\njumps over\nthe lazy\ndog");
+  assert.equal(wrap("the quick brown fox", 15), "the quick brown\nfox");
+  assert.equal(wrap("aa bb cc", 5), "aa bb\ncc");
+  assert.equal(wrap("a b c", 1), "a\nb\nc");
+});
+
+test("wrap leaves text that already fits alone", () => {
+  assert.equal(wrap("one two", 7), "one two");
+  assert.equal(wrap("one two", 80), "one two");
+  assert.equal(wrap("", 10), "");
+});
+
+test("wrap joins the words of a line by single spaces", () => {
+  assert.equal(wrap("  one \t two   three  ", 80), "one two three");
+  assert.equal(wrap("one   two", 5), "one\ntwo");
+  assert.equal(wrap("   ", 10), "");
+});
+
+test("wrap keeps the line breaks already in the text", () => {
+  assert.equal(wrap("one two three\nfour five", 9), "one two\nthree\nfour five");
+  assert.equal(wrap("first paragraph\n\nsecond paragraph", 10), "first\nparagraph\n\nsecond\nparagraph");
+  assert.equal(wrap("one\r\ntwo", 10), "one\ntwo");
+  assert.equal(wrap("one\n", 10), "one\n");
+});
+
+test("wrap gives a word longer than the width a line of its own", () => {
+  assert.equal(wrap("see https://example.com/a/long/path for more", 10), "see\nhttps://example.com/a/long/path\nfor more");
+  assert.equal(wrap("abcdefgh", 3), "abcdefgh");
+});
+
+test("wrap counts an emoji as one character", () => {
+  assert.equal(wrap("😀😀 😀😀", 5), "😀😀 😀😀");
+  assert.equal(wrap("😀😀 😀😀", 4), "😀😀\n😀😀");
+});
+
+test("wrap refuses text that is not a string and a width that is not a positive integer", () => {
+  assert.throws(() => wrap(null, 10), TypeError);
+  assert.throws(() => wrap(42, 10), TypeError);
+  assert.throws(() => wrap("one two"), TypeError);
+  assert.throws(() => wrap("one two", "10"), TypeError);
+  assert.throws(() => wrap("one two", 2.5), TypeError);
+  assert.throws(() => wrap("one two", NaN), TypeError);
+  assert.throws(() => wrap("one two", Infinity), TypeError);
+  assert.throws(() => wrap("one two", 0), RangeError);
+  assert.throws(() => wrap("one two", -3), RangeError);
+});
