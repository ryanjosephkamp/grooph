+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function reachable(value, found = new Set()) {
+  if (value === null || typeof value !== "object" || found.has(value)) return found;
+  found.add(value);
+  for (const key of Reflect.ownKeys(value)) reachable(value[key], found);
+  return found;
+}
+
+function deepFreeze(value) {
+  for (const part of reachable(value)) Object.freeze(part);
+  return value;
+}
+
+test("layer lays over on top of base", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key only one of the two has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { a: 1 }), { a: 1 });
+  assert.deepEqual(layer({ a: { b: 1 } }, { c: { d: 2 } }), { a: { b: 1 }, c: { d: 2 } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { a: { b: { c: { d: { keep: 1, change: 2 }, keep: 3 } } } };
+  const over = { a: { b: { c: { d: { change: 20, add: 30 } }, add: 40 } } };
+  assert.deepEqual(layer(base, over), {
+    a: { b: { c: { d: { keep: 1, change: 20, add: 30 }, keep: 3 }, add: 40 } },
+  });
+});
+
+test("layer lets an array, a number, a string, a boolean or null in over replace the base value", () => {
+  const held = { object: { a: 1 }, array: [1, 2], number: 1, string: "base", boolean: true, null: null };
+  for (const value of [[9], 9, "over", false, null]) {
+    for (const key of Object.keys(held)) {
+      assert.deepEqual(layer(held, { [key]: value }), { ...held, [key]: value }, `${JSON.stringify(value)} over ${key}`);
+    }
+  }
+});
+
+test("layer lets a plain object in over replace a base value that is not one", () => {
+  assert.deepEqual(layer({ a: 1, b: [1], c: null }, { a: { x: 1 }, b: { y: 2 }, c: { z: 3 } }), {
+    a: { x: 1 },
+    b: { y: 2 },
+    c: { z: 3 },
+  });
+});
+
+test("layer replaces an array whole, never joining it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [4] }), { list: [4] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1 }, { b: 2 }] }, { list: [{ c: 3 }] }), { list: [{ c: 3 }] });
+  assert.deepEqual(layer({ deep: { list: [1, 2] } }, { deep: { list: [3] } }), { deep: { list: [3] } });
+});
+
+test("layer refuses an argument that is not a plain object", () => {
+  const bad = { array: [], null: null, string: "a", number: 1, Date: new Date(0) };
+  for (const [name, value] of Object.entries(bad)) {
+    assert.throws(() => layer(value, {}), TypeError, `${name} as base`);
+    assert.throws(() => layer({}, value), TypeError, `${name} as over`);
+  }
+  assert.throws(() => layer({}), TypeError, "over left out");
+  assert.throws(() => layer(undefined, {}), TypeError, "base left out");
+  assert.throws(() => layer(), TypeError, "both left out");
+});
+
+test("layer changes neither argument", () => {
+  const makeBase = () => ({ a: 1, b: { c: 2, list: [{ d: 3 }] }, only: { base: [1] } });
+  const makeOver = () => ({ b: { c: 9, list: [{ e: 4 }, [5]] }, extra: { over: [{ f: 6 }] } });
+  const base = deepFreeze(makeBase());
+  const over = deepFreeze(makeOver());
+  layer(base, over);
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+});
+
+test("layer returns a result that shares nothing with its arguments", () => {
+  const base = { kept: { deep: { list: [{ a: 1 }, [2, { b: 3 }]] } }, both: { fromBase: { c: [4] } }, when: new Date(0) };
+  const over = { both: { fromOver: { d: [{ e: 5 }] } }, added: [[{ f: 6 }], { g: [7] }], replaced: { h: { i: 8 } } };
+  const baseBefore = structuredClone(base);
+  const overBefore = structuredClone(over);
+  const result = layer(base, over);
+
+  assert.deepEqual(result, {
+    kept: { deep: { list: [{ a: 1 }, [2, { b: 3 }]] } },
+    both: { fromBase: { c: [4] }, fromOver: { d: [{ e: 5 }] } },
+    when: new Date(0),
+    added: [[{ f: 6 }], { g: [7] }],
+    replaced: { h: { i: 8 } },
+  });
+  const given = new Set([...reachable(base), ...reachable(over)]);
+  for (const part of reachable(result)) assert.ok(!given.has(part), "the result shares an object with a layer");
+
+  // Changing the result later never changes a layer.
+  result.kept.deep.list[0].a = "changed";
+  result.kept.deep.list[1][1].b = "changed";
+  result.both.fromBase.c.push("changed");
+  result.both.fromOver.d[0].e = "changed";
+  result.added[0][0].f = "changed";
+  result.added[1].g.push("changed");
+  result.replaced.h.i = "changed";
+  result.when.setTime(1);
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(over, overBefore);
+});
+
+test("layer shares nothing even when both arguments hold the same object", () => {
+  const shared = { list: [{ a: 1 }] };
+  const result = layer({ s: shared }, { s: shared, t: shared });
+  assert.deepEqual(result, { s: { list: [{ a: 1 }] }, t: { list: [{ a: 1 }] } });
+  for (const part of reachable(result)) assert.ok(!reachable(shared).has(part));
+  assert.deepEqual(layer(shared, shared), shared);
+  assert.notEqual(layer(shared, shared).list, shared.list);
+});
+
+test("layer never copies __proto__, constructor or prototype keys", () => {
+  // JSON.parse makes "__proto__" an own key, as a settings file read from disk would.
+  const hostile = '{ "__proto__": { "polluted": true }, "constructor": { "prototype": { "polluted": true } }, "prototype": { "polluted": true }, "ok": 1 }';
+  const nest = (text) => JSON.parse(`{ "top": ${text}, "deep": { "deeper": ${text} }, "list": [${text}, [${text}]], "__proto__": { "polluted": true }, "constructor": 1, "prototype": 2 }`);
+  const clean = { top: { ok: 1 }, deep: { deeper: { ok: 1 } }, list: [{ ok: 1 }, [{ ok: 1 }]] };
+
+  const results = [
+    layer(nest(hostile), {}),
+    layer({}, nest(hostile)),
+    layer(nest(hostile), nest(hostile)),
+    layer({ top: { ok: 0, kept: 1 }, deep: { deeper: {} } }, nest(hostile)),
+  ];
+  assert.deepEqual(results[0], clean);
+  assert.deepEqual(results[1], clean);
+  assert.deepEqual(results[2], clean);
+  assert.deepEqual(results[3], { ...clean, top: { ok: 1, kept: 1 } });
+
+  for (const result of results) {
+    for (const part of reachable(result)) {
+      if (Array.isArray(part)) continue;
+      assert.equal(Object.getPrototypeOf(part), Object.prototype);
+      for (const key of ["__proto__", "constructor", "prototype"]) assert.ok(!Object.hasOwn(part, key), key);
+      assert.equal(part.polluted, undefined);
+    }
+  }
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("layer returns ordinary objects for layers that have no prototype", () => {
+  const bare = Object.assign(Object.create(null), { a: Object.assign(Object.create(null), { b: 1 }) });
+  for (const result of [layer(bare, {}), layer({}, bare), layer(bare, bare)]) {
+    assert.deepEqual(result, { a: { b: 1 } });
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+  }
+});
+
+test("layer refuses a value it cannot copy", () => {
+  class Custom {}
+  for (const value of [new Map(), new Set(), new Custom(), () => {}]) {
+    assert.throws(() => layer({}, { a: value }), TypeError);
+    assert.throws(() => layer({ a: value }, {}), TypeError);
+    assert.throws(() => layer({}, { a: [{ b: value }] }), TypeError);
+  }
+});
