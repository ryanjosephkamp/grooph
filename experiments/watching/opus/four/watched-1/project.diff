--- a/semver-mini/src/semver.mjs
+++ b/semver-mini/src/semver.mjs
@@ -1,3 +1,37 @@
+// The grammar of https://semver.org (§2, §9, §10).
+const NUMERIC = "0|[1-9]\\d*";
+const PRERELEASE_ID = `${NUMERIC}|\\d*[a-zA-Z-][0-9a-zA-Z-]*`;
+const BUILD_ID = "[0-9a-zA-Z-]+";
+const SEMVER = new RegExp(
+  `^(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})` +
+    `(?:-((?:${PRERELEASE_ID})(?:\\.(?:${PRERELEASE_ID}))*))?` +
+    `(?:\\+(?:${BUILD_ID})(?:\\.(?:${BUILD_ID}))*)?$`,
+);
+
+function parse(version) {
+  const match = SEMVER.exec(version);
+  if (match === null) throw new RangeError(`compare: ${JSON.stringify(version)} is not a valid semantic version`);
+  return {
+    core: [match[1], match[2], match[3]],
+    prerelease: match[4] === undefined ? [] : match[4].split("."),
+  };
+}
+
+// Numbers stay strings so that any number of digits compares exactly; with no
+// leading zeros, the longer one is the larger.
+function compareNumeric(a, b) {
+  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function compareIdentifier(a, b) {
+  const aNumeric = /^\d+$/.test(a);
+  const bNumeric = /^\d+$/.test(b);
+  if (aNumeric && bNumeric) return compareNumeric(a, b);
+  if (aNumeric !== bNumeric) return aNumeric ? -1 : 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
 /**
  * Compare two semantic versions by precedence (https://semver.org, §11).
  *
@@ -11,5 +45,24 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string" || typeof b !== "string") throw new TypeError("compare: both versions must be strings");
+  const left = parse(a);
+  const right = parse(b);
+  for (let i = 0; i < 3; i += 1) {
+    const order = compareNumeric(left.core[i], right.core[i]);
+    if (order !== 0) return order;
+  }
+  // A version with a pre-release comes before the same version without one.
+  if (left.prerelease.length === 0 || right.prerelease.length === 0) {
+    if (left.prerelease.length === right.prerelease.length) return 0;
+    return left.prerelease.length === 0 ? 1 : -1;
+  }
+  const shared = Math.min(left.prerelease.length, right.prerelease.length);
+  for (let i = 0; i < shared; i += 1) {
+    const order = compareIdentifier(left.prerelease[i], right.prerelease[i]);
+    if (order !== 0) return order;
+  }
+  // All shared identifiers are equal: the longer set of identifiers comes later.
+  if (left.prerelease.length === right.prerelease.length) return 0;
+  return left.prerelease.length < right.prerelease.length ? -1 : 1;
 }
