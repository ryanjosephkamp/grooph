index 0cac2e6..9a66b98 100644
--- a/textwrap/README.md
+++ b/textwrap/README.md
@@ -7,3 +7,24 @@ import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+```js
+import { wrap } from "./src/wrap.mjs";
+
+wrap("the quick brown fox jumps over the lazy dog", 10);
+// "the quick\nbrown fox\njumps over\nthe lazy\ndog"
+```
+
+`wrap(text, width)` returns `text` with line breaks added at whitespace so that
+no line is longer than `width` characters.
+
+- The words of a line are joined by single spaces; whitespace at the start and
+  end of a line is dropped.
+- Line breaks already in the text are kept (`\r\n` becomes `\n`), so paragraphs
+  and blank lines survive.
+- A word longer than `width` is never split: it gets a line of its own, and
+  that line is longer than `width`.
+- `width` is counted in characters (code points). Characters that take two
+  terminal columns, and escape codes, are not measured specially.
+- A `text` that is not a string, or a `width` that is not an integer, throws a
+  `TypeError`; a `width` below 1 throws a `RangeError`.
