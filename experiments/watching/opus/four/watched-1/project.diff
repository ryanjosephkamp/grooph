diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..9986437
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,47 @@
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function copy(value) {
+  if (Array.isArray(value)) return value.map(copy);
+  if (isPlainObject(value)) return layerObjects(value, {});
+  if (value instanceof Date) return new Date(value.getTime());
+  if (typeof value === "function" || (value !== null && typeof value === "object")) {
+    throw new TypeError(`layer: cannot copy a ${Object.prototype.toString.call(value)} value; settings must be plain data`);
+  }
+  return value;
+}
+
+function layerObjects(base, over) {
+  const result = {};
+  for (const key of Object.keys(base)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    if (!Object.hasOwn(over, key)) result[key] = copy(base[key]);
+    else if (isPlainObject(base[key]) && isPlainObject(over[key])) result[key] = layerObjects(base[key], over[key]);
+    else result[key] = copy(over[key]);
+  }
+  for (const key of Object.keys(over)) {
+    if (UNSAFE_KEYS.has(key) || Object.hasOwn(base, key)) continue;
+    result[key] = copy(over[key]);
+  }
+  return result;
+}
+
+/**
+ * Lays the settings in `over` on top of those in `base` and returns the result.
+ * Plain objects under the same key are layered key by key, at any depth; any
+ * other value in `over` replaces the one in `base`. The result is a copy: it
+ * shares no object or array with either argument.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return layerObjects(base, over);
+}
