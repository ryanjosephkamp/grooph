@@ -0,0 +1,43 @@
+/**
+ * Wraps `text` to lines of at most `width` characters, breaking only between
+ * words: runs of characters that are not whitespace. The words of a line are
+ * joined by one space, so a line never starts or ends with whitespace. A word
+ * longer than `width` is not split; it gets a line of its own. Line breaks
+ * already in `text` are kept, and each of those lines is wrapped separately.
+ *
+ * @param {string} text
+ * @param {number} width the longest a line may be, counted in code points
+ * @returns {string} the wrapped lines, joined by "\n"
+ */
+export function wrapText(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrapText: text must be a string");
+  if (!Number.isInteger(width)) throw new TypeError("wrapText: width must be an integer");
+  if (width < 1) throw new RangeError("wrapText: width must be at least 1");
+  return text
+    .split(/\r?\n/)
+    .map((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(text, width) {
+  const lines = [];
+  let line = "";
+  let length = 0;
+  for (const word of text.split(/\s+/)) {
+    if (word === "") continue;
+    const wordLength = [...word].length;
+    if (line === "") {
+      line = word;
+      length = wordLength;
+    } else if (length + 1 + wordLength <= width) {
+      line += " " + word;
+      length += 1 + wordLength;
+    } else {
+      lines.push(line);
+      line = word;
+      length = wordLength;
+    }
+  }
+  lines.push(line);
+  return lines.join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..92b3b44
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrapText } from "../src/wrap.mjs";
+
+test("wrapText breaks between words so that no line is longer than the width", () => {
+  assert.equal(wrapText("the quick brown fox", 10), "the quick\nbrown fox");
+  assert.equal(wrapText("the quick brown fox jumps over the lazy dog", 15), "the quick brown\nfox jumps over\nthe lazy dog");
+  assert.equal(wrapText("a b c", 1), "a\nb\nc");
+});
+
+test("wrapText fills a line exactly up to the width", () => {
+  assert.equal(wrapText("ab cd ef", 5), "ab cd\nef");
+  assert.equal(wrapText("ab cd ef", 4), "ab\ncd\nef");
+  assert.equal(wrapText("ab cd ef", 8), "ab cd ef");
+});
+
+test("wrapText leaves text that already fits alone", () => {
+  assert.equal(wrapText("short", 80), "short");
+  assert.equal(wrapText("", 80), "");
+});
+
+test("wrapText joins words by one space and drops whitespace at line ends", () => {
+  assert.equal(wrapText("  one   two\tthree  ", 80), "one two three");
+  assert.equal(wrapText("one   two", 3), "one\ntwo");
+  assert.equal(wrapText("   ", 5), "");
+});
+
+test("wrapText gives a word longer than the width a line of its own", () => {
+  assert.equal(wrapText("a extraordinarily long word", 6), "a\nextraordinarily\nlong\nword");
+  assert.equal(wrapText("extraordinarily", 6), "extraordinarily");
+});
+
+test("wrapText keeps the line breaks already in the text", () => {
+  assert.equal(wrapText("one two\nthree four five", 10), "one two\nthree four\nfive");
+  assert.equal(wrapText("first paragraph\n\nsecond paragraph", 10), "first\nparagraph\n\nsecond\nparagraph");
+  assert.equal(wrapText("one\r\ntwo", 10), "one\ntwo");
+  assert.equal(wrapText("one two\n", 3), "one\ntwo\n");
+});
+
+test("wrapText counts a character outside the basic plane once", () => {
+  assert.equal(wrapText("😀😀 😀😀", 5), "😀😀 😀😀");
+  assert.equal(wrapText("😀😀 😀😀", 4), "😀😀\n😀😀");
+});
+
+test("wrapText refuses text that is not a string", () => {
+  assert.throws(() => wrapText(null, 10), TypeError);
+  assert.throws(() => wrapText(["one two"], 10), TypeError);
+});
+
+test("wrapText refuses a width that is not a positive integer", () => {
+  assert.throws(() => wrapText("one two"), TypeError);
+  assert.throws(() => wrapText("one two", "10"), TypeError);
+  assert.throws(() => wrapText("one two", 2.5), TypeError);
+  assert.throws(() => wrapText("one two", NaN), TypeError);
+  assert.throws(() => wrapText("one two", Infinity), TypeError);
+  assert.throws(() => wrapText("one two", 0), RangeError);
+  assert.throws(() => wrapText("one two", -4), RangeError);
+});
