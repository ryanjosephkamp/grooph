+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+// Every object and array reachable from `value`, itself included.
+function reachable(value, found = new Set()) {
+  if (value !== null && typeof value === "object" && !found.has(value)) {
+    found.add(value);
+    for (const inner of Object.values(value)) reachable(inner, found);
+  }
+  return found;
+}
+
+test("layer lays over on top of base", () => {
+  assert.deepEqual(layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 }), { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer keeps a key that only one layer has", () => {
+  assert.deepEqual(layer({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(layer({}, { b: 2 }), { b: 2 });
+  assert.deepEqual(layer({ a: { deep: [1] } }, { b: { deep: [2] } }), { a: { deep: [1] }, b: { deep: [2] } });
+  assert.deepEqual(layer({}, {}), {});
+});
+
+test("layer layers plain objects under the same key at any depth", () => {
+  const base = { a: { b: { c: { d: { keep: 1, swap: 1 }, only: "base" } } } };
+  const over = { a: { b: { c: { d: { swap: 2, add: 3 } }, extra: true } } };
+  assert.deepEqual(layer(base, over), {
+    a: { b: { c: { d: { keep: 1, swap: 2, add: 3 }, only: "base" }, extra: true } },
+  });
+});
+
+const held = [{ c: 2 }, [1, 2], "text", 7, true, null];
+const replacements = [
+  ["an array", [9]],
+  ["an empty array", []],
+  ["a number", 0],
+  ["a string", ""],
+  ["a boolean", false],
+  ["null", null],
+];
+for (const [kind, value] of replacements) {
+  test(`layer lets ${kind} in over replace whatever base holds`, () => {
+    for (const below of held) {
+      assert.deepEqual(layer({ a: below, z: 1 }, { a: value }), { a: value, z: 1 });
+      assert.deepEqual(layer({ n: { a: below, z: 1 } }, { n: { a: value } }), { n: { a: value, z: 1 } });
+    }
+  });
+}
+
+test("layer lets a plain object in over replace a value that is not one", () => {
+  for (const below of [[1, 2], "text", 7, true, null]) {
+    assert.deepEqual(layer({ a: below }, { a: { c: 9 } }), { a: { c: 9 } });
+  }
+});
+
+test("layer lets a key given as undefined in over replace the value in base", () => {
+  const result = layer({ a: 1 }, { a: undefined });
+  assert.ok(Object.hasOwn(result, "a"));
+  assert.equal(result.a, undefined);
+});
+
+test("layer replaces an array whole and never joins it", () => {
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [9] }), { list: [9] });
+  assert.deepEqual(layer({ list: [1, 2, 3] }, { list: [] }), { list: [] });
+  assert.deepEqual(layer({ list: [{ a: 1, b: 2 }, { c: 3 }] }, { list: [{ a: 9 }] }), { list: [{ a: 9 }] });
+  assert.deepEqual(layer({ n: { list: [[1], [2]] } }, { n: { list: [[3]] } }), { n: { list: [[3]] } });
+});
+
+const notPlain = [
+  ["an array", [{ a: 1 }]],
+  ["null", null],
+  ["a string", "a"],
+  ["a number", 1],
+  ["a Date", new Date(0)],
+  ["undefined", undefined],
+];
+for (const [kind, value] of notPlain) {
+  test(`layer refuses ${kind} as base`, () => {
+    assert.throws(() => layer(value, { a: 1 }), TypeError);
+  });
+  test(`layer refuses ${kind} as over`, () => {
+    assert.throws(() => layer({ a: 1 }, value), TypeError);
+  });
+}
+
+test("layer refuses an argument left out", () => {
+  assert.throws(() => layer({ a: 1 }), TypeError);
+  assert.throws(() => layer(), TypeError);
+});
+
+test("layer refuses an object that is not plain as a layer", () => {
+  class Settings {}
+  assert.throws(() => layer(new Settings(), {}), TypeError);
+  assert.throws(() => layer({}, new Map()), TypeError);
+  assert.throws(() => layer(() => {}, {}), TypeError);
+});
+
+test("layer changes neither argument and shares nothing with them", () => {
+  const makeBase = () => ({
+    kept: { list: [{ x: 1 }, [2, { y: 3 }]], inner: { z: 4 } },
+    keptList: [[{ deep: [1] }]],
+    both: { fromBase: { p: [1] }, swapped: { q: 1 }, same: { list: [{ r: 1 }] } },
+    replaced: { gone: [1] },
+    replacedList: [{ gone: 1 }],
+  });
+  const makeOver = () => ({
+    added: { list: [{ x: 5 }, [6, { y: 7 }]], inner: { z: 8 } },
+    addedList: [[{ deep: [2] }]],
+    both: { fromOver: { p: [2] }, swapped: [{ q: 2 }], same: { list: [{ r: 2 }], more: { s: 3 } } },
+    replaced: [{ here: [2] }],
+    replacedList: { here: { t: 2 } },
+  });
+  const base = makeBase();
+  const over = makeOver();
+  const result = layer(base, over);
+
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+  assert.deepEqual(result, {
+    kept: { list: [{ x: 1 }, [2, { y: 3 }]], inner: { z: 4 } },
+    keptList: [[{ deep: [1] }]],
+    both: {
+      fromBase: { p: [1] },
+      swapped: [{ q: 2 }],
+      same: { list: [{ r: 2 }], more: { s: 3 } },
+      fromOver: { p: [2] },
+    },
+    replaced: [{ here: [2] }],
+    replacedList: { here: { t: 2 } },
+    added: { list: [{ x: 5 }, [6, { y: 7 }]], inner: { z: 8 } },
+    addedList: [[{ deep: [2] }]],
+  });
+
+  const fromLayers = new Set([...reachable(base), ...reachable(over)]);
+  const fromResult = reachable(result);
+  assert.ok(fromResult.size > 30);
+  for (const part of fromResult) assert.ok(!fromLayers.has(part), "the result shares an object with a layer");
+
+  // Changing every object and array of the result leaves both layers as they were.
+  for (const part of fromResult) {
+    if (Array.isArray(part)) part.push("changed");
+    else part.changed = true;
+  }
+  assert.deepEqual(base, makeBase());
+  assert.deepEqual(over, makeOver());
+});
+
+test("layer accepts frozen layers", () => {
+  const freeze = (value) => {
+    for (const part of reachable(value)) Object.freeze(part);
+    return value;
+  };
+  const base = freeze({ a: { b: [1, { c: 2 }] }, d: 1 });
+  const over = freeze({ a: { e: [3] }, d: { f: 4 } });
+  assert.deepEqual(layer(base, over), { a: { b: [1, { c: 2 }], e: [3] }, d: { f: 4 } });
+});
+
+test("layer copies a Date instead of sharing it", () => {
+  const base = { at: new Date(1), since: new Date(2) };
+  const over = { at: new Date(3), list: [new Date(4)] };
+  const result = layer(base, over);
+  assert.deepEqual(result, { at: new Date(3), since: new Date(2), list: [new Date(4)] });
+  assert.notEqual(result.at, over.at);
+  assert.notEqual(result.since, base.since);
+  assert.notEqual(result.list[0], over.list[0]);
+});
+
+test("layer refuses a setting it cannot copy", () => {
+  assert.throws(() => layer({ a: new Map() }, {}), TypeError);
+  assert.throws(() => layer({}, { a: { b: [() => {}] } }), TypeError);
+});
+
+test("layer never copies __proto__, constructor or prototype keys", () => {
+  // JSON.parse makes these own keys, as a settings file read from disk would.
+  const unsafe = '"__proto__": {"polluted": true}, "constructor": {"prototype": {"polluted": true}}, "prototype": {"polluted": true}';
+  const nested = `{${unsafe}, "keep": 1, "inner": {${unsafe}, "keep": 2}, "list": [{${unsafe}, "keep": 3}, [{${unsafe}, "keep": 4}]]}`;
+  const base = JSON.parse(`{${unsafe}, "onlyBase": ${nested}, "both": ${nested}, "swapped": 1}`);
+  const over = JSON.parse(`{${unsafe}, "onlyOver": ${nested}, "both": ${nested}, "swapped": ${nested}}`);
+  assert.ok(Object.hasOwn(base, "__proto__") && Object.hasOwn(over.both.list[1][0], "__proto__"));
+
+  const result = layer(base, over);
+  const clean = { keep: 1, inner: { keep: 2 }, list: [{ keep: 3 }, [{ keep: 4 }]] };
+  assert.deepEqual(result, { onlyBase: clean, both: clean, swapped: clean, onlyOver: clean });
+
+  const parts = reachable(result);
+  assert.equal(parts.size, 4 * 6 + 1);
+  for (const part of parts) {
+    for (const key of ["__proto__", "constructor", "prototype"]) assert.ok(!Object.hasOwn(part, key), key);
+    assert.equal(Object.getPrototypeOf(part), Array.isArray(part) ? Array.prototype : Object.prototype);
+    assert.equal(part.polluted, undefined);
+  }
+  assert.equal({}.polluted, undefined);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test("layer turns objects without a prototype into ordinary objects", () => {
+  const bare = (entries) => Object.assign(Object.create(null), entries);
+  const result = layer(bare({ a: bare({ b: 1 }), list: [bare({ c: 2 })] }), bare({ a: bare({ d: 3 }), e: bare({ f: 4 }) }));
+  assert.deepEqual(result, { a: { b: 1, d: 3 }, list: [{ c: 2 }], e: { f: 4 } });
+  for (const part of reachable(result)) {
+    if (!Array.isArray(part)) assert.equal(Object.getPrototypeOf(part), Object.prototype);
+  }
+});
+
+test("layer does not take an inherited name for a key of base", () => {
+  assert.deepEqual(layer({}, { toString: { a: 1 }, valueOf: 2 }), { toString: { a: 1 }, valueOf: 2 });
+});
