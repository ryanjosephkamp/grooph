+# Review: `layer(base, over)`
+
+Each item of `docs/REVIEW-CHECKLIST.md`, with the lines that satisfy it.
+
+1. **Met.** `src/layer.mjs:47` exports `layer`.
+2. **Met.** `src/layer.mjs:19-36` (`merge`). Tests in `tests/layer.test.mjs`:
+   the checklist example at 15; keys only one layer has at 19; any depth at 26;
+   an array, a number, a string, a boolean and `null` replacing whatever `base`
+   holds at 34-50 (one test per kind); an array replaced whole at 64.
+3. **Met.** `src/layer.mjs:48-49`, using `isPlainObject` at 4-8. Tests at
+   `tests/layer.test.mjs:71-86` (an array, `null`, a string, a number, a `Date`
+   and `undefined`, each as `base` and as `over`) and 88 (an argument left out).
+4. **Met.** `merge` builds a new object (`src/layer.mjs:20`) and every value
+   goes into it through `copy` (11-17) or a nested `merge`; nothing is written
+   to an argument. Test at `tests/layer.test.mjs:100`.
+5. **Met.** The three keys are skipped at `src/layer.mjs:23` and 33; objects
+   inside arrays go through the same `merge` (13-14); every object of the
+   result is made by `{}` at 20. Tests at `tests/layer.test.mjs:175` and 198.
+6. **Met.** `CHANGELOG.md:5`.
+7. **Met.** `npm test`: 36 tests, 36 pass, 0 skipped, 0 todo.
+8. **Met.** Changed: `src/layer.mjs`, `tests/layer.test.mjs`, `CHANGELOG.md`,
+   and this file.
+
+## Decisions the task and checklist leave open
+
+- An object with no prototype (`Object.create(null)`) counts as a plain
+  object; it comes out as an ordinary one.
+- A `Date` inside a layer is copied. Any other object that is not plain data (a
+  `Map`, a class instance, a function) throws a `TypeError`, because item 4
+  rules out sharing it and it cannot be copied faithfully.
+- A key that `over` holds as `undefined` replaces the value in `base`.
+- Only a layer's own enumerable string keys are read; symbol keys are dropped.
+- A layer that contains itself is not detected: it overflows the stack.
+- `README.md` does not mention `layer`, because item 8 keeps it unchanged.
diff --git a/settingskit/src/layer.mjs b/settingskit/src/layer.mjs
new file mode 100644
index 0000000..5d9ac2c
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,51 @@
+// Never copied: assigning any of these can reach a prototype.
+const UNSAFE_KEYS = new Set(["__proto__", "constructor", "prototype"]);
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object") return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+// A copy of `value` that shares no object or array with it.
+function copy(value) {
+  if (value === null || (typeof value !== "object" && typeof value !== "function")) return value;
+  if (Array.isArray(value)) return Array.from(value, (item) => copy(item));
+  if (isPlainObject(value)) return merge({}, value);
+  if (Object.getPrototypeOf(value) === Date.prototype) return new Date(value.getTime());
+  throw new TypeError("layer: a setting must be plain data (a plain object, an array, a Date or a primitive)");
+}
+
+function merge(base, over) {
+  const result = {};
+  const overKeys = new Set(Object.keys(over));
+  for (const key of Object.keys(base)) {
+    if (UNSAFE_KEYS.has(key)) continue;
+    if (!overKeys.has(key)) {
+      result[key] = copy(base[key]);
+      continue;
+    }
+    const below = base[key];
+    const above = over[key];
+    result[key] = isPlainObject(below) && isPlainObject(above) ? merge(below, above) : copy(above);
+  }
+  for (const key of overKeys) {
+    if (!UNSAFE_KEYS.has(key) && !Object.hasOwn(result, key)) result[key] = copy(over[key]);
+  }
+  return result;
+}
+
+/**
+ * Lays the settings in `over` on top of those in `base` and returns the result;
+ * neither argument is changed, and the result shares nothing with them.
+ * Plain objects under the same key are layered key by key, at any depth.
+ * Anything else in `over` (an array too) replaces what `base` holds.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over);
+}
