+const PAGE = /^\d+$/;
+
+/**
+ * The pages to print, from what a person typed into the page box.
+ * Each page is listed once, in ascending order.
+ * @param {string} text parts separated by commas, each one page ("7") or a range ("1-3")
+ * @param {number} pageCount how many pages the document has; pages are numbered from 1
+ */
+export function parseRanges(text, pageCount) {
+  if (typeof text !== "string") throw new TypeError("parseRanges: text must be a string");
+  if (!Number.isInteger(pageCount) || pageCount < 1) {
+    throw new TypeError("parseRanges: pageCount must be a positive integer");
+  }
+
+  const page = (digits, part) => {
+    if (!PAGE.test(digits)) {
+      throw new RangeError(`parseRanges: "${part}" is neither a page nor a range`);
+    }
+    const number = Number(digits);
+    if (number < 1 || number > pageCount) {
+      throw new RangeError(`parseRanges: page ${digits} is not in 1-${pageCount}`);
+    }
+    return number;
+  };
+
+  const pages = new Set();
+  for (const raw of text.split(",")) {
+    const part = raw.trim();
+    const ends = part.split("-").map((end) => end.trim());
+    if (ends.length > 2) {
+      throw new RangeError(`parseRanges: "${part}" is neither a page nor a range`);
+    }
+    const first = page(ends[0], part);
+    const last = ends.length === 2 ? page(ends[1], part) : first;
+    if (first > last) {
+      throw new RangeError(`parseRanges: range "${part}" runs backwards`);
+    }
+    for (let number = first; number <= last; number++) pages.add(number);
+  }
+  return [...pages].sort((a, b) => a - b);
+}
