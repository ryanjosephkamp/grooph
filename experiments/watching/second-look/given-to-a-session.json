      "launcher": "#!/bin/sh\n# Written by scripts/lib/watching-second-look-paid.mjs for one run of the `outside` arm (experiments/watching/second-look/README.md).\nsession=\nfor arg in \"$@\"; do\n  if [ \"$arg\" = \"--session-id\" ]; then session=1; fi\ndone\nif [ -z \"$session\" ]; then\n  echo \"this is the launcher of one run of the second look's outside arm: it starts that session and answers nothing else\" >&2\n  exit 64\nfi\n(\n  mkdir -p '/the/profiles/home/home/tool-home' &&\n  cd '/the/profiles/home/home' &&\n  HOME='/the/profiles/home/home/tool-home' GROOPH_HOME='/the/profiles/home/home/.grooph' CLAUDE_CONFIG_DIR='/the/profiles/home/profile' CODEX_HOME='/the/profiles/home/home/.codex-is-not-used' '/the/node' '/the/tool' hooks install --user --harness claude-code &&\n  HOME='/the/profiles/home/home/tool-home' GROOPH_HOME='/the/profiles/home/home/.grooph' CLAUDE_CONFIG_DIR='/the/profiles/home/profile' CODEX_HOME='/the/profiles/home/home/.codex-is-not-used' '/the/node' '/the/tool' hooks watch '/the/profiles/home/work/a-session/packages' &&\n  if [ -n \"$(ls -A '/the/profiles/home/home/tool-home')\" ]; then echo \"the tool wrote under its own home folder: it did not keep to the places it was told of\"; exit 1; fi &&\n  if [ ! -f '/the/profiles/home/home/.grooph/hooks/grooph-event.mjs' ]; then echo \"no hook was left in grooph's own folder for the run\"; exit 1; fi &&\n  if ! grep -q 'grooph-event\\.mjs.* claude-code --user' '/the/profiles/home/profile/settings.json'; then echo \"the profile's settings hold no entry that runs the recorder\"; exit 1; fi &&\n  if [ ! -x '/the/harness' ]; then echo \"the harness is not there to be started\"; exit 1; fi\n) >'/the/profiles/home/home/outside-install.txt' 2>&1 || exit 70\ncp '/the/profiles/home/profile/settings.json' '/the/profiles/home/home/settings-with-the-recorder.json' || exit 70\n: >'/the/profiles/home/home/the-launcher-started-the-harness' || exit 70\n# The harness is started with the environment this was given, to the letter: what a shell adds of its own is taken off.\nexec /usr/bin/env -u PWD -u OLDPWD -u SHLVL -u _ '/the/harness' \"$@\"\n"
    }
