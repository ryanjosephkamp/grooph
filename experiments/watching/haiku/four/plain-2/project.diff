+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,94 @@
+/**
+ * Layers `over` on top of `base`, merging plain objects recursively.
+ * Non-object values in `over` replace those in `base`.
+ * Protects against prototype pollution by never copying __proto__, constructor, or prototype keys.
+ * Does not modify either argument and shares no objects with them.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base) || !isPlainObject(over)) {
+    throw new TypeError("layer: both arguments must be plain objects");
+  }
+
+  return mergeObjects(base, over);
+}
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    return false;
+  }
+  // Check if it's a plain object (not a Date, RegExp, or other built-in)
+  const proto = Object.getPrototypeOf(value);
+  return proto === null || proto === Object.prototype;
+}
+
+function mergeObjects(base, over) {
+  // Start with a copy of base
+  const result = {};
+
+  // Copy properties from base, doing deep copy for nested objects
+  for (const key of Object.keys(base)) {
+    if (isProtectionKey(key)) continue;
+    const value = base[key];
+    if (isObjectLike(value) && !Array.isArray(value)) {
+      result[key] = mergeObjects(value, {});
+    } else if (Array.isArray(value)) {
+      result[key] = copyArray(value);
+    } else {
+      result[key] = value;
+    }
+  }
+
+  // Layer over on top
+  for (const key of Object.keys(over)) {
+    if (isProtectionKey(key)) continue;
+    const baseValue = base[key];
+    const overValue = over[key];
+
+    const baseIsObject = isObjectLike(baseValue) && !Array.isArray(baseValue);
+    const overIsObject = isObjectLike(overValue) && !Array.isArray(overValue);
+
+    // If both are object-like, merge them recursively
+    if (baseIsObject && overIsObject) {
+      result[key] = mergeObjects(baseValue, overValue);
+    } else {
+      // Otherwise, copy the over value (replacing base)
+      if (overIsObject) {
+        result[key] = mergeObjects({}, overValue);
+      } else if (Array.isArray(overValue)) {
+        result[key] = copyArray(overValue);
+      } else {
+        result[key] = overValue;
+      }
+    }
+  }
+
+  // Ensure result has correct prototype (not inherited from inputs)
+  Object.setPrototypeOf(result, Object.prototype);
+  return result;
+}
+
+function isObjectLike(value) {
+  return value !== null && typeof value === "object";
+}
+
+function copyArray(arr) {
+  const result = arr.map((item) => {
+    if (isPlainObject(item)) {
+      return mergeObjects({}, item);
+    } else if (Array.isArray(item)) {
+      return copyArray(item);
+    } else {
+      return item;
+    }
+  });
+  // Ensure array has correct prototype
+  Object.setPrototypeOf(result, Array.prototype);
+  return result;
+}
+
+function isProtectionKey(key) {
+  return key === "__proto__" || key === "constructor" || key === "prototype";
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
new file mode 100644
index 0000000..3eff114
--- /dev/null
+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,108 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("lays one layer on another: plain objects under the same key are layered at any depth", () => {
+  const base = { a: 1, b: { c: 2, d: 3 } };
+  const over = { b: { c: 9 }, e: 5 };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("a non-object value in over replaces the one in base, and an array is replaced whole", () => {
+  const base = { a: [1, 2, 3], b: { x: 1 }, c: 5 };
+  const over = { a: [4, 5], b: 99, c: { d: 1 } };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: [4, 5], b: 99, c: { d: 1 } });
+});
+
+test("a key only one of them has is kept", () => {
+  const base = { a: 1, b: 2 };
+  const over = { c: 3, d: 4 };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: 1, b: 2, c: 3, d: 4 });
+});
+
+test("neither argument is changed and the result shares nothing with them", () => {
+  const base = { a: { b: { c: 1 } }, arr: [{ x: 1 }] };
+  const over = { a: { b: { d: 2 } }, arr: [{ y: 2 }] };
+  const result = layer(base, over);
+
+  // Modify the result
+  result.a.b.c = 999;
+  result.arr[0].x = 999;
+
+  // Original base should be unchanged
+  assert.equal(base.a.b.c, 1);
+  assert.equal(base.arr[0].x, 1);
+
+  // Original over should be unchanged
+  assert.equal(over.arr[0].y, 2);
+});
+
+test("throws TypeError when first argument is not a plain object", () => {
+  const over = { a: 1 };
+  assert.throws(() => layer(null, over), TypeError);
+  assert.throws(() => layer(undefined, over), TypeError);
+  assert.throws(() => layer([1, 2, 3], over), TypeError);
+  assert.throws(() => layer("string", over), TypeError);
+  assert.throws(() => layer(123, over), TypeError);
+  assert.throws(() => layer(new Date(), over), TypeError);
+});
+
+test("throws TypeError when second argument is not a plain object", () => {
+  const base = { a: 1 };
+  assert.throws(() => layer(base, null), TypeError);
+  assert.throws(() => layer(base, undefined), TypeError);
+  assert.throws(() => layer(base, [1, 2, 3]), TypeError);
+  assert.throws(() => layer(base, "string"), TypeError);
+  assert.throws(() => layer(base, 123), TypeError);
+  assert.throws(() => layer(base, new Date()), TypeError);
+});
+
+test("keys named __proto__, constructor or prototype are never copied from either argument, at any depth", () => {
+  const base = { a: { __proto__: { evil: 1 }, constructor: { evil: 2 }, prototype: { evil: 3 } } };
+  const over = { a: { __proto__: { bad: 1 }, constructor: { bad: 2 }, prototype: { bad: 3 } } };
+  const result = layer(base, over);
+
+  // These keys should not exist as own properties in the result
+  assert.equal(Object.prototype.hasOwnProperty.call(result.a, "__proto__"), false);
+  assert.equal(Object.prototype.hasOwnProperty.call(result.a, "constructor"), false);
+  assert.equal(Object.prototype.hasOwnProperty.call(result.a, "prototype"), false);
+
+  // The prototype chain should not have been polluted
+  assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+});
+
+test("every plain object in the result is an ordinary object with prototype Object.prototype", () => {
+  const base = { a: { b: 1 } };
+  const over = { c: { d: 2 } };
+  const result = layer(base, over);
+
+  // Check all nested objects have the correct prototype
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+  assert.equal(Object.getPrototypeOf(result.c), Object.prototype);
+});
+
+test("handles nested arrays with objects inside", () => {
+  const base = { arr: [{ x: 1 }, { y: 2 }] };
+  const over = { arr: [{ x: 99 }] };
+  const result = layer(base, over);
+
+  // Arrays are replaced whole, not merged
+  assert.deepEqual(result.arr, [{ x: 99 }]);
+
+  // Modify result array to ensure it's not the same object
+  result.arr[0].x = 1000;
+  assert.equal(base.arr[0].x, 1);
+});
+
+test("deep nesting is handled correctly", () => {
+  const base = { a: { b: { c: { d: { e: 1 } } } } };
+  const over = { a: { b: { c: { d: { f: 2 } } } } };
+  const result = layer(base, over);
+
+  assert.deepEqual(result, { a: { b: { c: { d: { e: 1, f: 2 } } } } });
+});
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
