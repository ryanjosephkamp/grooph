index 0000000..8fa4538
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,36 @@
+/**
+ * Wraps text to a given width, breaking on word boundaries.
+ *
+ * @param {string} text
+ * @param {number} width
+ * @returns {string}
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || width < 1 || !Number.isInteger(width)) {
+    throw new TypeError("wrap: width must be a positive integer");
+  }
+
+  const lines = [];
+  let currentLine = "";
+
+  const words = text.split(/\s+/);
+  for (const word of words) {
+    if (word === "") continue;
+
+    if (currentLine === "") {
+      currentLine = word;
+    } else if ((currentLine + " " + word).length <= width) {
+      currentLine += " " + word;
+    } else {
+      lines.push(currentLine);
+      currentLine = word;
+    }
+  }
+
+  if (currentLine !== "") {
+    lines.push(currentLine);
+  }
+
+  return lines.join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..0f2a90e
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap wraps text to a given width", () => {
+  const text = "The quick brown fox jumps over the lazy dog";
+  const result = wrap(text, 20);
+  const lines = result.split("\n");
+  assert.ok(lines.every((line) => line.length <= 20));
+  assert.equal(lines.length, 3);
+});
+
+test("wrap respects word boundaries", () => {
+  const text = "one two three four five";
+  const result = wrap(text, 10);
+  const lines = result.split("\n");
+  // Expected: "one two" (8 chars), "three four" (10 chars), "five" (4 chars)
+  assert.deepEqual(lines, ["one two", "three four", "five"]);
+});
+
+test("wrap handles multiple spaces", () => {
+  const text = "one   two   three";
+  const result = wrap(text, 15);
+  const lines = result.split("\n");
+  assert.deepEqual(lines, ["one two three"]);
+});
+
+test("wrap handles leading and trailing whitespace", () => {
+  const text = "  one two three  ";
+  const result = wrap(text, 15);
+  const lines = result.split("\n");
+  assert.deepEqual(lines, ["one two three"]);
+});
+
+test("wrap single word longer than width fits on its line", () => {
+  const text = "verylongword";
+  const result = wrap(text, 8);
+  assert.equal(result, "verylongword");
+});
+
+test("wrap empty string returns empty string", () => {
+  const result = wrap("", 10);
+  assert.equal(result, "");
+});
+
+test("wrap only whitespace returns empty string", () => {
+  const result = wrap("   \t\n  ", 10);
+  assert.equal(result, "");
+});
+
+test("wrap requires string input", () => {
+  assert.throws(() => wrap(123, 10), TypeError);
+  assert.throws(() => wrap(null, 10), TypeError);
+  assert.throws(() => wrap(undefined, 10), TypeError);
+});
+
+test("wrap requires positive integer width", () => {
+  assert.throws(() => wrap("text", 0), TypeError);
+  assert.throws(() => wrap("text", -5), TypeError);
+  assert.throws(() => wrap("text", 3.5), TypeError);
+  assert.throws(() => wrap("text", "10"), TypeError);
+  assert.throws(() => wrap("text", null), TypeError);
+});
