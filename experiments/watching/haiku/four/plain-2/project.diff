 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: a must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: b must be a string");
+
+  const parsed_a = parseSemver(a);
+  const parsed_b = parseSemver(b);
+
+  // Compare major.minor.patch
+  if (parsed_a.major !== parsed_b.major) {
+    return parsed_a.major < parsed_b.major ? -1 : 1;
+  }
+  if (parsed_a.minor !== parsed_b.minor) {
+    return parsed_a.minor < parsed_b.minor ? -1 : 1;
+  }
+  if (parsed_a.patch !== parsed_b.patch) {
+    return parsed_a.patch < parsed_b.patch ? -1 : 1;
+  }
+
+  // Compare pre-release: absence of pre-release gives higher precedence
+  if ((parsed_a.prerelease === null) !== (parsed_b.prerelease === null)) {
+    return parsed_a.prerelease === null ? 1 : -1;
+  }
+
+  // Both have pre-release versions
+  if (parsed_a.prerelease !== null) {
+    const cmp = comparePrerelease(parsed_a.prerelease, parsed_b.prerelease);
+    if (cmp !== 0) return cmp;
+  }
+
+  return 0;
+}
+
+function parseSemver(version) {
+  // Check for build metadata format
+  const buildIdx = version.indexOf("+");
+  const afterBuild = buildIdx >= 0 ? version.slice(buildIdx + 1) : null;
+
+  // If there's a +, there must be something after it
+  if (buildIdx >= 0 && !afterBuild) {
+    throw new RangeError(`Invalid semantic version: ${version}`);
+  }
+
+  // Remove build metadata
+  const withoutBuild = buildIdx >= 0 ? version.slice(0, buildIdx) : version;
+
+  // Parse major.minor.patch-prerelease
+  const match = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?$/.exec(withoutBuild);
+
+  if (!match) {
+    throw new RangeError(`Invalid semantic version: ${version}`);
+  }
+
+  const major = parseInt(match[1], 10);
+  const minor = parseInt(match[2], 10);
+  const patch = parseInt(match[3], 10);
+  const prerelease = match[4] ? match[4].split(".") : null;
+
+  return { major, minor, patch, prerelease };
+}
+
+function comparePrerelease(pre_a, pre_b) {
+  // Shorter prerelease has lower precedence
+  const minLen = Math.min(pre_a.length, pre_b.length);
+  for (let i = 0; i < minLen; i++) {
+    const cmp = compareIdentifier(pre_a[i], pre_b[i]);
+    if (cmp !== 0) return cmp;
+  }
+
+  // If all compared identifiers are equal, longer has higher precedence
+  if (pre_a.length !== pre_b.length) {
+    return pre_a.length < pre_b.length ? -1 : 1;
+  }
+
+  return 0;
+}
+
+function compareIdentifier(a, b) {
+  const aIsNum = /^\d+$/.test(a);
+  const bIsNum = /^\d+$/.test(b);
+
+  if (aIsNum && bIsNum) {
+    // Both numeric: compare as integers
+    const aInt = parseInt(a, 10);
+    const bInt = parseInt(b, 10);
+    return aInt < bInt ? -1 : aInt > bInt ? 1 : 0;
+  }
+
+  if (aIsNum) {
+    // Numeric identifiers have lower precedence than alphanumeric
+    return -1;
+  }
+  if (bIsNum) {
+    return 1;
+  }
+
+  // Both alphanumeric: compare lexically
+  return a < b ? -1 : a > b ? 1 : 0;
 }
