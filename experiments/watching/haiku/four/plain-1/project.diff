--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,51 @@
+function isPlainObject(value) {
+  return Object.prototype.toString.call(value) === "[object Object]" && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function deepCopy(obj) {
+  if (Array.isArray(obj)) {
+    return obj.map(item => deepCopy(item));
+  }
+  if (isPlainObject(obj)) {
+    const copy = {};
+    for (const key of Object.keys(obj)) {
+      if (key !== "__proto__" && key !== "constructor" && key !== "prototype") {
+        copy[key] = deepCopy(obj[key]);
+      }
+    }
+    return copy;
+  }
+  return obj;
+}
+
+export function layer(base, over) {
+  if (!isPlainObject(base)) {
+    throw new TypeError("layer: base must be a plain object");
+  }
+  if (!isPlainObject(over)) {
+    throw new TypeError("layer: over must be a plain object");
+  }
+
+  const result = {};
+
+  for (const key of Object.keys(base)) {
+    if (key !== "__proto__" && key !== "constructor" && key !== "prototype") {
+      result[key] = deepCopy(base[key]);
+    }
+  }
+
+  for (const key of Object.keys(over)) {
+    if (key !== "__proto__" && key !== "constructor" && key !== "prototype") {
+      const baseValue = result[key];
+      const overValue = over[key];
+
+      if (isPlainObject(baseValue) && isPlainObject(overValue)) {
+        result[key] = layer(baseValue, overValue);
+      } else {
+        result[key] = deepCopy(overValue);
+      }
+    }
+  }
+
+  return result;
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
new file mode 100644
