index 0000000..e2a5751
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,57 @@
+/**
+ * Wraps text to fit within a given width, breaking at word boundaries.
+ * @param {string} text
+ * @param {number} width
+ * @returns {string}
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || width < 1) throw new TypeError("wrap: width must be a positive number");
+
+  const lines = [];
+  const paragraphs = text.split("\n");
+
+  for (const paragraph of paragraphs) {
+    const wrapped = wrapParagraph(paragraph, width);
+    lines.push(...wrapped);
+  }
+
+  return lines.join("\n");
+}
+
+function wrapParagraph(text, width) {
+  if (text.length === 0) return [""];
+
+  const lines = [];
+  let currentLine = "";
+
+  const words = text.split(/\s+/);
+
+  for (const word of words) {
+    if (word.length === 0) continue;
+
+    if (currentLine.length === 0) {
+      if (word.length <= width) {
+        currentLine = word;
+      } else {
+        lines.push(word);
+      }
+    } else if (currentLine.length + 1 + word.length <= width) {
+      currentLine += " " + word;
+    } else {
+      lines.push(currentLine);
+      if (word.length <= width) {
+        currentLine = word;
+      } else {
+        lines.push(word);
+        currentLine = "";
+      }
+    }
+  }
+
+  if (currentLine.length > 0) {
+    lines.push(currentLine);
+  }
+
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..c75f744
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap breaks text at word boundaries", () => {
+  const result = wrap("hello world foo bar", 10);
+  assert.equal(result, "hello\nworld foo\nbar");
+});
+
+test("wrap with single word fits on one line", () => {
+  const result = wrap("hello", 10);
+  assert.equal(result, "hello");
+});
+
+test("wrap with multiple spaces collapses them", () => {
+  const result = wrap("hello   world", 10);
+  assert.equal(result, "hello\nworld");
+});
+
+test("wrap respects explicit newlines", () => {
+  const result = wrap("hello world\nfoo bar", 10);
+  assert.equal(result, "hello\nworld\nfoo bar");
+});
+
+test("wrap with width 1", () => {
+  const result = wrap("hello world", 1);
+  assert.equal(result, "hello\nworld");
+});
+
+test("wrap handles empty string", () => {
+  const result = wrap("", 10);
+  assert.equal(result, "");
+});
+
+test("wrap throws TypeError for non-string text", () => {
+  assert.throws(() => wrap(123, 10), TypeError);
+  assert.throws(() => wrap(null, 10), TypeError);
+});
+
+test("wrap throws TypeError for non-number width", () => {
+  assert.throws(() => wrap("hello", "10"), TypeError);
+  assert.throws(() => wrap("hello", 0), TypeError);
+});
+
+test("wrap allows words longer than width", () => {
+  const result = wrap("supercalifragilisticexpialidocious world", 10);
+  assert.equal(result, "supercalifragilisticexpialidocious\nworld");
+});
+
+test("wrap handles tabs as whitespace", () => {
+  const result = wrap("hello\tworld\tfoo", 10);
+  assert.equal(result, "hello\nworld foo");
+});
