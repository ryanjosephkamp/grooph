--- /dev/null
+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,137 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("layer lays one object on top of another", () => {
+  const result = layer(
+    { a: 1, b: { c: 2, d: 3 } },
+    { b: { c: 9 }, e: 5 }
+  );
+  assert.deepEqual(result, { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("plain objects at the same key are layered at any depth", () => {
+  const result = layer(
+    { x: { y: { z: 1, w: 2 } } },
+    { x: { y: { z: 99 } } }
+  );
+  assert.deepEqual(result, { x: { y: { z: 99, w: 2 } } });
+});
+
+test("an array from over replaces the one from base, not joined", () => {
+  const result = layer(
+    { items: [1, 2, 3] },
+    { items: [4] }
+  );
+  assert.deepEqual(result, { items: [4] });
+});
+
+test("a number, string, boolean, or null from over replaces base value", () => {
+  const result = layer(
+    { a: 1, b: "x", c: true, d: {} },
+    { a: 999, b: "y", c: false, d: null }
+  );
+  assert.deepEqual(result, { a: 999, b: "y", c: false, d: null });
+});
+
+test("a key only in base is kept", () => {
+  const result = layer(
+    { a: 1, b: 2 },
+    { b: 99 }
+  );
+  assert.deepEqual(result, { a: 1, b: 99 });
+});
+
+test("a key only in over is kept", () => {
+  const result = layer(
+    { a: 1 },
+    { b: 2 }
+  );
+  assert.deepEqual(result, { a: 1, b: 2 });
+});
+
+test("throws TypeError if base is not a plain object", () => {
+  assert.throws(() => layer([], {}), TypeError);
+  assert.throws(() => layer(null, {}), TypeError);
+  assert.throws(() => layer("string", {}), TypeError);
+  assert.throws(() => layer(123, {}), TypeError);
+  assert.throws(() => layer(new Date(), {}), TypeError);
+  assert.throws(() => layer(undefined, {}), TypeError);
+});
+
+test("throws TypeError if over is not a plain object", () => {
+  assert.throws(() => layer({}, []), TypeError);
+  assert.throws(() => layer({}, null), TypeError);
+  assert.throws(() => layer({}, "string"), TypeError);
+  assert.throws(() => layer({}, 123), TypeError);
+  assert.throws(() => layer({}, new Date()), TypeError);
+  assert.throws(() => layer({}, undefined), TypeError);
+});
+
+test("neither argument is changed", () => {
+  const base = { a: 1, b: { c: 2 } };
+  const over = { b: { d: 3 } };
+  const baseCopy = JSON.parse(JSON.stringify(base));
+  const overCopy = JSON.parse(JSON.stringify(over));
+
+  layer(base, over);
+
+  assert.deepEqual(base, baseCopy);
+  assert.deepEqual(over, overCopy);
+});
+
+test("the result shares nothing with base or over", () => {
+  const base = { a: [1, 2], b: { c: { deep: "value" } } };
+  const over = { d: [4, 5], b: { c: { other: "data" } } };
+
+  const result = layer(base, over);
+
+  assert.notStrictEqual(result, base);
+  assert.notStrictEqual(result, over);
+  assert.notStrictEqual(result.a, base.a);
+  assert.notStrictEqual(result.b, base.b);
+  assert.notStrictEqual(result.b, over.b);
+  assert.notStrictEqual(result.b.c, base.b.c);
+  assert.notStrictEqual(result.b.c, over.b.c);
+  assert.notStrictEqual(result.d, over.d);
+});
+
+test("skips __proto__, constructor, and prototype keys", () => {
+  const base = { regular: 1 };
+  const over = { regular: 2 };
+
+  Object.defineProperty(over, "__proto__", { value: { injected: true }, enumerable: true });
+  Object.defineProperty(over, "constructor", { value: "bad", enumerable: true });
+  Object.defineProperty(over, "prototype", { value: "evil", enumerable: true });
+
+  const result = layer(base, over);
+
+  assert.deepEqual(result, { regular: 2 });
+  assert.equal(result.injected, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("skips dangerous keys at any depth", () => {
+  const base = { nested: { a: 1 } };
+  const over = { nested: { a: 2 } };
+
+  Object.defineProperty(over.nested, "__proto__", { value: { deep: true }, enumerable: true });
+
+  const result = layer(base, over);
+
+  assert.deepEqual(result, { nested: { a: 2 } });
+  assert.equal(result.nested.deep, undefined);
+});
+
+test("skips dangerous keys inside arrays", () => {
+  const base = {};
+  const obj = { good: 1 };
+  Object.defineProperty(obj, "__proto__", { value: { bad: true }, enumerable: true });
+  const over = { arr: [obj] };
+
+  const result = layer(base, over);
+
+  assert.deepEqual(result.arr, [{ good: 1 }]);
+  assert.equal(result.arr[0].bad, undefined);
+});
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
