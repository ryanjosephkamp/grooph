  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: first argument must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: second argument must be a string");
+
+  const versionA = parseVersion(a);
+  const versionB = parseVersion(b);
+
+  let cmp = compareNumbers(versionA.major, versionB.major);
+  if (cmp !== 0) return cmp;
+
+  cmp = compareNumbers(versionA.minor, versionB.minor);
+  if (cmp !== 0) return cmp;
+
+  cmp = compareNumbers(versionA.patch, versionB.patch);
+  if (cmp !== 0) return cmp;
+
+  return comparePrerelease(versionA.prerelease, versionB.prerelease);
+}
+
+function parseVersion(versionStr) {
+  const match = versionStr.match(/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*)?$/);
+
+  if (!match) {
+    throw new RangeError(`Invalid semantic version: ${versionStr}`);
+  }
+
+  return {
+    major: parseInt(match[1], 10),
+    minor: parseInt(match[2], 10),
+    patch: parseInt(match[3], 10),
+    prerelease: match[4] ? match[4].split(".") : [],
+  };
+}
+
+function compareNumbers(a, b) {
+  if (a < b) return -1;
+  if (a > b) return 1;
+  return 0;
+}
+
+function comparePrerelease(preA, preB) {
+  if (preA.length === 0 && preB.length === 0) {
+    return 0;
+  }
+
+  if (preA.length === 0) {
+    return 1;
+  }
+
+  if (preB.length === 0) {
+    return -1;
+  }
+
+  const minLen = Math.min(preA.length, preB.length);
+  for (let i = 0; i < minLen; i++) {
+    const idA = preA[i];
+    const idB = preB[i];
+
+    const isNumA = /^\d+$/.test(idA);
+    const isNumB = /^\d+$/.test(idB);
+
+    if (isNumA && isNumB) {
+      const cmp = compareNumbers(parseInt(idA, 10), parseInt(idB, 10));
+      if (cmp !== 0) return cmp;
+    } else if (isNumA) {
+      return -1;
+    } else if (isNumB) {
+      return 1;
+    } else {
+      if (idA < idB) return -1;
+      if (idA > idB) return 1;
+    }
+  }
+
+  if (preA.length < preB.length) return -1;
+  if (preA.length > preB.length) return 1;
+  return 0;
 }
