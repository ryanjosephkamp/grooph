  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: a must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: b must be a string");
+
+  const parseVersion = (version) => {
+    const match = version.match(/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*)?$/);
+    if (!match) throw new RangeError(`compare: ${version} is not a valid semantic version`);
+    return {
+      major: parseInt(match[1], 10),
+      minor: parseInt(match[2], 10),
+      patch: parseInt(match[3], 10),
+      prerelease: match[4] ? match[4].split('.') : null
+    };
+  };
+
+  const versionA = parseVersion(a);
+  const versionB = parseVersion(b);
+
+  // Compare major.minor.patch
+  if (versionA.major !== versionB.major) return versionA.major < versionB.major ? -1 : 1;
+  if (versionA.minor !== versionB.minor) return versionA.minor < versionB.minor ? -1 : 1;
+  if (versionA.patch !== versionB.patch) return versionA.patch < versionB.patch ? -1 : 1;
+
+  // Compare prerelease
+  // If neither has prerelease, they're equal
+  if (!versionA.prerelease && !versionB.prerelease) return 0;
+  // If only one has prerelease, the one with prerelease is less
+  if (!versionA.prerelease) return 1;
+  if (!versionB.prerelease) return -1;
+
+  // Both have prerelease, compare identifier by identifier
+  const maxLen = Math.max(versionA.prerelease.length, versionB.prerelease.length);
+  for (let i = 0; i < maxLen; i++) {
+    const idA = versionA.prerelease[i];
+    const idB = versionB.prerelease[i];
+
+    // A larger set of prerelease fields has higher precedence than a smaller set
+    if (idA === undefined) return -1;
+    if (idB === undefined) return 1;
+
+    // Check if both are numeric
+    const isNumericA = /^\d+$/.test(idA);
+    const isNumericB = /^\d+$/.test(idB);
+
+    if (isNumericA && isNumericB) {
+      const numA = parseInt(idA, 10);
+      const numB = parseInt(idB, 10);
+      if (numA !== numB) return numA < numB ? -1 : 1;
+    } else if (isNumericA) {
+      // Numeric identifiers always have lower precedence than non-numeric
+      return -1;
+    } else if (isNumericB) {
+      return 1;
+    } else {
+      // Both are non-numeric, compare lexicographically
+      if (idA !== idB) return idA < idB ? -1 : 1;
+    }
+  }
+
+  return 0;
