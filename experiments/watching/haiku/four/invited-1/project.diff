+  for (const id of identifiers) {
+    if (!id) return false; // Empty identifier (e.g., "a..b")
+
+    // Each identifier is alphanumeric (including hyphens)
+    if (!/^[0-9a-zA-Z-]+$/.test(id)) {
+      return false;
+    }
