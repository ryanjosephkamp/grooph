+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,260 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("layer performs basic layering as specified", () => {
+  const result = layer(
+    { a: 1, b: { c: 2, d: 3 } },
+    { b: { c: 9 }, e: 5 }
+  );
+  assert.deepEqual(result, { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("layer handles plain objects under the same key recursively at any depth", () => {
+  const result = layer(
+    { x: { y: { z: 1, w: 2 }, p: 3 }, q: 4 },
+    { x: { y: { z: 9 } } }
+  );
+  assert.deepEqual(result, { x: { y: { z: 9, w: 2 }, p: 3 }, q: 4 });
+});
+
+test("layer replaces arrays wholesale without joining", () => {
+  const baseArray = [1, 2, 3];
+  const overArray = [4, 5];
+  const result = layer(
+    { data: baseArray },
+    { data: overArray }
+  );
+  assert.deepEqual(result, { data: [4, 5] });
+});
+
+test("layer replaces numbers, strings, booleans, and null from over", () => {
+  const result = layer(
+    { a: "hello", b: 42, c: true, d: null },
+    { a: "world", b: 100, c: false, d: null }
+  );
+  assert.deepEqual(result, { a: "world", b: 100, c: false, d: null });
+});
+
+test("layer throws TypeError if base is not a plain object", () => {
+  assert.throws(() => layer([], {}), TypeError);
+  assert.throws(() => layer(null, {}), TypeError);
+  assert.throws(() => layer("string", {}), TypeError);
+  assert.throws(() => layer(42, {}), TypeError);
+  assert.throws(() => layer(new Date(), {}), TypeError);
+});
+
+test("layer throws TypeError if over is not a plain object", () => {
+  assert.throws(() => layer({}, []), TypeError);
+  assert.throws(() => layer({}, null), TypeError);
+  assert.throws(() => layer({}, "string"), TypeError);
+  assert.throws(() => layer({}, 42), TypeError);
+  assert.throws(() => layer({}, new Date()), TypeError);
+});
+
+test("layer throws TypeError if base argument is missing", () => {
+  assert.throws(() => layer(undefined, {}), TypeError);
+});
+
+test("layer throws TypeError if over argument is missing", () => {
+  assert.throws(() => layer({}), TypeError);
+});
+
+test("layer does not mutate base", () => {
+  const base = { a: 1, b: { c: 2 } };
+  const baseCopy = JSON.parse(JSON.stringify(base));
+  layer(base, { a: 9, b: { c: 99 } });
+  assert.deepEqual(base, baseCopy);
+});
+
+test("layer does not mutate over", () => {
+  const over = { a: 9, b: { c: 99 } };
+  const overCopy = JSON.parse(JSON.stringify(over));
+  layer({ a: 1, b: { c: 2 } }, over);
+  assert.deepEqual(over, overCopy);
+});
+
+test("layer result shares no objects with base", () => {
+  const baseNested = { x: 1 };
+  const base = { a: baseNested };
+  const result = layer(base, {});
+  assert.notStrictEqual(result, base);
+  assert.notStrictEqual(result.a, baseNested);
+});
+
+test("layer result shares no objects with over", () => {
+  const overNested = { x: 1 };
+  const over = { a: overNested };
+  const result = layer({}, over);
+  assert.notStrictEqual(result, over);
+  assert.notStrictEqual(result.a, overNested);
+});
+
+test("layer result shares no arrays with base", () => {
+  const baseArray = [1, 2, 3];
+  const base = { data: baseArray };
+  const result = layer(base, {});
+  assert.notStrictEqual(result.data, baseArray);
+});
+
+test("layer result shares no arrays with over", () => {
+  const overArray = [1, 2, 3];
+  const over = { data: overArray };
+  const result = layer({}, over);
+  assert.notStrictEqual(result.data, overArray);
+});
+
+test("layer never copies __proto__ key from base", () => {
+  const base = Object.create(null);
+  base.normal = "value";
+  base.__proto__ = "evil";
+  const result = layer(base, {});
+  assert.equal(result.__proto__, Object.prototype);
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "__proto__"));
+});
+
+test("layer never copies __proto__ key from over", () => {
+  const over = Object.create(null);
+  over.normal = "value";
+  over.__proto__ = "evil";
+  const result = layer({}, over);
+  assert.equal(result.__proto__, Object.prototype);
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "__proto__"));
+});
+
+test("layer never copies constructor key from base", () => {
+  const base = { constructor: "evil", normal: "value" };
+  const result = layer(base, {});
+  assert.equal(result.constructor, Object);
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "constructor"));
+});
+
+test("layer never copies constructor key from over", () => {
+  const over = { constructor: "evil", normal: "value" };
+  const result = layer({}, over);
+  assert.equal(result.constructor, Object);
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "constructor"));
+});
+
+test("layer never copies prototype key from base", () => {
+  const base = { prototype: "evil", normal: "value" };
+  const result = layer(base, {});
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "prototype"));
+});
+
+test("layer never copies prototype key from over", () => {
+  const over = { prototype: "evil", normal: "value" };
+  const result = layer({}, over);
+  assert.equal(result.normal, "value");
+  assert(!Object.prototype.hasOwnProperty.call(result, "prototype"));
+});
+
+test("layer never copies blocked keys at any depth", () => {
+  const result = layer(
+    { nested: { __proto__: "evil1", constructor: "evil2", prototype: "evil3" } },
+    { nested: { normal: "ok" } }
+  );
+  assert.equal(result.nested.normal, "ok");
+  assert(!Object.prototype.hasOwnProperty.call(result.nested, "__proto__"));
+  assert(!Object.prototype.hasOwnProperty.call(result.nested, "constructor"));
+  assert(!Object.prototype.hasOwnProperty.call(result.nested, "prototype"));
+});
+
+test("layer result objects have Object.prototype as their prototype", () => {
+  const result = layer(
+    { a: { b: 1 } },
+    { c: { d: 2 } }
+  );
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+  assert.equal(Object.getPrototypeOf(result.c), Object.prototype);
+});
+
+test("layer handles deeply nested structures", () => {
+  const result = layer(
+    {
+      level1: {
+        level2: {
+          level3: {
+            level4: {
+              value: "base",
+              keep: "me"
+            }
+          }
+        }
+      }
+    },
+    {
+      level1: {
+        level2: {
+          level3: {
+            level4: {
+              value: "over"
+            }
+          }
+        }
+      }
+    }
+  );
+  assert.deepEqual(result, {
+    level1: {
+      level2: {
+        level3: {
+          level4: {
+            value: "over",
+            keep: "me"
+          }
+        }
+      }
+    }
+  });
+});
+
+test("layer handles arrays inside objects without losing them", () => {
+  const result = layer(
+    { config: { items: [1, 2], name: "base" } },
+    { config: { items: [3, 4, 5] } }
+  );
+  assert.deepEqual(result, {
+    config: {
+      items: [3, 4, 5],
+      name: "base"
+    }
+  });
+});
+
+test("layer handles empty objects", () => {
+  const result = layer({}, {});
+  assert.deepEqual(result, {});
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("layer handles layering empty over onto non-empty base", () => {
+  const base = { a: 1, b: { c: 2 } };
+  const result = layer(base, {});
+  assert.deepEqual(result, base);
+  assert.notStrictEqual(result, base);
+});
+
+test("layer handles layering non-empty over onto empty base", () => {
+  const over = { a: 1, b: { c: 2 } };
+  const result = layer({}, over);
+  assert.deepEqual(result, over);
+  assert.notStrictEqual(result, over);
+});
+
+test("layer blocks keys in arrays inside objects", () => {
+  const result = layer(
+    { items: [{ __proto__: "evil", data: 1 }] },
+    {}
+  );
+  // The array itself is preserved, and its contents are deep copied
+  assert.deepEqual(result.items, [{ data: 1 }]);
+  assert(!Object.prototype.hasOwnProperty.call(result.items[0], "__proto__"));
+});
