+  }
+
+  // Split build metadata
+  let version = str;
+  const plusIdx = version.indexOf('+');
+  if (plusIdx !== -1) {
+    const build = version.substring(plusIdx + 1);
+    version = version.substring(0, plusIdx);
+
+    // Validate build metadata
+    if (!build || !isValidBuildMetadata(build)) {
+      throw new RangeError(`Invalid semantic version: ${str}`);
+    }
+  }
