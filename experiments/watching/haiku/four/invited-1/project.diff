+    // Numeric < non-numeric
+    if (isNumA && !isNumB) return -1;
+    if (!isNumA && isNumB) return 1;
+
+    // Compare
+    if (isNumA && isNumB) {
+      // Both numeric, compare as numbers
+      const numA = parseInt(idA, 10);
+      const numB = parseInt(idB, 10);
+      if (numA !== numB) return numA < numB ? -1 : 1;
+    } else {
