+  const identifiers = str.split('.');
+  if (identifiers.length === 0) return false;
+
+  for (const id of identifiers) {
+    if (!id) return false; // Empty identifier
+
+    // Each identifier is alphanumeric (including hyphens, leading zeros allowed)
+    if (!/^[0-9a-zA-Z-]+$/.test(id)) {
+      return false;
+    }
+  }
