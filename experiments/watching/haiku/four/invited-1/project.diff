index 0000000..b133172
--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,97 @@
+/**
+ * Returns the settings obtained by laying over on top of base.
+ * Both arguments must be plain objects. When both have an object under the same key,
+ * they are layered recursively. Other values in over replace the base values.
+ * Keys named __proto__, constructor, and prototype are never copied.
+ * Neither argument is changed, and the result shares no objects or arrays with them.
+ * @param {object} base - The base settings object
+ * @param {object} over - The settings to layer on top
+ * @returns {object} A new object with over layered on top of base
+ * @throws {TypeError} If either argument is not a plain object
+ */
+export function layer(base, over) {
+  // Helper function to check if a value is a plain object
+  function isPlainObject(value) {
+    if (value === null || typeof value !== "object") return false;
+    if (Array.isArray(value)) return false;
+    if (value instanceof Date) return false;
+    // Check if prototype is Object.prototype
+    const proto = Object.getPrototypeOf(value);
+    return proto === Object.prototype || proto === null;
+  }
+
+  // Validate that both arguments are plain objects
+  if (!isPlainObject(base)) {
+    throw new TypeError("layer: base must be a plain object");
+  }
+  if (!isPlainObject(over)) {
+    throw new TypeError("layer: over must be a plain object");
+  }
+
+  // Helper function to check if a key should be blocked
+  function isBlockedKey(key) {
+    return key === "__proto__" || key === "constructor" || key === "prototype";
+  }
+
+  // Helper function to deep copy a value, ensuring no objects are shared
+  function deepCopy(value) {
+    if (value === null || typeof value !== "object") {
+      return value; // Primitives are fine to return directly
+    }
+
+    if (Array.isArray(value)) {
+      // Deep copy arrays
+      return value.map(item => deepCopy(item));
+    }
+
+    if (value instanceof Date) {
+      return new Date(value);
+    }
+
+    if (isPlainObject(value)) {
+      // Deep copy plain objects, excluding blocked keys
+      const copy = {};
+      for (const key in value) {
+        if (Object.prototype.hasOwnProperty.call(value, key) && !isBlockedKey(key)) {
+          copy[key] = deepCopy(value[key]);
+        }
+      }
+      return copy;
+    }
+
+    // For other objects, return as-is
+    return value;
+  }
+
+  // Helper function to merge two objects
+  function mergeObjects(baseObj, overObj) {
+    const result = {};
+
+    // Copy all keys from base
+    for (const key in baseObj) {
+      if (Object.prototype.hasOwnProperty.call(baseObj, key) && !isBlockedKey(key)) {
+        result[key] = deepCopy(baseObj[key]);
+      }
+    }
+
+    // Overlay all keys from over
+    for (const key in overObj) {
+      if (Object.prototype.hasOwnProperty.call(overObj, key) && !isBlockedKey(key)) {
+        const baseValue = result[key];
+        const overValue = overObj[key];
+
+        // If both are plain objects, layer them recursively
+        if (isPlainObject(baseValue) && isPlainObject(overValue)) {
+          result[key] = mergeObjects(baseValue, overValue);
+        } else {
+          // Otherwise, use the over value
+          result[key] = deepCopy(overValue);
+        }
+      }
+    }
+
+    return result;
+  }
+
+  return mergeObjects(base, over);
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
