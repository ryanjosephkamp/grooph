+
 ```js
 import { countWords } from "./src/count.mjs";
 
 countWords("one two  three"); // 3
 ```
+
+## wrap
+
+Wraps text to a given width, breaking on word boundaries.
+
+```js
+import { wrap } from "./src/wrap.mjs";
+
+wrap("one two three", 10);
+// "one two\nthree"
+
+wrap("hello world foo bar", 12);
+// "hello world\nfoo bar"
+```
