+/**
+ * Wraps text to a given width, breaking on word boundaries.
+ *
+ * @param {string} text - The text to wrap
+ * @param {number} width - The maximum width of each line
+ * @returns {string} - The wrapped text
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || !Number.isInteger(width) || width < 1) throw new TypeError("wrap: width must be a positive integer");
+
+  // Handle empty or whitespace-only text
+  const trimmed = text.trim();
+  if (trimmed === "") return "";
+
+  const words = trimmed.split(/\s+/);
+  const lines = [];
+  let currentLine = "";
+
+  for (const word of words) {
+    // If word is longer than width, we need to add it on its own line
+    if (word.length > width) {
+      // If we have content in current line, save it first
+      if (currentLine) {
+        lines.push(currentLine);
+        currentLine = "";
+      }
+      // Add the long word on its own line
+      lines.push(word);
+    } else if (!currentLine) {
+      // First word on the line
+      currentLine = word;
+    } else if (currentLine.length + 1 + word.length <= width) {
+      // Add word to current line with space
+      currentLine += " " + word;
+    } else {
+      // Word doesn't fit, start new line
+      lines.push(currentLine);
+      currentLine = word;
+    }
+  }
+
+  // Don't forget the last line
+  if (currentLine) {
+    lines.push(currentLine);
+  }
+
+  return lines.join("\n");
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..9f5fa88
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap wraps text to a given width", () => {
+  assert.equal(wrap("one two three", 10), "one two\nthree");
+  assert.equal(wrap("one two three", 8), "one two\nthree");
+  assert.equal(wrap("one two three", 7), "one two\nthree");
+  assert.equal(wrap("one two three", 6), "one\ntwo\nthree");
+});
+
+test("wrap handles single words", () => {
+  assert.equal(wrap("hello", 10), "hello");
+  assert.equal(wrap("hello", 5), "hello");
+});
+
+test("wrap handles words longer than width", () => {
+  assert.equal(wrap("supercalifragilisticexpialidocious", 10), "supercalifragilisticexpialidocious");
+});
+
+test("wrap handles empty string", () => {
+  assert.equal(wrap("", 10), "");
+});
+
+test("wrap handles whitespace-only string", () => {
+  assert.equal(wrap("   ", 10), "");
+});
+
+test("wrap handles multiple spaces between words", () => {
+  assert.equal(wrap("one   two   three", 10), "one two\nthree");
+});
+
+test("wrap handles tabs and newlines", () => {
+  assert.equal(wrap("one\ttwo\nthree", 10), "one two\nthree");
+});
+
+test("wrap throws on invalid text argument", () => {
+  assert.throws(() => wrap(null, 10), TypeError);
+  assert.throws(() => wrap(123, 10), TypeError);
+});
+
+test("wrap throws on invalid width argument", () => {
+  assert.throws(() => wrap("text", "10"), TypeError);
+  assert.throws(() => wrap("text", 0), TypeError);
+  assert.throws(() => wrap("text", -5), TypeError);
+  assert.throws(() => wrap("text", 1.5), TypeError);
+});
+
+test("wrap preserves single spaces in normal case", () => {
+  assert.equal(wrap("hello world", 20), "hello world");
+  assert.equal(wrap("hello world foo bar", 12), "hello world\nfoo bar");
+});
+
+test("wrap handles very long text", () => {
+  const longText = "the quick brown fox jumps over the lazy dog";
+  const result = wrap(longText, 15);
+  const lines = result.split("\n");
+
+  // Verify no line exceeds width (except for words longer than width)
+  for (const line of lines) {
+    assert(line.length <= 15, `Line "${line}" exceeds width 15`);
+  }
+
+  // Verify the wrapped result reconstructs the original when spaces removed
+  assert.equal(result.replace(/\n/g, " "), longText);
+});
