+    const preStr = version.substring(dashIdx + 1);
+    version = version.substring(0, dashIdx);
+
+    // Validate prerelease
+    if (!preStr || !isValidPrerelease(preStr)) {
+      throw new RangeError(`Invalid semantic version: ${str}`);
+    }
+    prerelease = preStr.split('.');
+  }
