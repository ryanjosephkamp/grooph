index 0000000..d49027d
--- /dev/null
+++ b/textwrap/src/wrap.mjs
@@ -0,0 +1,61 @@
+/**
+ * Wraps text to a given width, breaking at word boundaries.
+ * Returns an array of lines, each with length <= width.
+ *
+ * @param {string} text
+ * @param {number} width
+ * @returns {string[]}
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || width < 1) throw new TypeError("wrap: width must be a positive number");
+
+  const lines = [];
+  const words = text.split(/\s+/);
+  let currentLine = "";
+
+  for (const word of words) {
+    if (word === "") continue;
+
+    if (currentLine === "") {
+      // First word on the line
+      if (word.length <= width) {
+        currentLine = word;
+      } else {
+        // Word is longer than width - have to break it
+        lines.push(word.slice(0, width));
+        let remaining = word.slice(width);
+        while (remaining.length > width) {
+          lines.push(remaining.slice(0, width));
+          remaining = remaining.slice(width);
+        }
+        currentLine = remaining;
+      }
+    } else if (currentLine.length + 1 + word.length <= width) {
+      // Word fits on current line
+      currentLine += " " + word;
+    } else {
+      // Word doesn't fit - start new line
+      lines.push(currentLine);
+
+      if (word.length <= width) {
+        currentLine = word;
+      } else {
+        // Word is longer than width - have to break it
+        lines.push(word.slice(0, width));
+        let remaining = word.slice(width);
+        while (remaining.length > width) {
+          lines.push(remaining.slice(0, width));
+          remaining = remaining.slice(width);
+        }
+        currentLine = remaining;
+      }
+    }
+  }
+
+  if (currentLine !== "") {
+    lines.push(currentLine);
+  }
+
+  return lines;
+}
diff --git a/textwrap/tests/wrap.test.mjs b/textwrap/tests/wrap.test.mjs
new file mode 100644
index 0000000..5cb903c
--- /dev/null
+++ b/textwrap/tests/wrap.test.mjs
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wraps text to given width", () => {
+  const result = wrap("hello world test", 10);
+  assert.deepEqual(result, ["hello", "world test"]);
+});
+
+test("handles single word", () => {
+  assert.deepEqual(wrap("hello", 10), ["hello"]);
+});
+
+test("fits multiple words on one line", () => {
+  assert.deepEqual(wrap("a b c d e", 9), ["a b c d e"]);
+});
+
+test("breaks long word at width", () => {
+  assert.deepEqual(wrap("verylongword", 5), ["veryl", "ongwo", "rd"]);
+});
+
+test("empty string returns empty array", () => {
+  assert.deepEqual(wrap("", 10), []);
+});
+
+test("multiple spaces treated as single separator", () => {
+  assert.deepEqual(wrap("a  b  c", 5), ["a b c"]);
+});
+
+test("leading and trailing whitespace ignored", () => {
+  assert.deepEqual(wrap("  hello world  ", 10), ["hello", "world"]);
+});
+
+test("width of 1 works", () => {
+  assert.deepEqual(wrap("abc", 1), ["a", "b", "c"]);
+});
+
+test("non-string input throws TypeError", () => {
+  assert.throws(() => wrap(123, 10), TypeError);
+  assert.throws(() => wrap(null, 10), TypeError);
+});
+
+test("invalid width throws TypeError", () => {
+  assert.throws(() => wrap("hello", 0), TypeError);
+  assert.throws(() => wrap("hello", -1), TypeError);
+  assert.throws(() => wrap("hello", "10"), TypeError);
+});
+
+test("exact width match", () => {
+  assert.deepEqual(wrap("hello world", 11), ["hello world"]);
+});
+
+test("long text with multiple lines", () => {
+  const result = wrap("the quick brown fox jumps over the lazy dog", 10);
+  assert.ok(result.every(line => line.length <= 10));
+  assert.equal(result.join(" ").split(/\s+/).join(" "), "the quick brown fox jumps over the lazy dog");
+});
