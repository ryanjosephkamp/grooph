--- a/semver-mini/src/semver.mjs
+++ b/semver-mini/src/semver.mjs
@@ -11,5 +11,94 @@
  * @returns {-1 | 0 | 1}
  */
 export function compare(a, b) {
-  throw new Error("not implemented");
+  if (typeof a !== "string") throw new TypeError("compare: a must be a string");
+  if (typeof b !== "string") throw new TypeError("compare: b must be a string");
+
+  const aVersion = parseVersion(a);
+  const bVersion = parseVersion(b);
+
+  if (aVersion.major !== bVersion.major) {
+    return aVersion.major < bVersion.major ? -1 : 1;
+  }
+  if (aVersion.minor !== bVersion.minor) {
+    return aVersion.minor < bVersion.minor ? -1 : 1;
+  }
+  if (aVersion.patch !== bVersion.patch) {
+    return aVersion.patch < bVersion.patch ? -1 : 1;
+  }
+
+  return comparePrerelease(aVersion.prerelease, bVersion.prerelease);
+}
+
+function parseVersion(str) {
+  // Parse version: X.Y.Z(-prerelease)(+build)
+  const match = str.match(/^(\d+)\.(\d+)\.(\d+)(?:-([a-zA-Z0-9.-]+))?(?:\+([a-zA-Z0-9.-]+))?$/);
+
+  if (!match) throw new RangeError(`Invalid semantic version: ${str}`);
+
+  const major = parseInt(match[1], 10);
+  const minor = parseInt(match[2], 10);
+  const patch = parseInt(match[3], 10);
+
+  // Check for leading zeros in version numbers
+  if (match[1] !== "0" && match[1][0] === "0") throw new RangeError(`Invalid semantic version: ${str}`);
+  if (match[2] !== "0" && match[2][0] === "0") throw new RangeError(`Invalid semantic version: ${str}`);
+  if (match[3] !== "0" && match[3][0] === "0") throw new RangeError(`Invalid semantic version: ${str}`);
+
+  const prerelease = match[4] ? match[4].split(".") : null;
+
+  // Validate prerelease identifiers
+  if (prerelease) {
+    if (prerelease.length === 0 || prerelease.some(id => id === "")) {
+      throw new RangeError(`Invalid semantic version: ${str}`);
+    }
+
+    for (const id of prerelease) {
+      if (/^\d+$/.test(id)) {
+        // Numeric identifiers cannot have leading zeros
+        if (id !== "0" && id[0] === "0") {
+          throw new RangeError(`Invalid semantic version: ${str}`);
+        }
+      }
+    }
+  }
+
+  return { major, minor, patch, prerelease };
+}
+
+function comparePrerelease(aPrerelease, bPrerelease) {
+  // No prerelease version is greater than a prerelease version
+  if (!aPrerelease && !bPrerelease) return 0;
+  if (!aPrerelease) return 1;
+  if (!bPrerelease) return -1;
+
+  // Compare each prerelease identifier
+  for (let i = 0; i < Math.max(aPrerelease.length, bPrerelease.length); i++) {
+    const aId = aPrerelease[i];
+    const bId = bPrerelease[i];
+
+    // A larger set of pre-release fields has a higher precedence than a smaller set
+    if (!aId) return -1;
+    if (!bId) return 1;
+
+    const aIsNum = /^\d+$/.test(aId);
+    const bIsNum = /^\d+$/.test(bId);
+
+    if (aIsNum && bIsNum) {
+      // Numeric identifiers compare as numbers
+      const aNum = parseInt(aId, 10);
+      const bNum = parseInt(bId, 10);
+      if (aNum !== bNum) return aNum < bNum ? -1 : 1;
+    } else if (aIsNum) {
+      // Numeric identifiers always have lower precedence than non-numeric identifiers
+      return -1;
+    } else if (bIsNum) {
+      return 1;
+    } else {
+      // Alphanumeric identifiers compare lexically in ASCII sort order
+      if (aId !== bId) return aId < bId ? -1 : 1;
+    }
+  }
+
+  return 0;
 }
