--- /dev/null
+++ b/settingskit/src/layer.mjs
@@ -0,0 +1,60 @@
+/**
+ * Layers `over` on top of `base`, recursively merging plain objects at matching
+ * keys and replacing everything else.
+ * @param {object} base
+ * @param {object} over
+ * @returns {object}
+ */
+export function layer(base, over) {
+  if (!isPlainObject(base)) throw new TypeError("layer: base must be a plain object");
+  if (!isPlainObject(over)) throw new TypeError("layer: over must be a plain object");
+  return merge(base, over);
+}
+
+function isPlainObject(obj) {
+  return obj !== null && typeof obj === "object" && Object.getPrototypeOf(obj) === Object.prototype && !Array.isArray(obj);
+}
+
+function merge(base, over) {
+  const result = {};
+  const safeKeys = (obj) => Object.keys(obj).filter(k => k !== "__proto__" && k !== "constructor" && k !== "prototype");
+
+  for (const key of safeKeys(base)) {
+    const baseVal = base[key];
+    if (Object.hasOwn(over, key)) {
+      const overVal = over[key];
+      if (isPlainObject(baseVal) && isPlainObject(overVal)) {
+        result[key] = merge(baseVal, overVal);
+      } else {
+        result[key] = deepClone(overVal);
+      }
+    } else {
+      result[key] = deepClone(baseVal);
+    }
+  }
+
+  for (const key of safeKeys(over)) {
+    if (!Object.hasOwn(result, key)) {
+      result[key] = deepClone(over[key]);
+    }
+  }
+
+  return result;
+}
+
+function deepClone(val) {
+  if (val === null || typeof val !== "object") return val;
+  if (Array.isArray(val)) {
+    return val.map(item => deepClone(item));
+  }
+  if (isPlainObject(val)) {
+    const cloned = {};
+    for (const key of Object.keys(val)) {
+      if (key !== "__proto__" && key !== "constructor" && key !== "prototype") {
+        cloned[key] = deepClone(val[key]);
+      }
+    }
+    return cloned;
+  }
+  return val;
+}
diff --git a/settingskit/tests/layer.test.mjs b/settingskit/tests/layer.test.mjs
new file mode 100644
index 0000000..63df08b
--- /dev/null
+++ b/settingskit/tests/layer.test.mjs
@@ -0,0 +1,111 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("basic layering with objects at same key", () => {
+  const result = layer({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 9 }, e: 5 });
+  assert.deepEqual(result, { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("plain objects under same key are layered at any depth", () => {
+  const result = layer(
+    { x: { y: { z: 1, w: 2 } } },
+    { x: { y: { z: 99 } } }
+  );
+  assert.deepEqual(result, { x: { y: { z: 99, w: 2 } } });
+});
+
+test("arrays in over replace base arrays", () => {
+  const result = layer({ a: [1, 2, 3] }, { a: [4, 5] });
+  assert.deepEqual(result, { a: [4, 5] });
+});
+
+test("numbers in over replace base values", () => {
+  const result = layer({ a: "old" }, { a: 42 });
+  assert.deepEqual(result, { a: 42 });
+});
+
+test("strings in over replace base values", () => {
+  const result = layer({ a: 123 }, { a: "new" });
+  assert.deepEqual(result, { a: "new" });
+});
+
+test("booleans in over replace base values", () => {
+  const result = layer({ a: true }, { a: false });
+  assert.deepEqual(result, { a: false });
+});
+
+test("null in over replaces base values", () => {
+  const result = layer({ a: "old" }, { a: null });
+  assert.deepEqual(result, { a: null });
+});
+
+test("base must be a plain object", () => {
+  assert.throws(() => layer([1, 2], {}), TypeError);
+  assert.throws(() => layer(null, {}), TypeError);
+  assert.throws(() => layer("string", {}), TypeError);
+  assert.throws(() => layer(42, {}), TypeError);
+  assert.throws(() => layer(new Date(), {}), TypeError);
+});
+
+test("over must be a plain object", () => {
+  assert.throws(() => layer({}, [1, 2]), TypeError);
+  assert.throws(() => layer({}, null), TypeError);
+  assert.throws(() => layer({}, "string"), TypeError);
+  assert.throws(() => layer({}, 42), TypeError);
+  assert.throws(() => layer({}, new Date()), TypeError);
+});
+
+test("neither argument is changed", () => {
+  const base = { a: 1, b: { c: 2 } };
+  const over = { b: { d: 3 }, e: 4 };
+  const baseCopy = JSON.parse(JSON.stringify(base));
+  const overCopy = JSON.parse(JSON.stringify(over));
+
+  layer(base, over);
+
+  assert.deepEqual(base, baseCopy);
+  assert.deepEqual(over, overCopy);
+});
+
+test("result shares nothing with base or over", () => {
+  const base = { a: { b: 1 }, arr: [1, 2, 3] };
+  const over = { a: { c: 2 }, arr: [4, 5] };
+  const result = layer(base, over);
+
+  assert.notStrictEqual(result, base);
+  assert.notStrictEqual(result, over);
+  assert.notStrictEqual(result.a, base.a);
+  assert.notStrictEqual(result.a, over.a);
+  assert.notStrictEqual(result.arr, over.arr);
+  assert.notStrictEqual(result.arr, base.arr);
+});
+
+test("skips __proto__, constructor, and prototype keys", () => {
+  const base = {};
+  Object.defineProperty(base, "__proto__", { value: "skip", enumerable: true });
+  Object.defineProperty(base, "constructor", { value: "skip", enumerable: true });
+  Object.defineProperty(base, "prototype", { value: "skip", enumerable: true });
+  base.a = 1;
+
+  const over = {};
+  Object.defineProperty(over, "__proto__", { value: "skip2", enumerable: true });
+  Object.defineProperty(over, "constructor", { value: "skip2", enumerable: true });
+  Object.defineProperty(over, "prototype", { value: "skip2", enumerable: true });
+
+  const result = layer(base, over);
+
+  assert.deepEqual(result, { a: 1 });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("result is an ordinary object", () => {
+  const result = layer({ a: 1 }, { b: 2 });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("nested objects in result are ordinary objects", () => {
+  const result = layer({ a: { b: 1 } }, { a: { c: 2 } });
+  assert.equal(Object.getPrototypeOf(result.a), Object.prototype);
+});
diff --git a/textwrap/src/wrap.mjs b/textwrap/src/wrap.mjs
