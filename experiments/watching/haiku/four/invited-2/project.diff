+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap wraps text to the given width", () => {
+  const text = "The quick brown fox jumps over the lazy dog";
+  const wrapped = wrap(text, 20);
+  const lines = wrapped.split("\n");
+  assert.ok(lines.every(line => line.length <= 20));
+});
+
+test("wrap does not break words", () => {
+  const text = "The quick brown fox jumps over the lazy dog";
+  const wrapped = wrap(text, 20);
+  // Verify no line exceeds width
+  assert.ok(wrapped.split("\n").every(line => line.length <= 20));
+  // Verify all words are intact
+  const words = text.split(/\s+/);
+  for (const word of words) {
+    assert.ok(wrapped.includes(word));
+  }
+});
+
+test("wrap with narrow width", () => {
+  const text = "hello world";
+  const wrapped = wrap(text, 8);
+  assert.deepEqual(wrapped, "hello\nworld");
+});
+
+test("wrap with very narrow width", () => {
+  const text = "a b c d";
+  const wrapped = wrap(text, 3);
+  const lines = wrapped.split("\n");
+  assert.ok(lines.every(line => line.length <= 3));
+});
+
+test("wrap preserves existing line breaks", () => {
+  const text = "hello world\nfoo bar";
+  const wrapped = wrap(text, 20);
+  assert.ok(wrapped.includes("hello world"));
+  assert.ok(wrapped.includes("foo bar"));
+});
+
+test("wrap does not change text that already fits", () => {
+  const text = "short text";
+  const wrapped = wrap(text, 50);
+  assert.equal(wrapped, text);
+});
+
+test("wrap with single word longer than width", () => {
+  const text = "supercalifragilisticexpialidocious";
+  const wrapped = wrap(text, 10);
+  // The word itself doesn't break, but if it's longer than width, it appears on its own line
+  assert.ok(wrapped.includes("supercalifragilisticexpialidocious"));
+});
+
+test("wrap requires string input", () => {
+  assert.throws(() => wrap(123, 20), TypeError);
+  assert.throws(() => wrap(null, 20), TypeError);
+});
+
+test("wrap requires numeric width", () => {
+  assert.throws(() => wrap("hello world", "20"), TypeError);
+  assert.throws(() => wrap("hello world", -5), TypeError);
+  assert.throws(() => wrap("hello world", 0), TypeError);
+});
+
+test("wrap with width 1", () => {
+  const text = "a b c";
+  const wrapped = wrap(text, 1);
+  const lines = wrapped.split("\n");
+  assert.ok(lines.every(line => line.length <= 1));
+});
+
+test("wrap with multiple spaces", () => {
+  const text = "hello     world";
+  const wrapped = wrap(text, 20);
+  assert.ok(wrapped.includes("hello"));
