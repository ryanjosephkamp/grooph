+  Object.defineProperty(over, "constructor", { value: { c: 3 }, enumerable: true });
+  Object.defineProperty(over, "prototype", { value: { d: 4 }, enumerable: true });
+  over.e = 5;
+  const result = layer(base, over);
+
+  assert.deepEqual(Object.keys(result), ["a", "e"]);
+  assert.ok(Object.getPrototypeOf(result) === Object.prototype);
+});
