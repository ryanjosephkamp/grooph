@@ -0,0 +1,54 @@
+/**
+ * Wraps text to a given width, breaking at word boundaries.
+ * Lines are broken so no line exceeds the given width.
+ * Existing line breaks are preserved.
+ * @param {string} text
+ * @param {number} width
+ * @returns {string}
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (typeof width !== "number" || width < 1) throw new TypeError("wrap: width must be a positive number");
+
+  const lines = text.split("\n");
+  const wrappedLines = lines.map(line => wrapLine(line, width));
+  return wrappedLines.join("\n");
+}
+
+function wrapLine(line, width) {
+  if (line.length <= width) return line;
+
+  const words = line.split(/(\s+)/);
+  const result = [];
+  let currentLine = "";
+
+  for (const word of words) {
+    if (word === "") continue;
+
+    const isWhitespace = /^\s+$/.test(word);
+
+    if (isWhitespace) {
+      if (currentLine.length + word.length <= width) {
+        currentLine += word;
+      } else if (currentLine.length > 0) {
+        result.push(currentLine.trimEnd());
+        currentLine = "";
+      }
+    } else {
+      if (currentLine.length === 0) {
+        currentLine = word;
+      } else if (currentLine.length + 1 + word.length <= width) {
+        currentLine += " " + word;
+      } else {
+        result.push(currentLine.trimEnd());
+        currentLine = word;
+      }
+    }
+  }
+
+  if (currentLine.length > 0) {
+    result.push(currentLine.trimEnd());
+  }
+
+  return result.join("\n");
+}
