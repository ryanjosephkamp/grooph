+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { layer } from "../src/layer.mjs";
+
+test("layer works as specified: merges nested objects", () => {
+  const base = { a: 1, b: { c: 2, d: 3 } };
+  const over = { b: { c: 9 }, e: 5 };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: 1, b: { c: 9, d: 3 }, e: 5 });
+});
+
+test("plain objects under the same key are layered at any depth", () => {
+  const base = { x: { y: { z: 1 } } };
+  const over = { x: { y: { w: 2 } } };
+  const result = layer(base, over);
+  assert.deepEqual(result, { x: { y: { z: 1, w: 2 } } });
+});
+
+test("a value in over replaces base for non-object values", () => {
+  const base = { a: 1, b: "hello", c: true };
+  const over = { a: 2, b: "world", c: false };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: 2, b: "world", c: false });
+});
+
+test("an array in over replaces the value in base whole", () => {
+  const base = { arr: [1, 2, 3] };
+  const over = { arr: [4, 5] };
+  const result = layer(base, over);
+  assert.deepEqual(result, { arr: [4, 5] });
+});
+
+test("keys only in base are kept", () => {
+  const base = { a: 1, b: 2 };
+  const over = { c: 3 };
+  const result = layer(base, over);
+  assert.deepEqual(result, { a: 1, b: 2, c: 3 });
+});
+
+test("base must be a plain object", () => {
+  assert.throws(() => layer(null, {}), TypeError);
+  assert.throws(() => layer([1, 2], {}), TypeError);
+  assert.throws(() => layer("string", {}), TypeError);
+  assert.throws(() => layer(123, {}), TypeError);
+  assert.throws(() => layer(new Date(), {}), TypeError);
+});
+
+test("over must be a plain object", () => {
+  assert.throws(() => layer({}, null), TypeError);
+  assert.throws(() => layer({}, [1, 2]), TypeError);
+  assert.throws(() => layer({}, "string"), TypeError);
+  assert.throws(() => layer({}, 123), TypeError);
+  assert.throws(() => layer({}, new Date()), TypeError);
+});
+
+test("missing arguments throw TypeError", () => {
+  assert.throws(() => layer({}), TypeError);
+  assert.throws(() => layer(), TypeError);
+});
+
+test("neither argument is changed", () => {
+  const base = { a: 1, b: { c: 2 } };
+  const over = { b: { d: 3 } };
+  const baseClone = JSON.parse(JSON.stringify(base));
+  const overClone = JSON.parse(JSON.stringify(over));
+
+  layer(base, over);
+
+  assert.deepEqual(base, baseClone);
+  assert.deepEqual(over, overClone);
+});
+
+test("result shares nothing with base or over", () => {
+  const base = { a: { b: 1 } };
+  const over = { c: { d: 2 } };
+  const result = layer(base, over);
+
+  assert.notStrictEqual(result, base);
+  assert.notStrictEqual(result, over);
+  assert.notStrictEqual(result.a, base.a);
+  assert.notStrictEqual(result.c, over.c);
+});
+
+test("arrays inside the result are copies", () => {
+  const base = { arr: [1, 2] };
+  const over = {};
+  const result = layer(base, over);
+
+  assert.notStrictEqual(result.arr, base.arr);
+  assert.deepEqual(result.arr, [1, 2]);
+});
+
+test("__proto__, constructor and prototype keys are never copied", () => {
+  const base = {};
+  Object.defineProperty(base, "__proto__", { value: { b: 2 }, enumerable: true });
+  Object.defineProperty(base, "constructor", { value: { c: 3 }, enumerable: true });
+  Object.defineProperty(base, "prototype", { value: { d: 4 }, enumerable: true });
+  base.a = 1;
+  const over = { e: 5 };
+  const result = layer(base, over);
+
+  assert.deepEqual(Object.keys(result), ["a", "e"]);
+  assert.ok(Object.getPrototypeOf(result) === Object.prototype);
+});
+
+test("dangerous keys in nested objects are also never copied", () => {
+  const nested = {};
+  Object.defineProperty(nested, "__proto__", { value: { a: 1 }, enumerable: true });
+  Object.defineProperty(nested, "constructor", { value: { b: 2 }, enumerable: true });
+  nested.normal = 3;
+  const base = { nested };
+  const over = {};
+  const result = layer(base, over);
