+    const bIdentifier = b[i];
+
+    const aIsNumeric = /^\d+$/.test(aIdentifier);
+    const bIsNumeric = /^\d+$/.test(bIdentifier);
+
+    if (aIsNumeric && bIsNumeric) {
+      const aNum = parseInt(aIdentifier, 10);
+      const bNum = parseInt(bIdentifier, 10);
+      if (aNum !== bNum) {
+        return aNum < bNum ? -1 : 1;
+      }
+    } else if (aIsNumeric) {
+      // Numeric identifiers always have lower precedence than non-numeric identifiers
+      return -1;
+    } else if (bIsNumeric) {
+      // Non-numeric identifiers have higher precedence than numeric identifiers
+      return 1;
+    } else {
+      // Both non-numeric, compare lexically
