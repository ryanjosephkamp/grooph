+`parseRanges(text, pageCount)` parses a page range string, such as what a
+person types into the print dialog's page box. It reads comma-separated parts,
+each of which is either a single page number or a range like `first-last`.
+It returns an array of the page numbers to print, in order. A `text` that is
+not a string, or a `pageCount` that is not a positive integer, throws a
+`TypeError`. A `text` that cannot be read as pages of the document (a page
+past the last one, a page `0`, a word, a part that is neither a page nor a
+range) throws a `RangeError`.
diff --git a/src/parse-ranges.mjs b/src/parse-ranges.mjs
new file mode 100644
index 0000000..0beb0d3
--- /dev/null
+++ b/src/parse-ranges.mjs
@@ -0,0 +1,77 @@
+/**
+ * Parse page ranges from a text string.
+ * @param {string} text A string like "1-3,5" or "7"
+ * @param {number} pageCount Total number of pages in the document
+ * @returns {number[]} Array of page numbers to print, 1-indexed
+ */
+export function parseRanges(text, pageCount) {
+  if (typeof text !== "string") {
+    throw new TypeError("parseRanges: text must be a string");
+  }
+
+  if (
+    typeof pageCount !== "number" ||
+    !Number.isInteger(pageCount) ||
+    pageCount <= 0
+  ) {
+    throw new TypeError(
+      "parseRanges: pageCount must be a positive integer"
+    );
+  }
+
+  const parts = text.split(",");
+  const pages = [];
+
+  for (const part of parts) {
+    const trimmed = part.trim();
+
+    if (trimmed === "") {
+      throw new RangeError("parseRanges: empty part");
+    }
+
+    if (trimmed.includes("-")) {
+      // It's a range
+      const rangeParts = trimmed.split("-");
+      if (rangeParts.length !== 2) {
+        throw new RangeError(`parseRanges: invalid range "${trimmed}"`);
+      }
+
+      const startNum = parseInt(rangeParts[0].trim(), 10);
+      const endNum = parseInt(rangeParts[1].trim(), 10);
+
+      if (isNaN(startNum) || isNaN(endNum)) {
+        throw new RangeError(`parseRanges: invalid range "${trimmed}"`);
+      }
+
+      if (
+        startNum < 1 ||
+        startNum > pageCount ||
+        endNum < 1 ||
+        endNum > pageCount
+      ) {
+        throw new RangeError(
+          `parseRanges: page out of range in "${trimmed}"`
+        );
+      }
+
+      for (let i = startNum; i <= endNum; i++) {
+        pages.push(i);
+      }
+    } else {
+      // It's a single page
+      const pageNum = parseInt(trimmed, 10);
+
+      if (isNaN(pageNum)) {
+        throw new RangeError(`parseRanges: invalid page "${trimmed}"`);
+      }
+
+      if (pageNum < 1 || pageNum > pageCount) {
+        throw new RangeError(`parseRanges: page out of range "${trimmed}"`);
+      }
+
+      pages.push(pageNum);
+    }
+  }
+
+  return pages;
+}
diff --git a/tests/parse-ranges.test.mjs b/tests/parse-ranges.test.mjs
new file mode 100644
index 0000000..19b3352
--- /dev/null
+++ b/tests/parse-ranges.test.mjs
@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { parseRanges } from "../src/parse-ranges.mjs";
+
+test("parseRanges parses simple ranges and single pages", () => {
+  assert.deepEqual(parseRanges("1-3,5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges("7", 10), [7]);
+});
+
+test("parseRanges handles single pages", () => {
+  assert.deepEqual(parseRanges("1", 10), [1]);
+  assert.deepEqual(parseRanges("5", 10), [5]);
+  assert.deepEqual(parseRanges("10", 10), [10]);
+});
+
+test("parseRanges handles ranges", () => {
+  assert.deepEqual(parseRanges("1-5", 10), [1, 2, 3, 4, 5]);
+  assert.deepEqual(parseRanges("2-4", 10), [2, 3, 4]);
+});
+
+test("parseRanges handles multiple parts separated by commas", () => {
+  assert.deepEqual(parseRanges("1,3,5", 10), [1, 3, 5]);
+  assert.deepEqual(parseRanges("1-2,5-6", 10), [1, 2, 5, 6]);
+  assert.deepEqual(parseRanges("1,2-4,7,9-10", 10), [1, 2, 3, 4, 7, 9, 10]);
+});
+
+test("parseRanges handles whitespace", () => {
+  assert.deepEqual(parseRanges(" 1 - 3 , 5 ", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges("1 , 5", 10), [1, 5]);
+});
+
+test("parseRanges throws TypeError for non-string text", () => {
+  assert.throws(() => parseRanges(123, 10), TypeError);
+  assert.throws(() => parseRanges(null, 10), TypeError);
+  assert.throws(() => parseRanges(undefined, 10), TypeError);
+  assert.throws(() => parseRanges(["1", "2"], 10), TypeError);
+});
+
+test("parseRanges throws TypeError for invalid pageCount", () => {
+  assert.throws(() => parseRanges("1", "10"), TypeError);
+  assert.throws(() => parseRanges("1", 0), TypeError);
+  assert.throws(() => parseRanges("1", -1), TypeError);
+  assert.throws(() => parseRanges("1", 2.5), TypeError);
+  assert.throws(() => parseRanges("1", null), TypeError);
+});
+
+test("parseRanges throws RangeError for pages outside document", () => {
+  assert.throws(() => parseRanges("11", 10), RangeError);
+  assert.throws(() => parseRanges("0", 10), RangeError);
+  assert.throws(() => parseRanges("1-11", 10), RangeError);
+  assert.throws(() => parseRanges("5-15", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for invalid formats", () => {
+  assert.throws(() => parseRanges("abc", 10), RangeError);
+  assert.throws(() => parseRanges("1-", 10), RangeError);
+  assert.throws(() => parseRanges("-5", 10), RangeError);
+  assert.throws(() => parseRanges("1-3-5", 10), RangeError);
+  assert.throws(() => parseRanges(",1,2", 10), RangeError);
+  assert.throws(() => parseRanges("1,2,", 10), RangeError);
+});
