diff --git a/src/parse-ranges.mjs b/src/parse-ranges.mjs
new file mode 100644
index 0000000..481cdf0
--- /dev/null
+++ b/src/parse-ranges.mjs
@@ -0,0 +1,75 @@
+export function parseRanges(text, pageCount) {
+  // Type validation
+  if (typeof text !== "string") {
+    throw new TypeError("parseRanges: text must be a string");
+  }
+  if (!Number.isInteger(pageCount) || pageCount <= 0) {
+    throw new TypeError("parseRanges: pageCount must be a positive integer");
+  }
+
+  const pages = new Set();
+  const parts = text.split(",");
+
+  for (const part of parts) {
+    const trimmed = part.trim();
+
+    if (!trimmed) {
+      throw new RangeError("parseRanges: empty part");
+    }
+
+    if (trimmed.includes("-")) {
+      // It's a range
+      const rangeParts = trimmed.split("-");
+
+      if (rangeParts.length !== 2) {
+        throw new RangeError("parseRanges: invalid range format");
+      }
+
+      const startStr = rangeParts[0].trim();
+      const endStr = rangeParts[1].trim();
+
+      if (!startStr || !endStr) {
+        throw new RangeError("parseRanges: invalid range");
+      }
+
+      const startNum = parseInt(startStr, 10);
+      const endNum = parseInt(endStr, 10);
+
+      if (isNaN(startNum) || isNaN(endNum)) {
+        throw new RangeError("parseRanges: invalid page number in range");
+      }
+
+      if (
+        startNum < 1 ||
+        endNum < 1 ||
+        startNum > pageCount ||
+        endNum > pageCount
+      ) {
+        throw new RangeError("parseRanges: page number out of range");
+      }
+
+      if (startNum > endNum) {
+        throw new RangeError("parseRanges: invalid range order");
+      }
+
+      for (let i = startNum; i <= endNum; i++) {
+        pages.add(i);
+      }
+    } else {
+      // It's a single page
+      const pageNum = parseInt(trimmed, 10);
+
+      if (isNaN(pageNum)) {
+        throw new RangeError("parseRanges: invalid page number");
+      }
+
+      if (pageNum < 1 || pageNum > pageCount) {
+        throw new RangeError("parseRanges: page number out of range");
+      }
+
+      pages.add(pageNum);
+    }
+  }
+
+  return Array.from(pages).sort((a, b) => a - b);
+}
diff --git a/tests/parse-ranges.test.mjs b/tests/parse-ranges.test.mjs
new file mode 100644
index 0000000..f2802f2
--- /dev/null
+++ b/tests/parse-ranges.test.mjs
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { parseRanges } from "../src/parse-ranges.mjs";
+
+test("parseRanges parses comma-separated pages and ranges", () => {
+  assert.deepEqual(parseRanges("1-3,5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges("7", 10), [7]);
+});
+
+test("parseRanges handles single pages", () => {
+  assert.deepEqual(parseRanges("1", 10), [1]);
+  assert.deepEqual(parseRanges("5", 10), [5]);
+  assert.deepEqual(parseRanges("10", 10), [10]);
+});
+
+test("parseRanges handles simple ranges", () => {
+  assert.deepEqual(parseRanges("1-3", 10), [1, 2, 3]);
+  assert.deepEqual(parseRanges("5-7", 10), [5, 6, 7]);
+});
+
+test("parseRanges handles multiple ranges and pages", () => {
+  assert.deepEqual(parseRanges("1-2,5,7-9", 10), [1, 2, 5, 7, 8, 9]);
+  assert.deepEqual(parseRanges("1,3-5,10", 10), [1, 3, 4, 5, 10]);
+});
+
+test("parseRanges handles spaces around commas and dashes", () => {
+  assert.deepEqual(parseRanges("1 - 3 , 5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges(" 1 , 5 ", 10), [1, 5]);
+});
+
+test("parseRanges returns unique pages only once", () => {
+  assert.deepEqual(parseRanges("1,1,2-3,3", 10), [1, 2, 3]);
+});
+
+test("parseRanges returns sorted pages", () => {
+  assert.deepEqual(parseRanges("5,1-3,7", 10), [1, 2, 3, 5, 7]);
+});
+
+test("parseRanges throws TypeError if text is not a string", () => {
+  assert.throws(() => parseRanges(123, 10), TypeError);
+  assert.throws(() => parseRanges(null, 10), TypeError);
+  assert.throws(() => parseRanges(undefined, 10), TypeError);
+  assert.throws(() => parseRanges(["1", "2"], 10), TypeError);
+});
+
+test("parseRanges throws TypeError if pageCount is not a positive integer", () => {
+  assert.throws(() => parseRanges("1", 0), TypeError);
+  assert.throws(() => parseRanges("1", -1), TypeError);
+  assert.throws(() => parseRanges("1", 2.5), TypeError);
+  assert.throws(() => parseRanges("1", "10"), TypeError);
+  assert.throws(() => parseRanges("1", null), TypeError);
+  assert.throws(() => parseRanges("1", undefined), TypeError);
+});
+
+test("parseRanges throws RangeError if page is 0", () => {
+  assert.throws(() => parseRanges("0", 10), RangeError);
+  assert.throws(() => parseRanges("1-0", 10), RangeError);
+  assert.throws(() => parseRanges("0-1", 10), RangeError);
+});
+
+test("parseRanges throws RangeError if page exceeds pageCount", () => {
+  assert.throws(() => parseRanges("11", 10), RangeError);
+  assert.throws(() => parseRanges("1-11", 10), RangeError);
+  assert.throws(() => parseRanges("9-11", 10), RangeError);
+});
+
+test("parseRanges throws RangeError if range is backwards", () => {
+  assert.throws(() => parseRanges("5-1", 10), RangeError);
+  assert.throws(() => parseRanges("10-5", 10), RangeError);
+});
+
+test("parseRanges throws RangeError if part is not a valid page or range", () => {
+  assert.throws(() => parseRanges("abc", 10), RangeError);
+  assert.throws(() => parseRanges("1,abc", 10), RangeError);
+  assert.throws(() => parseRanges("1-3,abc-def", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for invalid range formats", () => {
+  assert.throws(() => parseRanges("1-2-3", 10), RangeError);
+  assert.throws(() => parseRanges("1--2", 10), RangeError);
+  assert.throws(() => parseRanges("-1", 10), RangeError);
+  assert.throws(() => parseRanges("1-", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for empty parts", () => {
+  assert.throws(() => parseRanges("1,,2", 10), RangeError);
+});
