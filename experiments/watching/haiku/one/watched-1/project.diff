+`parseRanges(text, pageCount)` reads what a person typed into the page box and
+returns the page numbers to print as an array. Pages are numbered from 1 to
+`pageCount`; parts are separated by commas, and a part is one page or a range
+written `first-last`. A `text` that is not a string, or a `pageCount` that is
+not a positive integer, throws a `TypeError`; a text that cannot be read as
+pages of this document throws a `RangeError`.
diff --git a/src/parse-ranges.mjs b/src/parse-ranges.mjs
new file mode 100644
index 0000000..063f99b
--- /dev/null
+++ b/src/parse-ranges.mjs
@@ -0,0 +1,66 @@
+export function parseRanges(text, pageCount) {
+  if (typeof text !== "string") {
+    throw new TypeError("parseRanges: text must be a string");
+  }
+  if (
+    typeof pageCount !== "number" ||
+    pageCount <= 0 ||
+    !Number.isInteger(pageCount)
+  ) {
+    throw new TypeError("parseRanges: pageCount must be a positive integer");
+  }
+
+  const pages = [];
+  const parts = text.split(",");
+
+  for (const part of parts) {
+    const trimmed = part.trim();
+    if (!trimmed) {
+      throw new RangeError("parseRanges: empty part");
+    }
+
+    if (trimmed.includes("-")) {
+      const parts_range = trimmed.split("-");
+      if (parts_range.length !== 2) {
+        throw new RangeError(`parseRanges: invalid range "${trimmed}"`);
+      }
+      const startPage = parseInt(parts_range[0].trim(), 10);
+      const endPage = parseInt(parts_range[1].trim(), 10);
+
+      if (isNaN(startPage) || isNaN(endPage)) {
+        throw new RangeError(`parseRanges: invalid range "${trimmed}"`);
+      }
+
+      if (startPage < 1 || startPage > pageCount) {
+        throw new RangeError(
+          `parseRanges: page ${startPage} out of range (1-${pageCount})`
+        );
+      }
+      if (endPage < 1 || endPage > pageCount) {
+        throw new RangeError(
+          `parseRanges: page ${endPage} out of range (1-${pageCount})`
+        );
+      }
+
+      for (let i = startPage; i <= endPage; i++) {
+        pages.push(i);
+      }
+    } else {
+      const pageNum = parseInt(trimmed, 10);
+
+      if (isNaN(pageNum)) {
+        throw new RangeError(`parseRanges: invalid page "${trimmed}"`);
+      }
+
+      if (pageNum < 1 || pageNum > pageCount) {
+        throw new RangeError(
+          `parseRanges: page ${pageNum} out of range (1-${pageCount})`
+        );
+      }
+
+      pages.push(pageNum);
+    }
+  }
+
+  return pages;
+}
diff --git a/tests/parse-ranges.test.mjs b/tests/parse-ranges.test.mjs
new file mode 100644
index 0000000..67817a5
--- /dev/null
+++ b/tests/parse-ranges.test.mjs
@@ -0,0 +1,74 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { parseRanges } from "../src/parse-ranges.mjs";
+
+test("parseRanges examples from the task", () => {
+  assert.deepEqual(parseRanges("1-3,5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges("7", 10), [7]);
+});
+
+test("parseRanges handles single pages", () => {
+  assert.deepEqual(parseRanges("1", 10), [1]);
+  assert.deepEqual(parseRanges("10", 10), [10]);
+  assert.deepEqual(parseRanges("5", 10), [5]);
+});
+
+test("parseRanges handles ranges", () => {
+  assert.deepEqual(parseRanges("1-3", 10), [1, 2, 3]);
+  assert.deepEqual(parseRanges("5-8", 10), [5, 6, 7, 8]);
+  assert.deepEqual(parseRanges("10-10", 10), [10]);
+});
+
+test("parseRanges handles multiple parts", () => {
+  assert.deepEqual(parseRanges("1,3,5", 10), [1, 3, 5]);
+  assert.deepEqual(parseRanges("1-2,5-6", 10), [1, 2, 5, 6]);
+  assert.deepEqual(parseRanges("1,3-5,7", 10), [1, 3, 4, 5, 7]);
+});
+
+test("parseRanges handles whitespace", () => {
+  assert.deepEqual(parseRanges(" 1 , 3 , 5 ", 10), [1, 3, 5]);
+  assert.deepEqual(parseRanges("1 - 3", 10), [1, 2, 3]);
+  assert.deepEqual(parseRanges(" 5 ", 10), [5]);
+});
+
+test("parseRanges throws TypeError for non-string text", () => {
+  assert.throws(() => parseRanges(123, 10), TypeError);
+  assert.throws(() => parseRanges(null, 10), TypeError);
+  assert.throws(() => parseRanges(undefined, 10), TypeError);
+  assert.throws(() => parseRanges(["1", "3"], 10), TypeError);
+  assert.throws(() => parseRanges({}, 10), TypeError);
+});
+
+test("parseRanges throws TypeError for invalid pageCount", () => {
+  assert.throws(() => parseRanges("1", 0), TypeError);
+  assert.throws(() => parseRanges("1", -1), TypeError);
+  assert.throws(() => parseRanges("1", 2.5), TypeError);
+  assert.throws(() => parseRanges("1", "10"), TypeError);
+  assert.throws(() => parseRanges("1", null), TypeError);
+  assert.throws(() => parseRanges("1", undefined), TypeError);
+});
+
+test("parseRanges throws RangeError for page 0", () => {
+  assert.throws(() => parseRanges("0", 10), RangeError);
+  assert.throws(() => parseRanges("0-2", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for page past the last one", () => {
+  assert.throws(() => parseRanges("11", 10), RangeError);
+  assert.throws(() => parseRanges("1-11", 10), RangeError);
+  assert.throws(() => parseRanges("5,15", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for invalid format", () => {
+  assert.throws(() => parseRanges("abc", 10), RangeError);
+  assert.throws(() => parseRanges("1-a", 10), RangeError);
+  assert.throws(() => parseRanges("a-5", 10), RangeError);
+  assert.throws(() => parseRanges("1-3-5", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for empty parts", () => {
+  assert.throws(() => parseRanges("1,,3", 10), RangeError);
+  assert.throws(() => parseRanges(",1", 10), RangeError);
+  assert.throws(() => parseRanges("1,", 10), RangeError);
+});
