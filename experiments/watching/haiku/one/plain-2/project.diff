 The dialog also has a page box, where a person types which pages of the
 document to print.
+
+```js
+import { parseRanges } from "./src/parse-ranges.mjs";
+
+parseRanges("1-3,5", 10); // [1, 2, 3, 5]
+parseRanges("7", 10);     // [7]
+```
+
+`parseRanges(text, pageCount)` reads what a person typed into the page box and
+returns the page numbers to print as an array. Pages are numbered from 1 to
+`pageCount`; parts are separated by commas, and a part is one page or a range
+written `first-last`. A `text` that is not a string throws a `TypeError`; a
+`pageCount` that is not a positive integer throws a `TypeError`; a text that
+cannot be read as pages of this document throws a `RangeError`.
diff --git a/src/parse-ranges.mjs b/src/parse-ranges.mjs
new file mode 100644
index 0000000..995ac1b
--- /dev/null
+++ b/src/parse-ranges.mjs
@@ -0,0 +1,63 @@
+export function parseRanges(text, pageCount) {
+  if (typeof text !== "string") {
+    throw new TypeError("text must be a string");
+  }
+
+  if (!Number.isInteger(pageCount) || pageCount <= 0) {
+    throw new TypeError("pageCount must be a positive integer");
+  }
+
+  const result = [];
+  const parts = text.split(",");
+
+  for (const part of parts) {
+    const trimmed = part.trim();
+
+    if (trimmed === "") {
+      throw new RangeError("empty part in page range");
+    }
+
+    if (trimmed.includes("-")) {
+      const rangeParts = trimmed.split("-");
+      if (rangeParts.length !== 2) {
+        throw new RangeError(`invalid page range: ${trimmed}`);
+      }
+      const [startStr, endStr] = rangeParts;
+      const startTrimmed = startStr.trim();
+      const endTrimmed = endStr.trim();
+
+      if (!/^\d+$/.test(startTrimmed) || !/^\d+$/.test(endTrimmed)) {
+        throw new RangeError(`invalid page range: ${trimmed}`);
+      }
+
+      const start = parseInt(startTrimmed, 10);
+      const end = parseInt(endTrimmed, 10);
+
+      if (start < 1 || end < 1 || start > pageCount || end > pageCount) {
+        throw new RangeError(`page out of range: ${trimmed}`);
+      }
+
+      if (start > end) {
+        throw new RangeError(`invalid range: ${trimmed}`);
+      }
+
+      for (let i = start; i <= end; i++) {
+        result.push(i);
+      }
+    } else {
+      if (!/^\d+$/.test(trimmed)) {
+        throw new RangeError(`invalid page: ${trimmed}`);
+      }
+
+      const page = parseInt(trimmed, 10);
+
+      if (page < 1 || page > pageCount) {
+        throw new RangeError(`page out of range: ${trimmed}`);
+      }
+
+      result.push(page);
+    }
+  }
+
+  return result;
+}
diff --git a/tests/parse-ranges.test.mjs b/tests/parse-ranges.test.mjs
new file mode 100644
index 0000000..a8f222b
--- /dev/null
+++ b/tests/parse-ranges.test.mjs
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { parseRanges } from "../src/parse-ranges.mjs";
+
+test("parseRanges handles basic examples", () => {
+  assert.deepEqual(parseRanges("1-3,5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges("7", 10), [7]);
+});
+
+test("parseRanges handles single pages", () => {
+  assert.deepEqual(parseRanges("1", 5), [1]);
+  assert.deepEqual(parseRanges("2", 5), [2]);
+  assert.deepEqual(parseRanges("5", 5), [5]);
+});
+
+test("parseRanges handles ranges", () => {
+  assert.deepEqual(parseRanges("1-3", 5), [1, 2, 3]);
+  assert.deepEqual(parseRanges("2-4", 5), [2, 3, 4]);
+});
+
+test("parseRanges handles multiple parts", () => {
+  assert.deepEqual(parseRanges("1,3,5", 5), [1, 3, 5]);
+  assert.deepEqual(parseRanges("1-2,4-5", 5), [1, 2, 4, 5]);
+});
+
+test("parseRanges handles whitespace", () => {
+  assert.deepEqual(parseRanges("1 - 3 , 5", 10), [1, 2, 3, 5]);
+  assert.deepEqual(parseRanges(" 1 , 3 ", 5), [1, 3]);
+});
+
+test("parseRanges throws TypeError for non-string text", () => {
+  assert.throws(() => parseRanges(123, 10), TypeError);
+  assert.throws(() => parseRanges(null, 10), TypeError);
+  assert.throws(() => parseRanges(undefined, 10), TypeError);
+  assert.throws(() => parseRanges([], 10), TypeError);
+});
+
+test("parseRanges throws TypeError for invalid pageCount", () => {
+  assert.throws(() => parseRanges("1", 0), TypeError);
+  assert.throws(() => parseRanges("1", -1), TypeError);
+  assert.throws(() => parseRanges("1", 2.5), TypeError);
+  assert.throws(() => parseRanges("1", "10"), TypeError);
+  assert.throws(() => parseRanges("1", null), TypeError);
+});
+
+test("parseRanges throws RangeError for page zero", () => {
+  assert.throws(() => parseRanges("0", 10), RangeError);
+  assert.throws(() => parseRanges("1-0", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for page past last", () => {
+  assert.throws(() => parseRanges("11", 10), RangeError);
+  assert.throws(() => parseRanges("5-12", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for invalid parts", () => {
+  assert.throws(() => parseRanges("abc", 10), RangeError);
+  assert.throws(() => parseRanges("1-", 10), RangeError);
+  assert.throws(() => parseRanges("-3", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for reversed range", () => {
+  assert.throws(() => parseRanges("5-3", 10), RangeError);
+});
+
+test("parseRanges throws RangeError for empty parts", () => {
+  assert.throws(() => parseRanges("1,,3", 10), RangeError);
+  assert.throws(() => parseRanges("1,", 10), RangeError);
+});
+
+test("parseRanges handles edge case with single page document", () => {
+  assert.deepEqual(parseRanges("1", 1), [1]);
+  assert.throws(() => parseRanges("2", 1), RangeError);
+});
+
+test("parseRanges handles edge case with all pages", () => {
+  assert.deepEqual(parseRanges("1-5", 5), [1, 2, 3, 4, 5]);
+});
