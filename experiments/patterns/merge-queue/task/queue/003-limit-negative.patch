diff --git a/src/limit.mjs b/src/limit.mjs
index a4dcb57..ecd004b 100644
--- a/src/limit.mjs
+++ b/src/limit.mjs
@@ -1,5 +1,5 @@
-/** The first `n` items of a list. */
