diff --git a/src/search.mjs b/src/search.mjs
index 678c53b..5f9fa90 100644
--- a/src/search.mjs
+++ b/src/search.mjs
@@ -1,9 +1,10 @@
 /**
- * Finds the items whose title contains the query. Exact title matches come
- * first, then the rest in their original order.
+ * Finds the items whose title contains the query, ignoring case, sorted by
+ * title so results read the same whatever order the items came in.
  */
 export function search(items, query) {
-  const exact = items.filter((item) => item.title === query);
-  const partial = items.filter((item) => item.title !== query && item.title.includes(query));
-  return [...exact, ...partial];
+  const q = query.toLowerCase();
+  return items
+    .filter((item) => item.title.toLowerCase().includes(q))
+    .sort((a, b) => a.title.localeCompare(b.title));
 }
