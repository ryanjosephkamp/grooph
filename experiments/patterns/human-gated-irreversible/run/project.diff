+// Ids must never be reused, even after the note with the highest id so far
+// is removed. The current max id can't always be recovered from the notes
+// still in the array (e.g. after removing the highest-id note), so we track
+// the highest id ever issued in a hidden, non-enumerable property on the
+// array. It's invisible to callers and to deep-equality checks, but travels
+// with the array across addNote/removeNote calls.
+const MAX_ID = Symbol("maxId");
+
+function highestIdSoFar(notes) {
+  const seen = notes[MAX_ID] ?? 0;
+  const inArray = notes.reduce((max, note) => Math.max(max, note.id), 0);
+  return Math.max(seen, inArray);
+}
+
+function withMaxId(newNotes, maxId) {
+  Object.defineProperty(newNotes, MAX_ID, { value: maxId, enumerable: false, configurable: true });
+  return newNotes;
+}
+
 /**
  * Adds a note and returns the new list. Ids count up from 1 and are never reused.
  * @param {{ id: number, text: string }[]} notes
@@ -5,11 +24,27 @@
  */
 export function addNote(notes, text) {
   if (typeof text !== "string" || text.trim() === "") throw new TypeError("addNote: text must be a non-empty string");
-  const id = notes.reduce((max, note) => Math.max(max, note.id), 0) + 1;
-  return [...notes, { id, text }];
+  const id = highestIdSoFar(notes) + 1;
+  return withMaxId([...notes, { id, text }], id);
 }
 
 /** The notes, oldest first, as a new array. */
 export function listNotes(notes) {
   return [...notes].sort((a, b) => a.id - b.id);
 }
+
+/**
+ * Removes the note with the given id and returns the new list.
+ * Throws TypeError if id is not a positive integer, RangeError if no note has that id.
+ * @param {{ id: number, text: string }[]} notes
+ * @param {number} id
+ */
+export function removeNote(notes, id) {
+  if (typeof id !== "number" || !Number.isInteger(id) || id <= 0) {
+    throw new TypeError("removeNote: id must be a positive integer");
+  }
+  if (!notes.some((note) => note.id === id)) {
+    throw new RangeError(`removeNote: no note with id ${id}`);
+  }
+  return withMaxId(notes.filter((note) => note.id !== id), highestIdSoFar(notes));
+}
