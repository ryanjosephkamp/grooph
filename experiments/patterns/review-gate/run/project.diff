+/**
+ * Shortens `text` to at most `max` characters.
+ * Text of `max` characters or fewer comes back unchanged; longer text is cut
+ * and ends with the one-character ellipsis "…", so the result is exactly
+ * `max` characters long.
+ *
+ * Length is counted the same way as `String.prototype.length`, in UTF-16 code
+ * units, which is what the rest of this package uses.
+ *
+ * @param {string} text
+ * @param {number} max a positive integer
+ * @returns {string}
+ */
+export function truncate(text, max) {
+  if (typeof text !== "string") throw new TypeError("truncate: text must be a string");
+  if (!Number.isInteger(max) || max < 1) throw new RangeError("truncate: max must be a positive integer");
+  return text.length <= max ? text : text.slice(0, max - 1) + "…";
+}
