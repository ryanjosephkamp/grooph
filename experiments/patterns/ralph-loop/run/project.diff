+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { topWords } from "../src/text.mjs";
+
+test("returns the n most frequent words, most frequent first", () => {
+  assert.deepEqual(topWords("the quick brown fox the fox the", 2), [
+    ["the", 3],
+    ["fox", 2],
+  ]);
+});
+
+test("breaks ties alphabetically", () => {
+  assert.deepEqual(topWords("banana apple cherry apple banana cherry", 3), [
+    ["apple", 2],
+    ["banana", 2],
+    ["cherry", 2],
+  ]);
+});
+
+test("returns fewer than n pairs when there are fewer distinct words", () => {
+  assert.deepEqual(topWords("one two one", 5), [
+    ["one", 2],
+    ["two", 1],
+  ]);
+});
+
+test("returns an empty array for text with no words", () => {
+  assert.deepEqual(topWords("   ...  !! ", 3), []);
+});
+
+test("throws a TypeError for non-string input", () => {
+  assert.throws(() => topWords(42, 3), TypeError);
+  assert.throws(() => topWords(null, 3), TypeError);
+});
