diff --git a/src/text.mjs b/src/text.mjs
index f6f33b2..d3e6b75 100644
--- a/src/text.mjs
+++ b/src/text.mjs
@@ -2,3 +2,70 @@
  * Word statistics for plain text. Functions are added one plan item at a time
  * (see PLAN.md); each is exported by name.
  */
+
+/**
+ * The words of `text` in order, lower-cased, with punctuation stripped. An
+ * apostrophe inside a word (e.g. `don't`) stays part of the word; leading,
+ * trailing or standalone apostrophes/quotes are stripped along with other
+ * punctuation. A typographic apostrophe (U+2019, `’`) inside a word is
+ * treated the same as a straight apostrophe and normalized to `'` in the
+ * output, so `it's` and `it’s` tokenize to the same word.
+ *
+ * @param {string} text
+ * @returns {string[]}
+ */
+export function tokenize(text) {
+  if (typeof text !== "string") {
+    throw new TypeError("tokenize expects a string");
+  }
+  const matches = text.toLowerCase().match(/[a-z0-9]+(?:['’][a-z0-9]+)*/g);
+  return (matches ?? []).map((word) => word.replace(/’/g, "'"));
+}
+
+/**
+ * A `Map` from each word (as `tokenize` gives it) to its count, in
+ * first-seen order.
+ *
+ * @param {string} text
+ * @returns {Map<string, number>}
+ */
+export function frequencies(text) {
+  const counts = new Map();
+  for (const word of tokenize(text)) {
+    counts.set(word, (counts.get(word) ?? 0) + 1);
+  }
+  return counts;
+}
+
+/**
+ * The `n` most frequent words of `text` as `[word, count]` pairs, most
+ * frequent first, ties broken alphabetically. Fewer than `n` pairs are
+ * returned when the text has fewer distinct words.
+ *
+ * @param {string} text
+ * @param {number} n
+ * @returns {[string, number][]}
+ */
+export function topWords(text, n) {
+  const pairs = [...frequencies(text)];
+  pairs.sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));
+  return pairs.slice(0, n);
+}
+
+/**
+ * A summary of `text`: the number of tokens (`words`), the number of
+ * distinct words (`unique`) and the 3 most frequent words (`top`, as
+ * `topWords(text, 3)` gives them).
+ *
+ * @param {string} text
+ * @returns {{ words: number, unique: number, top: [string, number][] }}
+ */
+export function summary(text) {
+  const tokens = tokenize(text);
+  const uniqueCount = frequencies(text).size;
+  return {
+    words: tokens.length,
+    unique: uniqueCount,
+    top: topWords(text, 3),
+  };
+}
diff --git a/tests/frequencies.test.mjs b/tests/frequencies.test.mjs
new file mode 100644
index 0000000..af59ddc
--- /dev/null
+++ b/tests/frequencies.test.mjs
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { frequencies } from "../src/text.mjs";
+
+test("counts each word in first-seen order", () => {
+  assert.deepEqual(
+    [...frequencies("the quick brown fox the fox the")],
+    [
+      ["the", 3],
+      ["quick", 1],
+      ["brown", 1],
+      ["fox", 2],
+    ],
+  );
+});
+
+test("returns an empty Map for text with no words", () => {
+  const result = frequencies("   ...  !! ");
+  assert.ok(result instanceof Map);
+  assert.equal(result.size, 0);
+});
+
+test("uses tokenize's word rules, e.g. apostrophes inside words", () => {
+  assert.deepEqual(
+    [...frequencies("don't stop don't")],
+    [
+      ["don't", 2],
+      ["stop", 1],
+    ],
+  );
+});
+
+test("throws a TypeError for non-string input", () => {
+  assert.throws(() => frequencies(42), TypeError);
+  assert.throws(() => frequencies(null), TypeError);
+});
diff --git a/tests/summary.test.mjs b/tests/summary.test.mjs
new file mode 100644
index 0000000..2a45f46
--- /dev/null
+++ b/tests/summary.test.mjs
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { summary } from "../src/text.mjs";
+
+test("returns words, unique and top for a mixed text", () => {
+  assert.deepEqual(summary("the quick brown fox the fox the"), {
+    words: 7,
+    unique: 4,
+    top: [
+      ["the", 3],
+      ["fox", 2],
+      ["brown", 1],
+    ],
+  });
+});
+
+test("unique counts distinct words, top breaks ties alphabetically", () => {
+  assert.deepEqual(summary("banana apple cherry apple banana cherry"), {
+    words: 6,
+    unique: 3,
+    top: [
+      ["apple", 2],
+      ["banana", 2],
+      ["cherry", 2],
+    ],
+  });
+});
+
+test("returns zeros and an empty top for text with no words", () => {
+  assert.deepEqual(summary("   ...  !! "), {
+    words: 0,
+    unique: 0,
+    top: [],
+  });
+});
+
+test("throws a TypeError for non-string input", () => {
+  assert.throws(() => summary(42), TypeError);
+  assert.throws(() => summary(null), TypeError);
+});
diff --git a/tests/tokenize.test.mjs b/tests/tokenize.test.mjs
new file mode 100644
index 0000000..27308a3
--- /dev/null
+++ b/tests/tokenize.test.mjs
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { tokenize } from "../src/text.mjs";
+
+test("splits words in order, lower-cased", () => {
+  assert.deepEqual(tokenize("The Quick Brown Fox"), [
+    "the",
+    "quick",
+    "brown",
+    "fox",
+  ]);
+});
+
+test("strips surrounding punctuation", () => {
+  assert.deepEqual(tokenize("Hello, world! Isn't it nice?"), [
+    "hello",
+    "world",
+    "isn't",
+    "it",
+    "nice",
+  ]);
+});
+
+test("keeps an apostrophe inside a word as one word", () => {
+  assert.deepEqual(tokenize("don't stop"), ["don't", "stop"]);
+});
+
+test("treats a typographic apostrophe as an apostrophe", () => {
+  assert.deepEqual(tokenize("it’s it's"), ["it's", "it's"]);
+});
+
+test("strips a standalone or quoting apostrophe", () => {
+  assert.deepEqual(tokenize("'quoted' words"), ["quoted", "words"]);
+});
+
+test("returns an empty array for text with no words", () => {
+  assert.deepEqual(tokenize("   ...  !! "), []);
+});
+
+test("throws a TypeError for non-string input", () => {
+  assert.throws(() => tokenize(42), TypeError);
+  assert.throws(() => tokenize(null), TypeError);
+  assert.throws(() => tokenize(undefined), TypeError);
+});
