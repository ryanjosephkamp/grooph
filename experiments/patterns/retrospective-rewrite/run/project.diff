--- a/src/interval.mjs
+++ b/src/interval.mjs
@@ -10,3 +10,28 @@ function check(interval) {
     throw new TypeError("an interval is [start, end] with integer start <= end");
   }
 }
+
+/**
+ * Returns the sorted, non-overlapping closed integer intervals covering the
+ * same integers as the input. Touching intervals (sharing an endpoint) and
+ * adjacent intervals (e.g. [1, 2] and [3, 4], whose endpoints are consecutive
+ * integers) are merged into one. Does not modify the input.
+ */
+export function mergeIntervals(intervals) {
+  if (!Array.isArray(intervals)) {
+    throw new TypeError("intervals must be an array of [start, end] intervals");
+  }
+  intervals.forEach(check);
+
+  const sorted = intervals.map(([start, end]) => [start, end]).sort((a, b) => a[0] - b[0] || a[1] - b[1]);
+  const merged = [];
+  for (const [start, end] of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && start <= last[1] + 1) {
+      last[1] = Math.max(last[1], end);
+    } else {
+      merged.push([start, end]);
+    }
+  }
+  return merged;
+}
