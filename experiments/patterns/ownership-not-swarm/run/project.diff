@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { renderTable } from "./table.mjs";
+
+const notes = [
+  { id: 1, text: "buy milk", tags: ["errand"] },
+  { id: 2, text: "call Sam, then Ann", tags: ["errand", "phone"] },
+  { id: 3, text: "untagged", tags: [] },
+];
+
+test("header normalises to 'id | text | tags'", () => {
+  const output = renderTable([]);
+  const [header] = output.trimEnd().split("\n");
+  assert.equal(header, "id | text | tags");
+});
+
+test("line count is header + rows", () => {
+  const output = renderTable(notes);
+  const lines = output.trimEnd().split("\n");
+  assert.equal(lines.length, notes.length + 1);
+});
+
+test("all lines have equal length", () => {
+  const output = renderTable(notes);
+  const lines = output.replace(/\n$/, "").split("\n");
+  const lengths = new Set(lines.map((line) => line.length));
+  assert.equal(lengths.size, 1);
+});
+
+test("a row contains joined tags for a multi-tag note", () => {
+  const output = renderTable(notes);
+  assert.match(output, /errand,phone/);
+});
+
+test("a note with no tags renders an empty (padded) tags cell", () => {
+  const output = renderTable(notes);
+  const lines = output.trimEnd().split("\n");
+  const untaggedLine = lines.find((line) => line.startsWith("3"));
+  assert.ok(untaggedLine);
+  assert.match(untaggedLine, /\|\s*$/);
+});
+
+test("empty input renders the header only", () => {
+  const output = renderTable([]);
+  const lines = output.trimEnd().split("\n");
+  assert.deepEqual(lines, ["id | text | tags"]);
+});
diff --git a/src/index.mjs b/src/index.mjs
