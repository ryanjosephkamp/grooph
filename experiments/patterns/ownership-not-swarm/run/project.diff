+++ b/src/index.mjs
@@ -0,0 +1,15 @@
+import { createStore } from "./db/store.mjs";
+import { createHandler } from "./api/handle.mjs";
+import { renderTable } from "./format/table.mjs";
+import { exportCsv } from "./export/csv.mjs";
+
+/**
+ * The wired application: `handle` is the API over a fresh store (one per
+ * call, so apps are independent); `renderTable` and `exportCsv` render the
+ * array of `{ id, text, tags }` that `GET /notes` returns.
+ */
+export function createApp() {
+  const store = createStore();
+  const handle = createHandler(store);
+  return { handle, renderTable, exportCsv };
+}
