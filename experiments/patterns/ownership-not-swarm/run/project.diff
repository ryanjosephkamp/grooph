--- /dev/null
+++ b/src/export/csv.mjs
@@ -0,0 +1,14 @@
+function quoteText(text) {
+  if (/[",\n]/.test(text)) {
+    return `"${text.replace(/"/g, '""')}"`;
+  }
+  return text;
+}
+
+export function exportCsv(notes) {
+  const lines = ["id,text,tags"];
+  for (const { id, text, tags } of notes) {
+    lines.push(`${id},${quoteText(text)},${tags.join(";")}`);
+  }
+  return lines.join("\n") + "\n";
+}
