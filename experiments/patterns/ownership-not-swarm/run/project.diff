+++ b/src/db/store.mjs
@@ -1,18 +1,49 @@
+const TAG_PATTERN = /^[a-z0-9-]+$/;
+
 /** A fresh in-memory store. */
 export function createStore() {
   return { notes: [], nextId: 1 };
 }
 
-/** Adds a note and returns it. */
+/** Copy of a stored note, with its own `tags` array. */
+function copyNote(note) {
+  return { id: note.id, text: note.text, tags: [...note.tags] };
+}
+
+/** Adds a note `{ id, text, tags: [] }` and returns a copy of it. */
 export function addNote(store, text) {
   if (typeof text !== "string" || text.trim() === "") throw new TypeError("addNote: text must be a non-empty string");
-  const note = { id: store.nextId, text };
+  const note = { id: store.nextId, text, tags: [] };
   store.nextId += 1;
   store.notes.push(note);
-  return note;
+  return copyNote(note);
 }
 
-/** All notes, oldest first, as copies. */
+/** All notes, oldest first, as copies (each with a copied `tags` array). */
 export function listNotes(store) {
-  return store.notes.map((note) => ({ ...note }));
+  return store.notes.map(copyNote);
+}
+
+/**
+ * Adds `tag` to the note with `id` and returns a copy of the updated note.
+ * Checks the tag first (TypeError when not a string or not /^[a-z0-9-]+$/),
+ * then looks up the id (RangeError when unknown). Idempotent; `tags` stays sorted.
+ */
+export function tagNote(store, id, tag) {
+  if (typeof tag !== "string" || !TAG_PATTERN.test(tag)) throw new TypeError("tagNote: tag must match /^[a-z0-9-]+$/");
+  const note = store.notes.find((n) => n.id === id);
+  if (note === undefined) throw new RangeError(`tagNote: no note with id ${id}`);
+  if (!note.tags.includes(tag)) {
+    note.tags.push(tag);
+    note.tags.sort();
+  }
+  return copyNote(note);
+}
+
+/**
+ * Notes carrying `tag`, oldest first, as copies. Does not validate `tag`:
+ * any tag no note carries (including a malformed one) yields `[]`.
+ */
+export function notesByTag(store, tag) {
+  return store.notes.filter((n) => n.tags.includes(tag)).map(copyNote);
 }
