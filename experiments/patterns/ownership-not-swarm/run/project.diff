diff --git a/src/format/table.mjs b/src/format/table.mjs
new file mode 100644
index 0000000..5320168
--- /dev/null
+++ b/src/format/table.mjs
@@ -0,0 +1,19 @@
+export function renderTable(notes) {
+  const headers = ["id", "text", "tags"];
+  const rows = notes.map((note) => [
+    String(note.id),
+    note.text,
+    note.tags.join(","),
+  ]);
+
+  const widths = headers.map((header, col) =>
+    rows.reduce((max, row) => Math.max(max, row[col].length), header.length),
+  );
+
+  const formatLine = (cells) =>
+    cells.map((cell, col) => cell.padEnd(widths[col])).join(" | ");
+
+  const lines = [formatLine(headers), ...rows.map(formatLine)];
+
+  return lines.join("\n") + "\n";
+}
diff --git a/src/format/table.test.mjs b/src/format/table.test.mjs
