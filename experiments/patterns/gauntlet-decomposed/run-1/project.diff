 /**
- * The card's header: the title, the period, and one tile per headline stat.
- * Returns SVG fragments positioned inside the card.
+ * The card's header: the title, the period, and one grey tile per headline
+ * stat. Each tile carries a small upper-case label, the value in a compact
+ * form, and the change against the previous period, colour-signed. The three
+ * tiles share one row of baselines and span the inner width, margin to margin.
  */
+import { compactValue, escapeText, signedChange } from "./format.mjs";
+
+const MARGIN = 24; // content runs x = 24 … 616
+const TILE_WIDTH = 192;
+const TILE_PITCH = 200; // 192 wide + 8 gap
+const TILE_TOP = 84;
+const TILE_HEIGHT = 96;
+const TEXT_INSET = 16; // text sits 16 in from the tile's left edge
+
+const LABEL_BASELINE = 108;
+const VALUE_BASELINE = 146;
+const CHANGE_BASELINE = 166;
+
+const INK = "#1f2933";
+const MUTED = "#6b7280";
+const TILE_GREY = "#f3f4f6";
+
 export function renderHeader(data) {
-  const lines = [`<text x="10" y="20" font-size="16">${data.title}</text>`, `<text x="10" y="36" font-size="12">${data.period}</text>`];
+  const lines = [
+    `<text x="${MARGIN}" y="40" font-size="20" font-weight="600" fill="${INK}">${escapeText(data.title)}</text>`,
+    `<text x="${MARGIN}" y="60" font-size="12" fill="${MUTED}">${escapeText(data.period)}</text>`,
+  ];
+
   data.stats.forEach((stat, i) => {
-    lines.push(`<text x="10" y="${60 + i * 16}" font-size="12">${stat.label}: ${stat.value} (${stat.delta})</text>`);
+    const tileX = MARGIN + i * TILE_PITCH;
+    const textX = tileX + TEXT_INSET;
+    const change = signedChange(stat.delta);
+    // data-label keeps the stat's own wording on the element while the tile
+    // shows it in capitals; it is not drawn.
+    const labelAttr = escapeText(stat.label).replace(/"/g, "&quot;");
+    lines.push(
+      `<rect x="${tileX}" y="${TILE_TOP}" width="${TILE_WIDTH}" height="${TILE_HEIGHT}" rx="8" fill="${TILE_GREY}"/>`,
+      `<text x="${textX}" y="${LABEL_BASELINE}" font-size="11" font-weight="600" fill="${MUTED}" letter-spacing="0.6" data-label="${labelAttr}">${escapeText(String(stat.label).toUpperCase())}</text>`,
+      `<text x="${textX}" y="${VALUE_BASELINE}" font-size="28" font-weight="700" fill="${INK}">${escapeText(compactValue(stat.value, stat.unit))}</text>`,
+      `<text x="${textX}" y="${CHANGE_BASELINE}" font-size="12" font-weight="600" fill="${change.fill}">${change.text}</text>`,
+    );
   });
+
   return lines.join("");
 }
