+- header · text (240,108) 11px weight=600 anchor=– fill=#6b7280: "ORDERS"
+- header · text (240,146) 28px weight=700 anchor=– fill=#1f2933: "38.2k"
+- header · text (240,166) 12px weight=600 anchor=– fill=#c62828: "▼ 3.1% vs prior period"
+- header · rect x=424 y=84 w=192 h=96 rx=8 fill=#f3f4f6 stroke=–
