+/**
+ * Shared number formatting for the card: the compact value a reader can say
+ * aloud ($1.42M, 38.2k, $37.24) and the signed change against the previous
+ * period. Everything is derived from the numbers in data/summary.json; no
+ * string in here is specific to one group's data.
+ */
+
+/** Rise green / fall red, from the shared palette. */
+export const RISE = "#1a7f37";
+export const FALL = "#c62828";
+
+/**
+ * A compact, sayable form of `value` for the given `unit`.
+ * - `usd`   → $1.42M (≥ 1e6, 2 dp) · $142.3k (≥ 1e3, 1 dp) · $842
+ * - `count` → 1.42M · 38.2k · 842
+ * - `cents` → $37.24 (always exactly 2 dp)
+ * Never a raw integer for big numbers, never a thousands separator.
+ */
+export function compactValue(value, unit) {
+  const number = Number(value);
+  if (unit === "cents") return `${number < 0 ? "-" : ""}$${Math.abs(number / 100).toFixed(2)}`;
+  const prefix = `${number < 0 ? "-" : ""}${unit === "usd" ? "$" : ""}`;
+  const magnitude = Math.abs(number);
+  if (magnitude >= 1e6) return `${prefix}${(magnitude / 1e6).toFixed(2)}M`;
+  if (magnitude >= 1e3) return `${prefix}${(magnitude / 1e3).toFixed(1)}k`;
+  return `${prefix}${Math.round(magnitude)}`;
+}
+
+/**
+ * The change line for a delta expressed as a fraction: mark, the magnitude as
+ * a percentage to one decimal, and what it is measured against.
+ * 0.124 → { text: "▲ 12.4% vs prior period", fill: "#1a7f37" }
+ */
+export function signedChange(delta) {
+  const fraction = Number(delta);
+  const up = fraction >= 0;
+  return {
+    text: `${up ? "▲" : "▼"} ${(Math.abs(fraction) * 100).toFixed(1)}% vs prior period`,
+    fill: up ? RISE : FALL,
+  };
+}
+
+/** XML-escape a text node so any group's title or label renders as written. */
+export function escapeText(value) {
+  return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+}
