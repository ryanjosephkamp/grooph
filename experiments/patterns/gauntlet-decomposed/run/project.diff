@@ -0,0 +1,36 @@
+/**
+ * Compact, speakable value and change formatting. Shared by the header and,
+ * later, the trend.
+ */
+
+/** Scale a number to millions or thousands with a suffix; below 1000 keep it whole. */
+function scaled(n, digitsM, digitsK) {
+  const abs = Math.abs(n);
+  if (abs >= 1e6) return `${(n / 1e6).toFixed(digitsM)}M`;
+  if (abs >= 1e3) return `${(n / 1e3).toFixed(digitsK)}k`;
+  return String(Math.round(n));
+}
+
+/** A value in its compact spoken form, derived from its unit: $1.42M, 38.2k, $37.24. */
+export function formatValue(value, unit) {
+  switch (unit) {
+    case "usd":
+      return `$${scaled(value, 2, 1)}`;
+    case "cents": {
+      const dollars = value / 100;
+      return dollars >= 1000 ? `$${scaled(dollars, 2, 1)}` : `$${dollars.toFixed(2)}`;
+    }
+    default:
+      return scaled(value, 2, 1);
+  }
+}
+
+/** The absolute change as a percentage to one decimal place: 0.124 -> "12.4%". */
+export function formatPercent(delta) {
+  return `${(Math.round(Math.abs(delta) * 1000) / 10).toFixed(1)}%`;
+}
+
+/** Escape text for use inside SVG. */
+export function escapeXml(s) {
+  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+}
