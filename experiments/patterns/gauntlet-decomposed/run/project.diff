+/**
+ * Shared card geometry, defined once. The header and the trend read these
+ * instead of repeating numbers.
+ */
+export const WIDTH = 640;
+export const HEIGHT = 360;
+
+/** The one outer margin: nothing on the card comes closer to an edge than this. */
+export const MARGIN = 32;
+
+/** The width left between the left and right margins. */
+export const INNER_WIDTH = WIDTH - 2 * MARGIN;
+
+/** The card's border: a hairline, drawn fully inside the card so it is never clipped. */
+export const BORDER_WIDTH = 1;
+export const BORDER_COLOR = "#e5e7eb";
+export const CORNER_RADIUS = 12;
