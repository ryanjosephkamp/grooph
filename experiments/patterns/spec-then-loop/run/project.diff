+++ b/src/wrap.mjs
@@ -0,0 +1,37 @@
+/**
+ * Wraps `text` to lines of at most `width` characters.
+ *
+ * Words are runs of characters that are not whitespace; every run of
+ * whitespace in the input (spaces, tabs, newlines) is a separator and is not
+ * preserved. Wrapping is greedy: each line holds as many whole words as fit.
+ * A word longer than `width` is never broken; it sits alone on its own line.
+ *
+ * @param {string} text
+ * @param {number} width
+ * @returns {string}
+ */
+export function wrap(text, width) {
+  if (typeof text !== "string") throw new TypeError("wrap: text must be a string");
+  if (!Number.isInteger(width) || width < 1) {
+    throw new TypeError("wrap: width must be an integer >= 1");
+  }
+
+  const trimmed = text.trim();
+  if (trimmed === "") return "";
+
+  const words = trimmed.split(/\s+/);
+  const lines = [];
+  let line = words[0];
+
+  for (const word of words.slice(1)) {
+    if (line.length + 1 + word.length <= width) {
+      line += " " + word;
+    } else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  lines.push(line);
+
+  return lines.join("\n");
+}
diff --git a/tests/wrap.test.mjs b/tests/wrap.test.mjs
new file mode 100644
index 0000000..f79341f
--- /dev/null
+++ b/tests/wrap.test.mjs
@@ -0,0 +1,81 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { wrap } from "../src/wrap.mjs";
+
+test("wrap rejects a non-string text", () => {
+  assert.throws(() => wrap(42, 10), TypeError);
+  assert.throws(() => wrap(undefined, 10), TypeError);
+  assert.throws(() => wrap(["a"], 10), TypeError);
+});
+
+test("wrap rejects a width that is not an integer >= 1", () => {
+  assert.throws(() => wrap("hi", 0), TypeError);
+  assert.throws(() => wrap("hi", -3), TypeError);
+  assert.throws(() => wrap("hi", 2.5), TypeError);
+  assert.throws(() => wrap("hi", "10"), TypeError);
+  assert.throws(() => wrap("hi", NaN), TypeError);
+  assert.throws(() => wrap("hi", Infinity), TypeError);
+  assert.doesNotThrow(() => wrap("hi", 1));
+});
+
+test("wrap returns a string", () => {
+  assert.equal(typeof wrap("the quick brown fox", 10), "string");
+});
+
+test("wrap treats runs of spaces, tabs and newlines as separators", () => {
+  assert.equal(wrap("one  two\tthree\nfour", 40), "one two three four");
+  assert.equal(wrap("a \t\n b", 40), "a b");
+});
+
+test("wrap is greedy", () => {
+  assert.equal(wrap("the quick brown fox", 10), "the quick\nbrown fox");
+  assert.equal(wrap("a b c d e f", 3), "a b\nc d\ne f");
+  assert.equal(wrap("aa bb cc", 5), "aa bb\ncc");
+});
+
+test("wrap keeps every line within width when words fit", () => {
+  const text = "the quick brown fox jumps over the lazy dog";
+  for (const width of [5, 8, 10, 12, 20, 43]) {
+    for (const line of wrap(text, width).split("\n")) {
+      assert.ok(line.length <= width, `line ${JSON.stringify(line)} exceeds ${width}`);
+    }
+  }
+});
+
+test("wrap puts an over-long word alone on its own line, unbroken", () => {
+  assert.equal(wrap("a extraordinarily b", 5), "a\nextraordinarily\nb");
+  assert.equal(wrap("extraordinarily", 5), "extraordinarily");
+  assert.equal(wrap("hello world", 3), "hello\nworld");
+});
+
+test("wrap has no leading or trailing whitespace and no trailing newline", () => {
+  const out = wrap("   the quick brown fox   ", 10);
+  assert.equal(out, "the quick\nbrown fox");
+  assert.equal(out, out.trim());
+  assert.ok(!out.endsWith("\n"));
+});
+
+test("wrap joins lines with a single newline", () => {
+  assert.equal(wrap("aaa bbb ccc", 3), "aaa\nbbb\nccc");
+  assert.ok(!wrap("aaa bbb ccc", 3).includes("\n\n"));
+});
+
+test("wrap returns the empty string for empty or whitespace-only input", () => {
+  assert.equal(wrap("", 10), "");
+  assert.equal(wrap("   ", 10), "");
+  assert.equal(wrap("\t\n  \n", 10), "");
+});
+
+test("wrap returns one line when the text already fits", () => {
+  assert.equal(wrap("the quick brown fox", 40), "the quick brown fox");
+  assert.equal(wrap("  the   quick  ", 40), "the quick");
+  assert.equal(wrap("exact", 5), "exact");
+});
+
+test("wrap preserves all words in order", () => {
+  const text = "alpha beta gamma delta epsilon zeta eta theta";
+  for (const width of [1, 2, 6, 9, 15, 100]) {
+    assert.equal(wrap(text, width).split("\n").join(" "), text);
+  }
+});
