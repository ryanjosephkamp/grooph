 /**
  * Renders the monthly revenue bar chart as an SVG string.
+ *
+ * Layout follows STYLE.md: a title, a subtitle naming the unit and scale,
+ * twelve named bars in one accent colour, horizontal gridlines at round values
+ * with compact labels, a visible baseline, one value callout on the peak
+ * month, neutral greys for everything else, and no decoration.
+ *
  * @param {{ title: string, unit: string, months: string[], values: number[] }} data
  */
 export function renderChart(data) {
-  const width = 600;
-  const height = 300;
+  const width = 640;
+  const height = 400;
+  const margin = { top: 60, right: 24, bottom: 44, left: 64 };
+  const plot = {
+    x: margin.left,
+    y: margin.top,
+    w: width - margin.left - margin.right,
+    h: height - margin.top - margin.bottom,
+  };
+
+  const font = "font-family=\"Helvetica Neue, Helvetica, Arial, sans-serif\"";
+  const colour = {
+    background: "#ffffff",
+    accent: "#2f6db5",
+    title: "#222222",
+    subtitle: "#777777",
+    label: "#555555",
+    grid: "#d9d9d9",
+    baseline: "#444444",
+  };
+
   const max = Math.max(...data.values);
-  const barWidth = width / data.values.length;
+  const ticks = niceTicks(max);
+  const top = ticks[ticks.length - 1];
+  const scaleY = (v) => plot.y + plot.h - (v / top) * plot.h;
+  const crisp = (v) => Math.round(v) + 0.5;
+
+  // Explicit white background so the chart keeps its own page colour when it
+  // is placed on a tinted report page.
+  const background = `<rect x="0" y="0" width="${width}" height="${height}" fill="${colour.background}"/>`;
+
+  // Title names what the chart shows; the subtitle names the unit and the
+  // scale the tick labels are in.
+  const title = `<text x="${plot.x}" y="28" ${font} font-size="18" font-weight="600" fill="${colour.title}">${escape(data.title)}</text>`;
+  const subtitle = `<text x="${plot.x}" y="47" ${font} font-size="12" fill="${colour.subtitle}">${escape(data.unit)}, thousands</text>`;
+
+  const grid = ticks
+    .map((t) => {
+      const y = crisp(scaleY(t));
+      const isBase = t === 0;
+      const line = isBase
+        ? ""
+        : `<line x1="${plot.x}" y1="${y}" x2="${plot.x + plot.w}" y2="${y}" stroke="${colour.grid}" stroke-width="1"/>`;
+      const label = `<text x="${plot.x - 10}" y="${y + 4}" ${font} font-size="11" fill="${colour.label}" text-anchor="end">${compact(t)}</text>`;
+      return line + label;
+    })
+    .join("");
+
+  // Bars fill the plot edge to edge with a gap of about a third of a bar:
+  // the first bar starts at the plot's left edge, the last ends at its right.
+  const n = data.values.length;
