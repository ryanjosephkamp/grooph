@@ -0,0 +1,40 @@
+// The shape formatSeconds writes, read a little more generously: h, m, s and
+// ms parts, in that order, each at most once. A part is a number followed
+// directly by its unit; the number is a run of ASCII digits with an optional
+// fraction that has digits on both sides of the point ("1", "1.5", not ".5"
+// or "5."). Units are matched regardless of letter case. Whitespace may
+// separate parts and may surround the whole text (trimmed before matching),
+// but not sit between a number and its unit. Signs, exponents, other
+// separators and other units are not part of the grammar.
+const NUMBER = "[0-9]+(?:\\.[0-9]+)?";
+const DURATION = new RegExp(
+  `^(?:(${NUMBER})h)?\\s*(?:(${NUMBER})m)?\\s*(?:(${NUMBER})s)?\\s*(?:(${NUMBER})ms)?$`,
+  "i",
+);
+
+/**
+ * Reads a duration written by formatSeconds ("1h30m", "45s", "500ms") back
+ * into a number of seconds. Units are h, m, s and ms, in that order, each at
+ * most once; at least one part must be present. Letter case does not matter,
+ * each number may carry a fraction ("1.5h"), and whitespace is allowed
+ * around the text and between parts ("1h 30m") but not inside a part.
+ * @param {string} text
+ * @returns {number} seconds
+ * @throws {TypeError} when text is not a string
+ * @throws {RangeError} when text is not a duration in that shape
+ */
+export function parseDuration(text) {
+  if (typeof text !== "string") throw new TypeError("parseDuration: text must be a string");
+  const trimmed = text.trim();
+  const match = DURATION.exec(trimmed);
+  if (match === null || trimmed === "") {
+    throw new RangeError(`parseDuration: not a duration: ${JSON.stringify(text)}`);
+  }
+  const [, h = "0", m = "0", s = "0", ms = "0"] = match;
+  // Sum in milliseconds so "1m1s" comes back as exactly 61, not 61.00000000000001.
+  const total = Number(h) * 3_600_000 + Number(m) * 60_000 + Number(s) * 1000 + Number(ms);
+  if (!Number.isFinite(total)) {
+    throw new RangeError(`parseDuration: duration is too large: ${JSON.stringify(text)}`);
+  }
+  return total / 1000;
+}
