diff --git a/src/slugify.mjs b/src/slugify.mjs
index 35d7584..9eba543 100644
--- a/src/slugify.mjs
+++ b/src/slugify.mjs
@@ -1,7 +1,8 @@
 /**
  * Turns a title into a URL slug: lowercase ASCII letters and digits, in words
  * joined by single hyphens, at most `maxLength` characters long. Accents are
- * dropped ("é" becomes "e"); anything else that is not a letter or a digit
+ * dropped ("é" becomes "e"); `&`, `@` and `%` are spelled out as the words
+ * "and", "at" and "percent"; anything else that is not a letter or a digit
  * separates words.
  *
  * @param {string} text
@@ -14,7 +15,13 @@ export function slugify(text, { maxLength = 48 } = {}) {
     .normalize("NFKD")
     .replace(/[̀-ͯ]/g, "")
     .toLowerCase()
+    .replace(/&/g, " and ")
+    .replace(/@/g, " at ")
+    .replace(/%/g, " percent ")
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
-  return slug.slice(0, maxLength);
+  // Slicing to maxLength can land in the middle of a word or right after a
+  // hyphen, leaving a trailing hyphen behind; strip it so the result still
+  // satisfies "never starts or ends with a hyphen" and stays idempotent.
+  return slug.slice(0, Math.max(0, maxLength)).replace(/^-+|-+$/g, "");
 }
diff --git a/tests/slugify.test.mjs b/tests/slugify.test.mjs
index df89ae8..32259a2 100644
--- a/tests/slugify.test.mjs
+++ b/tests/slugify.test.mjs
@@ -20,3 +20,44 @@ test("a long title is cut to maxLength", () => {
 test("text that is not a string throws a TypeError", () => {
   assert.throws(() => slugify(42), TypeError);
 });
+
+test("&, @ and % are spelled out as words", () => {
+  assert.equal(slugify("Fish & Chips"), "fish-and-chips");
+  assert.equal(slugify("100% Cotton"), "100-percent-cotton");
+  assert.equal(slugify("me@example.com"), "me-at-example-com");
+});
+
+test("slug never starts or ends with a hyphen even after truncation", () => {
+  // "abc-def" truncated to 4 chars would naively be "abc-"; the trailing
+  // hyphen must be stripped.
+  assert.equal(slugify("abc def ghi", { maxLength: 4 }), "abc");
+  assert.equal(slugify("&&&hello&&&", { maxLength: 3 }), "and");
+});
+
+test("slugify is idempotent for a range of inputs and maxLengths", () => {
+  const samples = [
+    "Fish & Chips",
+    "100% Cotton",
+    "me@example.com",
+    "  many   spaces  ",
+    "Crème Brûlée, Twice!",
+    "&&&hello&&&",
+    "@@@",
+    "%%%",
+    "---",
+    "",
+    "a",
+    "a-b-c-d-e-f-g-h",
+    "x".repeat(100),
+  ];
+  const lengths = [1, 2, 3, 4, 5, 8, 48];
+  for (const text of samples) {
+    for (const maxLength of lengths) {
+      const once = slugify(text, { maxLength });
+      assert.ok(/^[a-z0-9]+(-[a-z0-9]+)*$/.test(once) || once === "", `unexpected characters in ${JSON.stringify(once)}`);
+      assert.ok(once.length <= maxLength);
+      const twice = slugify(once, { maxLength });
+      assert.equal(twice, once, `not idempotent for ${JSON.stringify(text)} maxLength=${maxLength}`);
+    }
+  }
+});
