@@ -5,30 +5,92 @@ export class CsvError extends Error {
   }
 }
 
+const QUOTE = 0x22; // "
+const COMMA = 0x2c; // ,
+const LF = 0x0a; // \n
+const CR = 0x0d; // \r
+
 /**
- * Parses one CSV record into its fields (README.md). Handles the plain and the
- * quoted case; the rest of the contract is not enforced yet.
+ * Parses one CSV record into its fields, following README.md § Contract.
+ *
+ * Single forward pass over the string, indexed by position, so the cost is
+ * linear in the length of the text. Returns an array of strings or throws
+ * CsvError; a non-string argument throws TypeError.
+ *
  * @param {string} text
  * @returns {string[]}
  */
 export function parseCsvLine(text) {
-  if (typeof text !== "string") throw new TypeError("parseCsvLine: text must be a string");
+  if (typeof text !== "string") {
+    throw new TypeError("parseCsvLine: text must be a string");
+  }
+
+  // One record terminator (`\n` or `\r\n`) at the very end is removed. Any
+  // other unquoted `\r` or `\n` is rejected while scanning below. Removing it
+  // up front is equivalent: a terminator that sits inside quotes at the very
+  // end of the text can never be followed by its closing quote, so that input
+  // is an unclosed quote either way.
+  let end = text.length;
+  if (end > 0 && text.charCodeAt(end - 1) === LF) {
+    end -= 1;
+    if (end > 0 && text.charCodeAt(end - 1) === CR) end -= 1;
+  }
+
   const fields = [];
-  let field = "";
-  let quoted = false;
-  let rest = text;
-  while (rest.length > 0) {
-    const ch = rest[0];
-    rest = rest.slice(1);
-    if (ch === '"') {
-      quoted = !quoted;
-    } else if (ch === "," && !quoted) {
+  let i = 0;
+
+  // Each iteration parses exactly one field starting at `i` and either
+  // returns (end of text) or advances `i` past the separating comma.
+  for (;;) {
+    if (i < end && text.charCodeAt(i) === QUOTE) {
+      // Quoted field: `""` is one `"`; everything else up to the closing
+      // quote, including commas, `\r` and `\n`, is literal.
+      let field = "";
+      let segStart = i + 1;
+      let close;
+      for (;;) {
+        const q = text.indexOf('"', segStart);
+        if (q === -1 || q >= end) {
+          throw new CsvError(`unclosed quoted field starting at index ${i}`);
+        }
+        field += text.slice(segStart, q);
+        if (q + 1 < end && text.charCodeAt(q + 1) === QUOTE) {
+          field += '"';
+          segStart = q + 2;
+          continue;
+        }
+        close = q;
+        break;
+      }
       fields.push(field);
-      field = "";
+      i = close + 1;
+      if (i === end) return fields;
+      if (text.charCodeAt(i) !== COMMA) {
+        throw new CsvError(
+          `unexpected character ${JSON.stringify(text[i])} after closing quote at index ${i}`,
+        );
+      }
+      i += 1;
     } else {
-      field += ch;
+      // Unquoted field: runs to the next comma or the end. A `"`, `\r` or
+      // `\n` anywhere in it is an error; every other character is literal.
+      let j = i;
+      while (j < end) {
+        const c = text.charCodeAt(j);
+        if (c === COMMA) break;
+        if (c === QUOTE) {
+          throw new CsvError(`unexpected '"' outside quotes at index ${j}`);
+        }
+        if (c === LF || c === CR) {
+          throw new CsvError(
+            `unexpected ${c === LF ? "\\n" : "\\r"} outside quotes at index ${j}`,
+          );
+        }
+        j += 1;
+      }
+      fields.push(text.slice(i, j));
+      if (j === end) return fields;
+      i = j + 1;
     }
   }
-  fields.push(field);
-  return fields;
 }
