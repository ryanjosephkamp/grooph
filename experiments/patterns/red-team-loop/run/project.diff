+// --- Never throws anything else ----------------------------------------------
+
+test("only string[] or CsvError for arbitrary strings", () => {
+  const alphabet = ['a', ',', '"', '\n', '\r', ' ', '\t'];
+  let state = 12345;
+  const rnd = () => (state = (state * 1103515245 + 12345) & 0x7fffffff) % alphabet.length;
+  for (let n = 0; n < 5000; n++) {
+    const len = n % 12;
+    let s = "";
+    for (let k = 0; k < len; k++) s += alphabet[rnd()];
+    try {
+      const out = parseCsvLine(s);
+      assert.ok(Array.isArray(out), `not an array for ${JSON.stringify(s)}`);
+      assert.ok(out.length >= 1);
+      for (const f of out) assert.equal(typeof f, "string");
+    } catch (e) {
+      assert.ok(e instanceof CsvError, `threw ${e?.constructor?.name} for ${JSON.stringify(s)}`);
+    }
+  }
+});
+
+// --- Performance -------------------------------------------------------------
+
+function timed(label, fn) {
+  const t0 = performance.now();
+  const out = fn();
+  const ms = performance.now() - t0;
+  assert.ok(ms < 1000, `${label} took ${ms.toFixed(1)} ms`);
+  return out;
+}
+
+test("a 100 KB record returns within a second", () => {
+  const KB100 = 100 * 1024;
+
+  // One huge unquoted field.
+  const big = "x".repeat(KB100);
+  assert.deepEqual(timed("one unquoted field", () => parseCsvLine(big)), [big]);
+
+  // One huge quoted field.
+  assert.deepEqual(timed("one quoted field", () => parseCsvLine(`"${big}"`)), [big]);
+
+  // Many small fields.
+  const many = "ab,".repeat(Math.ceil(KB100 / 3));
+  const out = timed("many fields", () => parseCsvLine(many));
+  assert.equal(out.length, Math.ceil(KB100 / 3) + 1);
+
+  // Only commas: 100 K empty fields.
+  assert.equal(timed("only commas", () => parseCsvLine(",".repeat(KB100))).length, KB100 + 1);
+
+  // Quoted field full of escaped quotes.
+  const escaped = '"' + '""'.repeat(KB100 / 2) + '"';
+  assert.deepEqual(timed("escaped quotes", () => parseCsvLine(escaped)), ['"'.repeat(KB100 / 2)]);
+
+  // Many small quoted fields.
+  const manyQuoted = '"a",'.repeat(KB100 / 4);
+  assert.equal(timed("many quoted fields", () => parseCsvLine(manyQuoted)).length, KB100 / 4 + 1);
+
+  // Quoted field full of newlines.
+  const newlines = '"' + "\r\n".repeat(KB100 / 2) + '"';
+  assert.deepEqual(timed("quoted newlines", () => parseCsvLine(newlines)), ["\r\n".repeat(KB100 / 2)]);
+
+  // Errors are found fast too: unclosed quote at the start, stray quote at the end.
+  timed("unclosed quote", () => csvError(() => parseCsvLine('"' + big)));
+  timed("stray quote at end", () => csvError(() => parseCsvLine(big + '"')));
+  timed("bad char after closing quote", () => csvError(() => parseCsvLine(`"${big}"x`)));
 });
