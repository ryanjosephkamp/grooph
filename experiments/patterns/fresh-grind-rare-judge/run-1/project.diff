+++ b/tests/evaluate.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { evaluate } from "../src/evaluate.mjs";
+
+test("the required cases from the phase 2 entry", () => {
+  assert.equal(evaluate("1 + 2 * 3"), 7);
+  assert.equal(evaluate("(1 + 2) * 3"), 9);
+  assert.equal(evaluate("2 ^ 3 ^ 2"), 512);
+  assert.equal(evaluate("-2 ^ 2"), -4);
+  assert.equal(evaluate("10 / 4"), 2.5);
+  assert.throws(() => evaluate("1 / 0"), RangeError);
+  assert.throws(() => evaluate("1 +"), SyntaxError);
+});
+
+test("precedence and associativity", () => {
+  assert.equal(evaluate("2 + 3 * 4"), 14);
+  assert.equal(evaluate("2 * 3 + 4"), 10);
+  assert.equal(evaluate("10 - 2 - 3"), 5);
+  assert.equal(evaluate("20 / 2 / 5"), 2);
+  assert.equal(evaluate("2 ^ 2 * 3"), 12);
+  assert.equal(evaluate("(2 + 3) ^ 2"), 25);
+});
+
+test("unary minus binds tighter than * and / but looser than ^", () => {
+  assert.equal(evaluate("-2 * 3"), -6);
+  assert.equal(evaluate("-2 ^ 2"), -4);
+  assert.equal(evaluate("2 ^ -2"), 0.25);
+  assert.equal(evaluate("-(2 + 3)"), -5);
+  assert.equal(evaluate("5 - -2"), 7);
+  assert.equal(evaluate("- - 2"), 2);
+  assert.equal(evaluate("- - - 2"), -2);
+});
+
+test("division by zero is a RangeError, including 0 / 0", () => {
+  assert.throws(() => evaluate("1 / 0"), RangeError);
+  assert.throws(() => evaluate("0 / 0"), RangeError);
+  assert.throws(() => evaluate("1 / (2 - 2)"), RangeError);
+});
+
+test("malformed expressions are SyntaxErrors", () => {
+  assert.throws(() => evaluate(""), SyntaxError);
+  assert.throws(() => evaluate("   "), SyntaxError);
+  assert.throws(() => evaluate("1 +"), SyntaxError);
+  assert.throws(() => evaluate("+ 1"), SyntaxError);
+  assert.throws(() => evaluate("1 + + 2"), SyntaxError);
+  assert.throws(() => evaluate("1 2"), SyntaxError);
+  assert.throws(() => evaluate("(1 + 2"), SyntaxError);
+  assert.throws(() => evaluate("1 + 2)"), SyntaxError);
+  assert.throws(() => evaluate("()"), SyntaxError);
+  assert.throws(() => evaluate("* 2"), SyntaxError);
+  assert.throws(() => evaluate("2 ^"), SyntaxError);
+});
+
+test("tokenizer errors surface unchanged from evaluate", () => {
+  assert.throws(() => evaluate("1 % 2"), SyntaxError);
+  assert.throws(() => evaluate("2."), SyntaxError);
+  assert.throws(() => evaluate(12), TypeError);
+});
+
+test("whitespace-only and nested parentheses", () => {
+  assert.equal(evaluate("  ( 1 + 2 )  * ( 3 - 1 )  "), 6);
+  assert.equal(evaluate("((1))"), 1);
+  assert.equal(evaluate("((1 + 2) * (3 + 4))"), 21);
+});
