index 0000000..25599d3
--- /dev/null
+++ b/src/evaluate.mjs
@@ -0,0 +1,106 @@
+import { tokenize } from "./tokenize.mjs";
+
+// Grammar, tightest binding first:
+//   addsub := muldiv (('+' | '-') muldiv)*        (left-associative)
+//   muldiv := unary (('*' | '/') unary)*          (left-associative)
+//   unary  := '-' unary | power                    (only '-' is a unary op)
+//   power  := atom ('^' unary)?                    (right-associative)
+//   atom   := number | '(' addsub ')'
+//
+// This puts '^' tighter than unary minus, so "-2 ^ 2" parses as -(2 ^ 2).
+
+export function evaluate(text) {
+  const tokens = tokenize(text);
+  let pos = 0;
+
+  const peek = () => tokens[pos];
+  const advance = () => tokens[pos++];
+
+  function fail(message, at) {
+    const suffix = at === undefined ? "" : ` at index ${at}`;
+    throw new SyntaxError(`${message}${suffix}`);
+  }
+
+  function parseAtom() {
+    const tok = peek();
+    if (!tok) {
+      fail("unexpected end of input");
+    }
+    if (tok.type === "number") {
+      advance();
+      return tok.value;
+    }
+    if (tok.type === "lparen") {
+      advance();
+      const value = parseAddSub();
+      const close = peek();
+      if (!close || close.type !== "rparen") {
+        fail('expected ")"', close ? close.at : text.length);
+      }
+      advance();
+      return value;
+    }
+    fail("unexpected token", tok.at);
+  }
+
+  function parsePower() {
+    const base = parseAtom();
+    const tok = peek();
+    if (tok && tok.type === "op" && tok.value === "^") {
+      advance();
+      const exponent = parseUnary();
+      return Math.pow(base, exponent);
+    }
+    return base;
+  }
+
+  function parseUnary() {
+    const tok = peek();
+    if (tok && tok.type === "op" && tok.value === "-") {
+      advance();
+      return -parseUnary();
+    }
+    return parsePower();
+  }
+
+  function parseMulDiv() {
+    let value = parseUnary();
+    for (;;) {
+      const tok = peek();
+      if (tok && tok.type === "op" && (tok.value === "*" || tok.value === "/")) {
+        advance();
+        const rhs = parseUnary();
+        if (tok.value === "*") {
+          value = value * rhs;
+        } else {
+          if (rhs === 0) {
+            throw new RangeError(`division by zero at index ${tok.at}`);
+          }
+          value = value / rhs;
+        }
+      } else {
+        return value;
+      }
+    }
+  }
+
+  function parseAddSub() {
+    let value = parseMulDiv();
+    for (;;) {
+      const tok = peek();
+      if (tok && tok.type === "op" && (tok.value === "+" || tok.value === "-")) {
+        advance();
+        const rhs = parseMulDiv();
+        value = tok.value === "+" ? value + rhs : value - rhs;
+      } else {
+        return value;
+      }
+    }
+  }
+
+  const result = parseAddSub();
+  if (pos < tokens.length) {
+    fail("unexpected token", tokens[pos].at);
+  }
+  return result;
+}
diff --git a/src/tokenize.mjs b/src/tokenize.mjs
new file mode 100644
index 0000000..4892ea3
--- /dev/null
+++ b/src/tokenize.mjs
@@ -0,0 +1,79 @@
+const OPS = new Set(["+", "-", "*", "/", "^"]);
+
+const isDigit = (ch) => ch >= "0" && ch <= "9";
+
+export function tokenize(text) {
+  if (typeof text !== "string") {
+    throw new TypeError(`tokenize expects a string, got ${typeof text}`);
+  }
+
+  const tokens = [];
+  let i = 0;
+
+  while (i < text.length) {
+    const ch = text[i];
+
+    if (ch === " " || ch === "\t" || ch === "\n" || ch === "\r") {
+      i += 1;
+      continue;
+    }
+
+    if (ch === "(") {
+      tokens.push({ type: "lparen", value: "(", at: i });
+      i += 1;
+      continue;
+    }
+
+    if (ch === ")") {
+      tokens.push({ type: "rparen", value: ")", at: i });
+      i += 1;
+      continue;
+    }
+
+    if (OPS.has(ch)) {
+      tokens.push({ type: "op", value: ch, at: i });
+      i += 1;
+      continue;
+    }
+
+    if (isDigit(ch) || ch === ".") {
+      const start = i;
+      let end = i;
+
+      while (end < text.length && isDigit(text[end])) {
+        end += 1;
+      }
+
+      if (end < text.length && text[end] === ".") {
+        const dotAt = end;
+        const hasDigitBefore = dotAt > start;
+        const hasDigitAfter = dotAt + 1 < text.length && isDigit(text[dotAt + 1]);
+
+        if (!hasDigitBefore || !hasDigitAfter) {
+          throw new SyntaxError(`unexpected "." at index ${dotAt}`);
+        }
+
+        end = dotAt + 1;
+        while (end < text.length && isDigit(text[end])) {
+          end += 1;
+        }
+      }
+
+      if (end === start) {
+        throw new SyntaxError(`unexpected character at index ${start}`);
+      }
+
+      tokens.push({
+        type: "number",
+        value: Number(text.slice(start, end)),
+        at: start,
+      });
+      i = end;
+      continue;
+    }
+
+    throw new SyntaxError(`unexpected character at index ${i}`);
+  }
+
+  return tokens;
+}
diff --git a/tests/evaluate.test.mjs b/tests/evaluate.test.mjs
new file mode 100644
