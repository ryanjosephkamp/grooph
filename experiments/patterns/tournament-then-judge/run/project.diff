index 0000000..d4f46e2
--- /dev/null
+++ b/candidates/c/diff.mjs
@@ -0,0 +1,107 @@
+// Line diff via the Myers O(ND) shortest-edit-script algorithm.
+//
+// Unlike the textbook O(n*m) LCS table, this walks "diagonals" of a virtual
+// edit graph and only does as much work as the *size of the diff* (D)
+// requires: two inputs that mostly agree are cheap to diff even when they are
+// individually huge, because D stays small no matter how large n and m are.
+// Only inputs that are almost entirely different (D close to n + m) approach
+// the O(n*m) cost of the naive table.
+
+function assertLineArray(value, name) {
+  if (!Array.isArray(value) || !value.every((line) => typeof line === "string")) {
+    throw new TypeError(`${name} must be an array of strings`);
+  }
+}
+
+// Runs Myers' algorithm forward, recording the frontier `v` at every edit
+// distance `d` so we can walk it backwards afterward to recover the actual
+// path (this is the standard "trace" trick from Myers' paper).
+function buildTrace(a, b) {
+  const n = a.length;
+  const m = b.length;
+  const max = n + m;
+  let v = new Map([[1, 0]]);
+  const trace = [];
+
+  for (let d = 0; d <= max; d += 1) {
+    trace.push(v);
+    const nextV = new Map(v);
+    for (let k = -d; k <= d; k += 2) {
+      let x;
+      if (k === -d || (k !== d && v.get(k - 1) < v.get(k + 1))) {
+        x = v.get(k + 1) ?? 0;
+      } else {
+        x = (v.get(k - 1) ?? 0) + 1;
+      }
+      let y = x - k;
+      while (x < n && y < m && a[x] === b[y]) {
+        x += 1;
+        y += 1;
+      }
+      nextV.set(k, x);
+      if (x >= n && y >= m) {
+        trace[d] = v; // keep the frontier that produced this d, as recorded
+        return trace;
+      }
+    }
+    v = nextV;
+  }
+  return trace; // n === m === 0 falls through here with trace = [Map([[1, 0]])]
+}
+
+// Walks the recorded trace backwards from (n, m) to (0, 0), yielding
+// snake/edit segments in reverse order.
+function* walkBack(a, b, trace) {
+  let x = a.length;
+  let y = b.length;
+
+  for (let d = trace.length - 1; d >= 0 && (x > 0 || y > 0); d -= 1) {
+    const v = trace[d];
+    const k = x - y;
+    let prevK;
+    if (k === -d || (k !== d && (v.get(k - 1) ?? 0) < (v.get(k + 1) ?? 0))) {
+      prevK = k + 1;
+    } else {
+      prevK = k - 1;
+    }
+    const prevX = v.get(prevK) ?? 0;
+    const prevY = prevX - prevK;
+
+    while (x > prevX && y > prevY) {
+      yield { op: "=", ax: x - 1, bx: y - 1 };
+      x -= 1;
+      y -= 1;
+    }
+    if (d > 0) {
+      if (x === prevX) {
+        yield { op: "+", ax: -1, bx: prevY };
+      } else {
+        yield { op: "-", ax: prevX, bx: -1 };
+      }
+    }
+    x = prevX;
+    y = prevY;
+  }
+}
+
+export function diffLines(before, after) {
+  assertLineArray(before, "before");
+  assertLineArray(after, "after");
+
+  // Work on private copies so nothing we do here can leak back to the
+  // caller's arrays, even though this implementation never writes to them.
+  const a = before.slice();
+  const b = after.slice();
+
+  if (a.length === 0 && b.length === 0) return [];
+
+  const trace = buildTrace(a, b);
+  const steps = [...walkBack(a, b, trace)];
+  steps.reverse();
+
+  return steps.map((step) => {
+    if (step.op === "=") return { op: "=", line: a[step.ax] };
+    if (step.op === "-") return { op: "-", line: a[step.ax] };
+    return { op: "+", line: b[step.bx] };
+  });
+}
