@@ -0,0 +1,119 @@
+// Line diff via the Myers O(ND) shortest-edit-script algorithm.
+//
+// The algorithm walks an edit graph where the x axis is `before` and the y
+// axis is `after`; a "snake" of diagonal moves means a `=` (matched line),
+// a horizontal move means a `-` (a `before` line consumed with no match),
+// and a vertical move means a `+` (an `after` line produced with no match).
+// It finds the shortest path from (0,0) to (n,m), which is exactly the
+// minimal edit script the contract asks for (fewest `-`/`+`, i.e. the
+// longest common subsequence is kept as `=`).
+//
+// Complexity is O((N+M)D) time and space, where D is the size of the edit
+// (the number of `-`/`+` entries). For inputs that are mostly similar --
+// the common case for a line-review diff -- D is small even when N and M
+// are in the thousands, so this stays fast in practice. The worst case is
+// two completely unrelated inputs (D close to N+M), which degrades toward
+// O((N+M)^2); a few thousand unrelated lines is still fine (single-digit
+// millions of cells), just no longer near-linear.
+
+function assertStringArray(value, name) {
+  if (!Array.isArray(value)) {
+    throw new TypeError(`${name} must be an array of strings`);
+  }
+  for (const item of value) {
+    if (typeof item !== "string") {
+      throw new TypeError(`${name} must be an array of strings`);
+    }
+  }
+}
+
+/**
+ * Run the Myers algorithm forward, recording the frontier `v` at each edit
+ * distance `d` so we can walk it backwards afterwards to recover the path.
+ */
+function buildTrace(a, b) {
+  const n = a.length;
+  const m = b.length;
+  const max = n + m;
+  const offset = max;
+  const v = new Array(2 * max + 1).fill(0);
+  const trace = [];
+
+  for (let d = 0; d <= max; d += 1) {
+    trace.push(v.slice());
+    for (let k = -d; k <= d; k += 2) {
+      let x;
+      if (k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1])) {
+        x = v[offset + k + 1];
+      } else {
+        x = v[offset + k - 1] + 1;
+      }
+      let y = x - k;
+      while (x < n && y < m && a[x] === b[y]) {
+        x += 1;
+        y += 1;
+      }
+      v[offset + k] = x;
+      if (x >= n && y >= m) {
+        return { trace, offset };
+      }
+    }
+  }
+  // Unreachable: the loop above always terminates once x reaches (n, m).
+  return { trace, offset };
+}
+
+/** Walk the recorded frontiers backwards from (n, m) to (0, 0), emitting ops. */
+function backtrack(a, b, trace, offset) {
+  let x = a.length;
+  let y = b.length;
+  const ops = [];
+
+  for (let d = trace.length - 1; d >= 0; d -= 1) {
+    const v = trace[d];
+    const k = x - y;
+    let prevK;
+    if (k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1])) {
+      prevK = k + 1;
+    } else {
+      prevK = k - 1;
+    }
+    const prevX = v[offset + prevK];
+    const prevY = prevX - prevK;
+
+    while (x > prevX && y > prevY) {
+      ops.push({ op: "=", line: a[x - 1] });
+      x -= 1;
+      y -= 1;
+    }
+
+    if (d > 0) {
+      if (x === prevX) {
+        ops.push({ op: "+", line: b[y - 1] });
+        y -= 1;
+      } else {
+        ops.push({ op: "-", line: a[x - 1] });
+        x -= 1;
+      }
+    }
+  }
+
+  ops.reverse();
+  return ops;
+}
+
+export function diffLines(before, after) {
+  assertStringArray(before, "before");
+  assertStringArray(after, "after");
+
+  // Defensive copies so we never touch the caller's arrays.
+  const a = before.slice();
+  const b = after.slice();
+
+  if (a.length === 0 && b.length === 0) return [];
+  if (a.length === 0) return b.map((line) => ({ op: "+", line }));
+  if (b.length === 0) return a.map((line) => ({ op: "-", line }));
+
+  const { trace, offset } = buildTrace(a, b);
+  return backtrack(a, b, trace, offset);
+}
