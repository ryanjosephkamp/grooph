+// diffLines(before, after) — Myers O((N+M)·D) shortest-edit-script diff.
+//
+// Rather than building the classic N×M longest-common-subsequence table (an
+// O(N·M) time and space approach), this walks Myers' edit graph: for each
+// number of edits D = 0, 1, 2, ... it tracks the furthest-reaching x
+// coordinate reachable on every diagonal k = x − y, extending each candidate
+// point through a "snake" of equal lines for free. The first D for which some
+// diagonal reaches the bottom-right corner is the minimal edit count, and the
+// script is recovered by walking the recorded per-D frontiers backwards.
+
+/** Validate that `value` is an array of strings, else throw TypeError. */
+function assertStringArray(value, name) {
+  if (!Array.isArray(value)) {
+    throw new TypeError(`${name} must be an array of strings`);
+  }
+  for (const item of value) {
+    if (typeof item !== "string") {
+      throw new TypeError(`${name} must be an array of strings`);
+    }
+  }
+}
+
+/**
+ * Run Myers' greedy algorithm and return the list of frontier snapshots
+ * (one Int32Array per edit-distance D), the last of which reaches the end.
+ */
+function shortestEditTrace(a, b) {
+  const n = a.length;
+  const m = b.length;
+  const max = n + m;
+  // Offset so that diagonal k (which ranges over -max..max) maps to a
+  // non-negative index; one extra slot on each side avoids bounds checks
+  // for the D === 0 base case, which conceptually reads a "k = 1" frontier
+  // that was never explicitly written.
+  const offset = max + 1;
+  const v = new Int32Array(2 * offset + 1);
+  const trace = [];
+
+  if (max === 0) {
+    trace.push(v.slice());
+    return { trace, offset };
+  }
+
+  for (let d = 0; d <= max; d += 1) {
+    trace.push(v.slice());
+    for (let k = -d; k <= d; k += 2) {
+      let x;
+      if (k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1])) {
+        x = v[offset + k + 1]; // move down (insertion from `after`)
+      } else {
+        x = v[offset + k - 1] + 1; // move right (deletion from `before`)
+      }
+      let y = x - k;
+      while (x < n && y < m && a[x] === b[y]) {
+        x += 1;
+        y += 1;
+      }
+      v[offset + k] = x;
+      if (x >= n && y >= m) {
+        return { trace, offset };
+      }
+    }
+  }
+  // Unreachable: d = max always finds the corner.
+  return { trace, offset };
+}
+
+/** Walk the recorded frontiers backwards to recover the edit script. */
+function backtrack(trace, offset, a, b) {
+  const script = [];
+  let x = a.length;
+  let y = b.length;
+
+  for (let d = trace.length - 1; d >= 0; d -= 1) {
+    const v = trace[d];
+    const k = x - y;
+    let prevK;
+    if (k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1])) {
+      prevK = k + 1;
+    } else {
+      prevK = k - 1;
+    }
+    const prevX = v[offset + prevK];
+    const prevY = prevX - prevK;
+
+    while (x > prevX && y > prevY) {
+      script.push({ op: "=", line: a[x - 1] });
+      x -= 1;
+      y -= 1;
+    }
+
+    if (d > 0) {
+      if (x === prevX) {
+        script.push({ op: "+", line: b[y - 1] });
+        y -= 1;
+      } else {
+        script.push({ op: "-", line: a[x - 1] });
+        x -= 1;
+      }
+    }
+  }
+
+  script.reverse();
+  return script;
+}
+
+export function diffLines(before, after) {
+  assertStringArray(before, "before");
+  assertStringArray(after, "after");
+
+  // Work against local copies so nothing we do can ever be observed as a
+  // mutation of the caller's arrays (we don't mutate them anyway, but this
+  // keeps the contract robust even if that changes later).
+  const a = before.slice();
+  const b = after.slice();
+
+  if (a.length === 0 && b.length === 0) return [];
+
+  const { trace, offset } = shortestEditTrace(a, b);
+  return backtrack(trace, offset, a, b);
+}
