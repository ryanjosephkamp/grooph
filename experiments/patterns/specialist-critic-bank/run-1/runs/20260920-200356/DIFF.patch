@@ -24,3 +24,119 @@ test("sizes are in bytes, not characters", () => {
   writeUserFile(root, "u.txt", "héllo");
   assert.deepEqual(listFiles(root), [{ name: "u.txt", size: 6 }]);
 });
+
+test("search returns matching names under the root, sorted", () => {
+  const root = fresh();
+  writeUserFile(root, "c.txt", "the cat sat");
+  writeUserFile(root, "a.txt", "a cat too");
+  writeUserFile(root, "b.txt", "no match here");
+  assert.deepEqual(searchFiles(root, "cat"), ["a.txt", "c.txt"]);
+  assert.deepEqual(searchFiles(root, "dog"), []);
+});
+
+test("search is a case-sensitive substring match", () => {
+  const root = fresh();
+  writeUserFile(root, "a.txt", "Hello world");
+  assert.deepEqual(searchFiles(root, "Hello"), ["a.txt"]);
+  assert.deepEqual(searchFiles(root, "hello"), []);
+  assert.deepEqual(searchFiles(root, "lo wo"), ["a.txt"]);
+});
+
+test("search matches multibyte text", () => {
+  const root = fresh();
+  writeUserFile(root, "a.txt", "héllo wörld");
+  writeUserFile(root, "b.txt", "hello world");
+  assert.deepEqual(searchFiles(root, "éll"), ["a.txt"]);
+  assert.deepEqual(searchFiles(root, "ö"), ["a.txt"]);
+});
+
+test("search finds a match that straddles a read boundary", () => {
+  const root = fresh();
+  const chunk = 1 << 20;
+  writeUserFile(root, "big.txt", "x".repeat(chunk - 3) + "needle" + "x".repeat(chunk));
+  writeUserFile(root, "end.txt", "x".repeat(chunk) + "needle");
+  writeUserFile(root, "none.txt", "x".repeat(chunk + 5));
+  assert.deepEqual(searchFiles(root, "needle"), ["big.txt", "end.txt"]);
+});
+
+test("search refuses a non-string query", () => {
+  const root = fresh();
+  writeUserFile(root, "a.txt", "undefined");
+  assert.throws(() => searchFiles(root, undefined), TypeError);
+  assert.throws(() => searchFiles(root, /a/), TypeError);
+});
+
+test("empty query matches every file", () => {
+  const root = fresh();
+  writeUserFile(root, "b.txt", "");
+  writeUserFile(root, "a.txt", "x");
+  assert.deepEqual(searchFiles(root, ""), ["a.txt", "b.txt"]);
+});
+
+test("search looks only at files directly under the folder", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(join(root, "sub"), "deep.txt", "needle");
+  assert.deepEqual(searchFiles(root, "needle"), ["top.txt"]);
+});
+
+test("search within a subfolder looks only at that subfolder's files", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(join(root, "sub"), "y.txt", "needle");
+  writeUserFile(join(root, "sub"), "x.txt", "needle");
+  writeUserFile(join(root, "sub"), "z.txt", "hay");
+  writeUserFile(join(root, "sub", "deeper"), "w.txt", "needle");
+  assert.deepEqual(searchFiles(root, "needle", { within: "sub" }), ["x.txt", "y.txt"]);
+  assert.deepEqual(searchFiles(root, "needle", { within: join("sub", "deeper") }), ["w.txt"]);
+  assert.deepEqual(searchFiles(root, "needle", { within: "." }), ["top.txt"]);
+});
+
+test("search refuses a subfolder that escapes the root", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(join(root, "..", "outside"), "leak.txt", "needle");
+  assert.throws(() => searchFiles(root, "needle", { within: join("..", "outside") }), /escapes/);
+  assert.throws(() => searchFiles(root, "needle", { within: join("sub", "..", "..", "outside") }), /escapes/);
+  assert.throws(() => searchFiles(root, "needle", { within: join(root, "..", "outside") }), /escapes/);
+  assert.throws(() => searchFiles(root, "needle", { within: 42 }), TypeError);
+});
+
+test("search refuses a subfolder that is a symbolic link out of the root", () => {
+  const root = fresh();
+  const outside = join(root, "..", "outside");
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(outside, "leak.txt", "needle");
+  symlinkSync(outside, join(root, "link"));
+  assert.throws(() => searchFiles(root, "needle", { within: "link" }), /escapes/);
+  assert.throws(() => searchFiles(root, "needle", { within: join("link", ".") }), /escapes/);
+});
+
+test("search and list skip symbolic links to files", () => {
+  const root = fresh();
+  const outside = join(root, "..", "outside");
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(outside, "leak.txt", "needle");
+  symlinkSync(join(outside, "leak.txt"), join(root, "leak-link.txt"));
+  assert.deepEqual(searchFiles(root, "needle"), ["top.txt"]);
+  assert.deepEqual(listFiles(root), [{ name: "top.txt", size: 6 }]);
+});
+
+test("search refuses a sibling folder whose name merely starts with the root's", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  writeUserFile(`${root}2`, "leak.txt", "needle");
+  assert.throws(() => searchFiles(root, "needle", { within: "../root2" }), /escapes/);
+});
+
+test("search on a missing subfolder throws", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  assert.throws(() => searchFiles(root, "needle", { within: "nope" }), { code: "ENOENT" });
+});
+
+test("search on a subfolder that is really a file throws", () => {
+  const root = fresh();
+  writeUserFile(root, "top.txt", "needle");
+  assert.throws(() => searchFiles(root, "needle", { within: "top.txt" }), { code: "ENOTDIR" });
+});
