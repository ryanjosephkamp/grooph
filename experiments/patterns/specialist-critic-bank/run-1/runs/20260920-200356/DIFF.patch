-import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
-import { join } from "node:path";
+import {
+  closeSync,
+  mkdirSync,
+  openSync,
+  readdirSync,
+  readFileSync,
+  readSync,
+  realpathSync,
+  statSync,
+  writeFileSync,
+} from "node:fs";
+import { join, resolve, sep } from "node:path";
+
+/** How many bytes of a file a search reads at a time. */
+const CHUNK_BYTES = 1 << 20;
 
 /** The text of the named file under the user's root. */
 export function readUserFile(root, name) {
@@ -14,6 +27,67 @@ export function writeUserFile(root, name, text) {
 
 /** The files directly under the user's root, with their sizes in bytes, sorted by name. */
 export function listFiles(root) {
-  const names = readdirSync(root).filter((name) => statSync(join(root, name)).isFile());
-  return names.sort().map((name) => ({ name, size: readFileSync(join(root, name)).length }));
+  return fileNames(root).map((name) => ({ name, size: statSync(join(root, name)).size }));
+}
+
+/**
+ * The names, sorted, of the files directly under the user's root (or under the
+ * subfolder `within` when given) whose UTF-8 text contains `query`.
+ */
+export function searchFiles(root, query, { within } = {}) {
+  if (typeof query !== "string") throw new TypeError("query must be a string");
+  const dir = resolveWithin(root, within ?? ".");
+  const names = fileNames(dir);
+  if (query === "") return names;
+  const needle = Buffer.from(query, "utf8");
+  const buf = Buffer.allocUnsafe(needle.length - 1 + CHUNK_BYTES);
+  return names.filter((name) => fileContains(join(dir, name), needle, buf));
+}
+
+/**
+ * Whether the file at `path` contains the bytes `needle`. Reads the file one
+ * chunk at a time into `buf` (sized by the caller for a chunk plus the
+ * `needle.length - 1` bytes carried over from the previous one, so a match
+ * straddling two chunks is still seen) and stops at the first hit.
+ */
+function fileContains(path, needle, buf) {
+  const fd = openSync(path, "r");
+  try {
+    let kept = 0;
+    for (;;) {
+      const read = readSync(fd, buf, kept, CHUNK_BYTES, null);
+      if (read === 0) return false;
+      const end = kept + read;
+      if (buf.subarray(0, end).includes(needle)) return true;
+      kept = Math.min(end, needle.length - 1);
+      buf.copy(buf, 0, end - kept, end);
+    }
+  } finally {
+    closeSync(fd);
+  }
 }
+
+/** The names of the regular files directly under `dir`, sorted; symbolic links are skipped. */
+function fileNames(dir) {
+  return readdirSync(dir, { withFileTypes: true })
+    .filter((entry) => entry.isFile())
+    .map((entry) => entry.name)
+    .sort();
+}
+
+/**
+ * The real path of the subfolder `sub` under `root`, refusing one that leads
+ * outside the root, whether by `..`, an absolute path or a symbolic link.
+ */
+function resolveWithin(root, sub) {
+  if (typeof sub !== "string") throw new TypeError("within must be a string");
+  const base = realpathSync(root);
+  const target = resolve(base, sub);
+  if (!isUnder(base, target)) throw escapes(sub);
+  const real = realpathSync(target);
+  if (!isUnder(base, real)) throw escapes(sub);
+  return real;
+}
+
+const isUnder = (base, path) => path === base || path.startsWith(base + sep);
+const escapes = (sub) => new Error(`within escapes the user's root: ${sub}`);
