{
  "permissions": {
    "defaultMode": "dontAsk",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "ListAgents",
      "SendMessage",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(mdfind *)",
      "Bash(mdls *)",
      "Bash(security *)",
      "Bash(launchctl *)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(pbpaste)",
      "Bash(pbpaste *)",
      "Bash(screencapture *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["__NPM_CACHE__"],
      "allowRead": ["__NPM_CACHE__", "~/Library/Caches/ms-playwright"],
      "denyRead": ["/tmp", "/private/tmp", "__USER_TEMP__", "/private__USER_TEMP__"],
      "denyWrite": ["__GAME_HOME__/rehearsal-claude/.grooph/hooks", "__GAME_HOME__/grooph-game-experiment-claude/.grooph/hooks"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "strictAllowlist": true,
      "allowLocalBinding": true,
      "allowMachLookup": ["*"]
    }
  },
  "env": {
    "npm_config_cache": "__NPM_CACHE__",
    "npm_config_userconfig": "__NPM_CACHE__/npmrc",
    "npm_config_update_notifier": "false"
  },
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "crossSessionInbound": "refuse",
  "disableRemoteControl": true,
  "enableArtifact": false,
  "respondToBashCommands": false,
  "cleanupPeriodDays": 3650
}
