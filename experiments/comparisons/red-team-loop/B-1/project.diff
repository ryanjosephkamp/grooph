+            state = AFTER_QUOTE;
+          }
+        }
+        break;
+
+      case AFTER_QUOTE:
+        if (c === COMMA) {
+          fields.push(field);
+          if (fields.length === maxFields) throw tooManyFields(i);
+          field = "";
+          state = FIELD_START;
+        } else {
+          throw new CsvError(
