+  switch (state) {
+    case FIELD_START:
+      // Covers the empty text ([""]) and a trailing comma ("a," -> ["a", ""]).
+      fields.push("");
+      break;
+    case UNQUOTED:
+      fields.push(text.slice(chunkStart, end));
+      break;
+    case AFTER_QUOTE:
+      fields.push(field);
