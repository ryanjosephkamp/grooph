+const KB100 = 100 * 1024;
+
+function timed(fn) {
+  const t0 = performance.now();
+  const r = fn();
+  return { r, ms: performance.now() - t0 };
+}
+
+function assertFast(text, check) {
+  const { r, ms } = timed(() => {
+    try {
+      return { ok: parseCsvLine(text) };
+    } catch (e) {
+      return { err: e };
+    }
+  });
+  assert.ok(ms < 500, `took ${ms.toFixed(1)} ms`);
+  check(r);
+}
