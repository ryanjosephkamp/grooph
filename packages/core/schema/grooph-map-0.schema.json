{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grooph.dev/schema/grooph-map-0.schema.json",
  "title": "grooph operation map v0",
  "description": "A grooph operation map: harness sessions, the people they work with, the handoffs between them and the lanes they run in. Drawn and validated, never compiled. Normative source: docs/operation-map.md §1. Generated from packages/core/src/schema/map.ts; do not edit by hand.",
  "type": "object",
  "properties": {
    "groophMap": {
      "const": 0
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Lane"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Person"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Session"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Handoff"
      }
    }
  },
  "required": [
    "groophMap",
    "id",
    "name",
    "version",
    "lanes",
    "sessions",
    "handoffs"
  ],
  "$defs": {
    "Carrier": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "branch"
            },
            "repo": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pull-request"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "session-message"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "scheduled-message"
            },
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "review-page"
            },
            "where": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "person"
            },
            "who": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "notification"
            },
            "where": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Handoff": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "carrier": {
          "$ref": "#/$defs/Carrier"
        },
        "what": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "Lane": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "enum": [
            "local",
            "cloud"
          ]
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "machine",
        "account"
      ]
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "claude-code",
            "codex"
          ]
        },
        "model": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "lifetime": {
          "enum": [
            "long-lived",
            "per-task",
            "scheduled"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "graph": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "lane",
        "harness",
        "role"
      ]
    }
  }
}
