  "properties": {
    "grooph": {
      "const": 0
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "goal": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "claude-code",
            "codex"
          ]
        }
      },
      "required": [
        "harness"
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "other": {
          "type": "string"
        }
