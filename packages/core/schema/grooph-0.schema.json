    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "loops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Loop"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Policy"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunNote"
      }
