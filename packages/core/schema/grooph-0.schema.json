        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "read-files",
              "edit-files",
              "write-outputs",
              "run-commands",
              "run-tests",
              "web",
              "spawn-agents"
            ]
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "read-files",
              "edit-files",
              "write-outputs",
              "run-commands",
              "run-tests",
              "web",
              "spawn-agents"
            ]
          }
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "irreversible": {
          "type": "array",
          "items": {
            "type": "string"
          }
