    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  },
  "required": [
    "grooph",
    "id",
    "name",
    "version",
    "nodes",
    "edges",
    "loops"
