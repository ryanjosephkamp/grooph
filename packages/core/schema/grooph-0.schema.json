{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grooph.dev/schema/grooph-0.schema.json",
  "title": "grooph graph document v0",
  "description": "A grooph graph document. Normative source: docs/graph-ir.md §1. Generated from packages/core/src/schema/graph.ts; do not edit by hand.",
