    "test": "node --test 'dist/test/*.test.js'"
  },
  "dependencies": {
    "@grooph/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
