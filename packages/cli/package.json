{
  "name": "@grooph/cli",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "grooph command line: create, edit (apply ops), validate, canonicalize and export graph documents.",
  "license": "MIT",
  "bin": {
    "grooph": "./bin/grooph.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
