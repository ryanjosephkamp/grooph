{
  "groophMap": 0,
  "id": "a-launch-push",
  "name": "A product team's launch push",
  "version": 1,
  "asOf": "2026-10-04",
  "lanes": [
    {
      "id": "mac",
      "name": "Ada's laptop",
      "machine": "the Mac",
      "place": "local",
      "account": "the account signed in on the Mac"
    },
    {
      "id": "codex",
      "name": "The second tool on the laptop",
      "machine": "the Mac",
      "place": "local",
      "account": "a second vendor's subscription"
    },
    {
      "id": "cloud",
      "name": "Cloud, the other account",
      "machine": "cloud",
      "place": "cloud",
      "account": "Ada's other account"
    }
  ],
  "people": [
    {
      "id": "ada",
      "name": "Ada",
      "role": "Owner. Says yes or no at each gate, from their phone. Pastes the lane briefs. Says hold."
    }
  ],
  "sessions": [
    {
      "id": "driver",
      "name": "Driver",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "role": "Writes each lane's brief, reviews each report, merges on Ada's word, keeps the plan and progress current, publishes the gate pages",
      "lifetime": "long-lived",
      "repo": "example/product"
    },
    {
      "id": "front-door",
      "name": "Lane 1: front door",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "role": "Landing page, README, desktop layout",
      "lifetime": "per-task",
      "repo": "example/product"
    },
    {
      "id": "embed",
      "name": "Lane 2: embeds",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "role": "A graph anyone can embed in a page, and a recorded run that plays",
      "lifetime": "per-task",
      "repo": "example/product"
    },
    {
      "id": "toolkit",
      "name": "Lane 3: no-friction toolkit",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-sonnet-5-5",
      "role": "First run, CLI help and errors, quickstart, rule reference",
      "lifetime": "per-task",
      "repo": "example/product"
    },
    {
      "id": "evidence",
      "name": "Lane 4: evidence",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "role": "A comparison study, run unattended",
      "lifetime": "per-task",
      "repo": "example/product"
    },
    {
      "id": "later",
      "name": "Lanes 6 and 7: community, writing",
      "lane": "mac",
      "harness": "claude-code",
      "model": "claude-sonnet-5-5",
      "role": "Submissions by pull request; the blog draft and the technical report. Start when a slot frees",
      "lifetime": "per-task",
      "count": 2,
      "repo": "example/product"
    },
    {
      "id": "codex-target",
      "name": "Lane 5: second tool",
      "lane": "codex",
      "harness": "codex",
      "model": "gpt-6.1-sol",
      "role": "The second tool's target and one trial run; an outside read of each other lane's change",
      "lifetime": "per-task",
      "repo": "example/product"
    },
    {
      "id": "dot",
      "name": "The researcher",
      "lane": "cloud",
      "harness": "claude-code",
      "role": "Research it does itself: prior art, comparable tools, design references, package names. Never hands work to the second tool",
      "lifetime": "per-task"
    },
    {
      "id": "operator",
      "name": "Operator",
      "lane": "cloud",
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "role": "Runs the other project's lanes, which publish their events. Asked only for what the events do not show",
      "lifetime": "long-lived"
    }
  ],
  "handoffs": [
    {
      "id": "h-plan",
      "from": "driver",
      "to": "ada",
      "carrier": {
        "kind": "review-page",
        "where": "gate pages"
      },
      "what": "the plan, then each gate: what was done, what needs only a yes"
    },
    {
      "id": "h-yes",
      "from": "ada",
      "to": "driver",
      "carrier": {
        "kind": "session-message"
      },
      "what": "approved, or hold"
    },
    {
      "id": "h-brief",
      "from": "ada",
      "to": "front-door",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the paste line that starts a lane, in a new Terminal tab"
    },
    {
      "id": "h-brief-2",
      "from": "ada",
      "to": "embed",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the paste line"
    },
    {
      "id": "h-brief-3",
      "from": "ada",
      "to": "toolkit",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the paste line"
    },
    {
      "id": "h-brief-4",
      "from": "ada",
      "to": "evidence",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the paste line, once they say go to the study"
    },
    {
      "id": "h-brief-5",
      "from": "ada",
      "to": "codex-target",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the prompt, in the second tool's app"
    },
    {
      "id": "h-handoff",
      "from": "driver",
      "to": "front-door",
      "carrier": {
        "kind": "branch",
        "repo": "example/product",
        "ref": "main"
      },
      "what": "a brief for each lane, on main"
    },
    {
      "id": "h-pr-1",
      "from": "front-door",
      "to": "driver",
      "carrier": {
        "kind": "pull-request",
        "repo": "example/product"
      },
      "what": "the lane's work with its report"
    },
    {
      "id": "h-pr-2",
      "from": "embed",
      "to": "driver",
      "carrier": {
        "kind": "pull-request",
        "repo": "example/product"
      },
      "what": "the lane's work with its report"
    },
    {
      "id": "h-pr-3",
      "from": "toolkit",
      "to": "driver",
      "carrier": {
        "kind": "pull-request",
        "repo": "example/product"
      },
      "what": "the lane's work with its report"
    },
    {
      "id": "h-pr-4",
      "from": "evidence",
      "to": "driver",
      "carrier": {
        "kind": "pull-request",
        "repo": "example/product"
      },
      "what": "the study's records and write-ups"
    },
    {
      "id": "h-pr-5",
      "from": "codex-target",
      "to": "driver",
      "carrier": {
        "kind": "branch",
        "repo": "example/product"
      },
      "what": "the second tool's target on a branch, with its report"
    },
    {
      "id": "h-later",
      "from": "driver",
      "to": "later",
      "carrier": {
        "kind": "branch",
        "repo": "example/product",
        "ref": "main"
      },
      "what": "their briefs, when a slot frees"
    },
    {
      "id": "h-later-back",
      "from": "later",
      "to": "driver",
      "carrier": {
        "kind": "pull-request",
        "repo": "example/product"
      },
      "what": "their work"
    },
    {
      "id": "h-dot",
      "from": "ada",
      "to": "dot",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "the research questions"
    },
    {
      "id": "h-dot-back",
      "from": "dot",
      "to": "driver",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "what it found, as a file Ada attaches"
    },
    {
      "id": "h-events",
      "from": "operator",
      "to": "driver",
      "carrier": {
        "kind": "branch",
        "repo": "the other project's public repository",
        "ref": "events/*"
      },
      "what": "the other project's lanes' events, read as sessions"
    },
    {
      "id": "h-ask",
      "from": "driver",
      "to": "operator",
      "carrier": {
        "kind": "person",
        "who": "Ada"
      },
      "what": "only what the events do not show"
    }
  ]
}
