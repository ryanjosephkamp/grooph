{
  "grooph": 0,
  "id": "fix-or-say-what-is-left",
  "name": "Fix until green, or say what is left",
  "version": 1,
  "goal": "Make the failing test suite pass without changing what the tests assert.",
  "target": {
    "harness": "claude-code"
  },
  "constraints": {
    "time": "about 20 minutes"
  },
  "adaptation": "fixed",
  "description": "A builder fixes failing tests and a check node runs the suite. A green suite ends the run. When the round cap is reached first, the run does not just halt: it continues at a wrap-up step that writes down what is still failing, and halts there.",
  "nodes": [
    {
      "id": "fixer",
      "kind": "agent",
      "name": "Fixer",
      "role": "builder",
      "model": {
        "tier": "strong"
      },
      "effort": "medium",
      "brief": "Make the failing tests in tests/ pass by changing src/. Do not edit the tests or skip them. Report which tests you fixed and why they failed.",
      "inputs": [
        "the failing test output"
      ],
      "outputs": [
        "src/ changes",
        "FIXES.md naming each test fixed and its cause"
      ],
      "allow": [
        "read-files",
        "edit-files",
        "run-tests"
      ],
      "owns": [
        "src"
      ]
    },
    {
      "id": "suite",
      "kind": "check",
      "name": "Test suite",
      "check": {
        "kind": "tests",
        "run": "npm test",
        "pass": "exit code 0 and no test skipped"
      }
    },
    {
      "id": "green",
      "kind": "stop",
      "name": "Green",
      "outcome": "success"
    },
    {
      "id": "wrap",
      "kind": "agent",
      "name": "Wrap-up",
      "role": "builder",
      "model": {
        "tier": "fast"
      },
      "effort": "low",
      "brief": "The round cap was reached with the suite still failing. Write LEFT.md: each test that still fails, what was tried for it, and the smallest next step. Change no code.",
      "inputs": [
        "the last test output",
        "FIXES.md"
      ],
      "outputs": [
        "LEFT.md"
      ],
      "allow": [
        "read-files",
        "write-outputs"
      ]
    },
    {
      "id": "handed-over",
      "kind": "stop",
      "name": "Handed over",
      "outcome": "halt"
    }
  ],
  "edges": [
    {
      "id": "e-fix-suite",
      "from": "fixer",
      "to": "suite"
    },
    {
      "id": "e-suite-fail",
      "from": "suite",
      "to": "fixer",
      "when": "fail",
      "evidence": [
        "test output"
      ]
    },
    {
      "id": "e-suite-pass",
      "from": "suite",
      "to": "green",
      "when": "pass"
    },
    {
      "id": "e-wrap-handed-over",
      "from": "wrap",
      "to": "handed-over"
    }
  ],
  "loops": [
    {
      "id": "fix-cycle",
      "name": "Fix cycle",
      "members": [
        "fixer",
        "suite"
      ],
      "back": [
        "e-suite-fail"
      ],
      "mode": "grind",
      "stops": [
        {
          "kind": "max-iterations",
          "n": 5,
          "then": "wrap"
        },
        {
          "kind": "budget",
          "measure": "minutes",
          "limit": 20
        }
      ]
    }
  ]
}
