{
  "grooph": 0,
  "id": "pinned-and-skilled",
  "name": "Pinned and skilled",
  "version": 1,
  "goal": "Make the failing test suite pass without changing what the tests assert.",
  "target": {
    "harness": "claude-code"
  },
  "constraints": {
    "time": "about 20 minutes"
  },
  "adaptation": "fixed",
  "description": "fix-until-green with a model pinned by name, skills named with a plugin prefix and a folder scope, and a capability of its own in several words: the widest names graph-ir §1 lets through.",
  "nodes": [
    {
      "id": "fixer",
      "kind": "agent",
      "name": "Fixer",
      "role": "builder",
      "model": {
        "tier": "strong",
        "pin": {
          "claude-code": "sonnet[1m]",
          "codex": "provider/model-name_v2.1:latest"
        }
      },
      "effort": "medium",
      "brief": "Make the failing tests in tests/ pass by changing src/. Do not edit the tests or skip them. Report which tests you fixed and why they failed.",
      "inputs": [
        "the failing test output"
      ],
      "outputs": [
        "src/ changes",
        "FIXES.md naming each test fixed and its cause"
      ],
      "allow": [
        "read-files",
        "edit-files",
        "run-tests",
        "deploy to staging"
      ],
      "owns": [
        "src"
      ],
      "skills": [
        "test-triage",
        "house:commit-style",
        "apps/web:deploy"
      ]
    },
    {
      "id": "suite",
      "kind": "check",
      "name": "Test suite",
      "check": {
        "kind": "tests",
        "run": "npm test",
        "pass": "exit code 0 and no test skipped"
      }
    },
    {
      "id": "green",
      "kind": "stop",
      "name": "Green",
      "outcome": "success"
    }
  ],
  "edges": [
    {
      "id": "e-fix-suite",
      "from": "fixer",
      "to": "suite"
    },
    {
      "id": "e-suite-fail",
      "from": "suite",
      "to": "fixer",
      "when": "fail",
      "evidence": [
        "test output"
      ]
    },
    {
      "id": "e-suite-pass",
      "from": "suite",
      "to": "green",
      "when": "pass"
    }
  ],
  "loops": [
    {
      "id": "fix-cycle",
      "name": "Fix cycle",
      "members": [
        "fixer",
        "suite"
      ],
      "back": [
        "e-suite-fail"
      ],
      "mode": "grind",
      "stops": [
        {
          "kind": "max-iterations",
          "n": 5
        },
        {
          "kind": "budget",
          "measure": "minutes",
          "limit": 20
        }
      ]
    }
  ]
}
