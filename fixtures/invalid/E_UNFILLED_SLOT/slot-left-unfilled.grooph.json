{
  "grooph": 0,
  "id": "make-it-green",
  "name": "Make it green",
  "version": 1,
  "goal": "Make the failing date-parsing tests pass.",
  "target": {
    "harness": "claude-code"
  },
  "lineage": {
    "pattern": "grind-loop",
    "from": "grind-loop@1"
  },
  "description": "Instantiated from a template with one slot never filled: the check still says {{test-command}}, so the lead would not know what to run.",
  "nodes": [
    {
      "id": "builder",
      "kind": "agent",
      "name": "Builder",
      "role": "builder",
      "brief": "Make the failing tests pass by changing src/.",
      "outputs": [
        "src/ changes"
      ],
      "allow": [
        "read-files",
        "edit-files",
        "run-tests"
      ],
      "owns": [
        "src"
      ]
    },
    {
      "id": "tests",
      "kind": "check",
      "name": "Tests",
      "check": {
        "kind": "tests",
        "run": "{{test-command}}",
        "pass": "exit code 0"
      }
    },
    {
      "id": "done",
      "kind": "stop",
      "name": "Done",
      "outcome": "success"
    }
  ],
  "edges": [
    {
      "id": "e-builder-tests",
      "from": "builder",
      "to": "tests"
    },
    {
      "id": "e-tests-fail",
      "from": "tests",
      "to": "builder",
      "when": "fail",
      "evidence": [
        "test output"
      ]
    },
    {
      "id": "e-tests-pass",
      "from": "tests",
      "to": "done",
      "when": "pass"
    }
  ],
  "loops": [
    {
      "id": "grind",
      "name": "Grind",
      "members": [
        "builder",
        "tests"
      ],
      "back": [
        "e-tests-fail"
      ],
      "mode": "grind",
      "stops": [
        {
          "kind": "max-iterations",
          "n": 5
        },
        {
          "kind": "budget",
          "measure": "minutes",
          "limit": 20
        }
      ]
    }
  ]
}
