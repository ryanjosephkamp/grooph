{
  "grooph": 0,
  "id": "edge-to-unknown-node",
  "name": "Edge to an unknown node",
  "version": 1,
  "goal": "Write the release note in NOTES.md.",
  "target": {
    "harness": "claude-code"
  },
  "description": "The second edge names a node that was renamed away.",
  "nodes": [
    {
      "id": "worker",
      "kind": "agent",
      "name": "Worker",
      "role": "builder",
      "brief": "Write the release note.",
      "outputs": [
        "NOTES.md"
      ]
    },
    {
      "id": "done",
      "kind": "stop",
      "name": "Done",
      "outcome": "success"
    }
  ],
  "edges": [
    {
      "id": "e-finish",
      "from": "worker",
      "to": "done"
    },
    {
      "id": "e-handoff",
      "from": "worker",
      "to": "proofreader"
    }
  ],
  "loops": []
}
