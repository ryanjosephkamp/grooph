{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // mermaidify's files, copied as released (src/ui/sketch/mermaidify), import each other by their .ts names.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    // The web app consumes core from source; Vite resolves the same path.
    // The app starts from core without the compiler, and fetches the compiler, at an address of its own, when a
    // person exports.
    // An operation map's other views are a third address, fetched when a map is drawn.
    "paths": {
      "@grooph/core": ["../../packages/core/src/base.ts"],
      "@grooph/core/compile": ["../../packages/core/src/compile/index.ts"],
      "@grooph/core/map-views": ["../../packages/core/src/picture/map-views.ts"],
      "@grooph/core/units": ["../../packages/core/src/picture/graph-units.ts"],
      // The picture's themes are another, fetched when one that is not Paper is chosen.
      "@grooph/core/themes": ["../../packages/core/src/picture/themes.ts"],
      // Mermaid read into a graph is another: part of the import piece, fetched when a file is picked or text pasted.
      "@grooph/core/mermaid-read": ["../../packages/core/src/mermaid-read.ts"],
      // Adoption held to a graph's brakes is another, fetched when Adopt is pressed on a run's page.
      "@grooph/core/adoption": ["../../packages/core/src/adoption.ts"],
      // The one-file offline page is another, fetched when "Offline page" is pressed under Keep a copy.
      "@grooph/core/offline": ["../../packages/core/src/offline.ts"],
      // A plan's files are another: their maker is part of the Export panel's piece.
      "@grooph/core/plan": ["../../packages/core/src/plan.ts"],
      // A graph's views in three dimensions are two more: the stage's, and Rings and Columns beside it.
      "@grooph/core/stage": ["../../packages/core/src/picture/stage/stage.ts"],
      "@grooph/core/stage-more": ["../../packages/core/src/picture/stage/more.ts"],
      // And the stairs: their arithmetic for the scene's piece, and a graph's scene for the switch over the canvas.
      "@grooph/core/stairs": ["../../packages/core/src/picture/stage/stairs.ts"],
      "@grooph/core/graph-scene": ["../../packages/core/src/picture/stage/graph-scene.ts"]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
